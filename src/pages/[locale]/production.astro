---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ProductionPage from '../../components/ProductionPage.astro';
import { locales, type Locale } from '../../i18n/config';
import { getProduction } from '../../i18n/production';

export const getStaticPaths = (() => locales.filter((l) => l !== 'en').map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as { locale: Locale };
const t = getProduction(locale);
---

<Layout title={t.meta.title} description={t.meta.description} locale={locale}>
  <ProductionPage locale={locale} />
</Layout>
