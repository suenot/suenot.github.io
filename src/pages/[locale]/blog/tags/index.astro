---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../../layouts/Layout.astro';
import { locales, type Locale } from '../../../../i18n/config';
import { useTranslations } from '../../../../i18n/ui';
import { getLocalePrefix } from '../../../../i18n/utils';
import { getCollection } from 'astro:content';

export const getStaticPaths = (() => locales.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const prefix = getLocalePrefix(locale);
const backArrow = locale === 'ar' ? '\u2192' : '\u2190';
const allPosts = await getCollection('blog', ({ id, data }) => id.startsWith(`${locale}/`) && !data.draft);
const tagCounts: Record<string, number> = {};
allPosts.forEach((post) => post.data.tags.forEach((tag) => { tagCounts[tag] = (tagCounts[tag] || 0) + 1; }));
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], locale));
---

<Layout title={`${t('blog.tags')} — Eugen Soloviov`} description={t('blog.description')} locale={locale}>
  <section class="terminal-section taxonomy-shell">
    <div class="terminal-container taxonomy-container">
      <a href={`${prefix}/blog/`} class="taxonomy-back"><span aria-hidden="true">{backArrow}</span> {t('blog.backToBlog').replace(/^[←→]\s*/, '')}</a>
      <header class="taxonomy-header">
        <div><p>ARCHIVE / CHANNEL INDEX</p><h1 class="display-type">{t('blog.allTags')}</h1></div>
        <dl><div><dt>CHANNELS</dt><dd>{String(sortedTags.length).padStart(2, '0')}</dd></div><div><dt>ENTRIES</dt><dd>{String(allPosts.length).padStart(2, '0')}</dd></div></dl>
      </header>
      <nav class="taxonomy-grid" aria-label={t('blog.allTags')}>
        {sortedTags.map(([tag, count], index) => (
          <a href={`${prefix}/blog/tags/${encodeURIComponent(tag)}/`}>
            <span class="taxonomy-grid__index">{String(index + 1).padStart(2, '0')}</span>
            <span class="taxonomy-grid__name">#{tag}</span>
            <span class="taxonomy-grid__count">{String(count).padStart(2, '0')} / {t('blog.archiveCount')}</span>
            <span class="taxonomy-grid__arrow" aria-hidden="true">&#8594;</span>
          </a>
        ))}
      </nav>
    </div>
  </section>
  <style>
    .taxonomy-shell{position:relative;min-height:100dvh;padding:clamp(7rem,11vw,10rem) 0 clamp(5rem,10vw,9rem);overflow:clip;background:var(--terminal-surface)}.taxonomy-shell:before{content:'';position:absolute;inset:0;width:auto;height:auto;border:0;pointer-events:none;opacity:.2;background:repeating-linear-gradient(0deg,transparent 0 3px,rgb(var(--ink-rgb) / .025) 3px 4px)}.taxonomy-container{position:relative;width:min(100% - 2rem,86rem);margin-inline:auto}.taxonomy-back{display:inline-flex;gap:.6rem;margin-bottom:3rem;color:rgb(var(--ink-rgb) / max(.48, var(--ink-floor)));font:.67rem ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;letter-spacing:.11em;text-decoration:none;text-transform:uppercase}.taxonomy-back span{color:var(--terminal-accent)}.taxonomy-back:hover{color:var(--terminal-ink)}.taxonomy-back:focus-visible,.taxonomy-grid a:focus-visible{outline:1px solid var(--terminal-accent);outline-offset:4px}.taxonomy-header{display:grid;grid-template-columns:minmax(0,1fr) minmax(15rem,22rem);gap:3rem;align-items:end;border-block:1px solid rgb(var(--ink-rgb) / .2);padding:clamp(2rem,5vw,4.5rem) 0}.taxonomy-header p{margin:0 0 1rem;color:var(--terminal-accent);font:.65rem ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;letter-spacing:.14em}.taxonomy-header h1{margin:0;color:var(--terminal-ink);font-size:clamp(3rem,9vw,7rem);font-weight:780;letter-spacing:-.07em;line-height:.86;text-transform:uppercase}.taxonomy-header dl{margin:0;border-top:1px solid rgb(var(--ink-rgb) / .14);font:.63rem ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;letter-spacing:.1em}.taxonomy-header dl div{display:flex;justify-content:space-between;border-bottom:1px solid rgb(var(--ink-rgb) / .14);padding:.7rem 0}.taxonomy-header dt{color:rgb(var(--ink-rgb) / max(.32, var(--ink-floor)))}.taxonomy-header dd{margin:0;color:rgb(var(--ink-rgb) / max(.7, var(--ink-floor)));font-variant-numeric:tabular-nums}.taxonomy-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:clamp(3rem,6vw,5rem);border-top:1px solid rgb(var(--ink-rgb) / .16)}.taxonomy-grid a{position:relative;display:grid;grid-template-columns:2rem minmax(0,1fr) auto auto;gap:1rem;align-items:center;min-height:6rem;border-bottom:1px solid rgb(var(--ink-rgb) / .14);padding:1rem 1.2rem;color:rgb(var(--ink-rgb) / max(.55, var(--ink-floor)));text-decoration:none;transition:background-color .18s,color .18s}.taxonomy-grid a:nth-child(odd){border-inline-end:1px solid rgb(var(--ink-rgb) / .14)}.taxonomy-grid a:hover{background:rgb(var(--ink-rgb) / .035);color:var(--terminal-ink)}.taxonomy-grid__index,.taxonomy-grid__count{font: .62rem ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;letter-spacing:.08em;font-variant-numeric:tabular-nums}.taxonomy-grid__index{color:rgb(var(--accent-rgb) / max(.72, var(--accent-floor)))}.taxonomy-grid__name{overflow-wrap:anywhere;font-size:clamp(.95rem,2vw,1.25rem);font-weight:600;letter-spacing:-.02em}.taxonomy-grid__count{color:rgb(var(--ink-rgb) / max(.3, var(--ink-floor)));text-transform:uppercase}.taxonomy-grid__arrow{color:var(--terminal-accent);transition:transform .18s}.taxonomy-grid a:hover .taxonomy-grid__arrow{transform:translateX(.2rem)}@media(max-width:740px){.taxonomy-header{grid-template-columns:1fr}.taxonomy-grid{grid-template-columns:1fr}.taxonomy-grid a:nth-child(odd){border-inline-end:0}}@media(max-width:480px){.taxonomy-container{width:min(100% - 1.25rem,86rem)}.taxonomy-grid a{grid-template-columns:1.5rem minmax(0,1fr) auto}.taxonomy-grid__count{display:none}}
  </style>
</Layout>
