---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Search from '../../components/Search.astro';
import FilterDrawer from '../../components/FilterDrawer.astro';
import { defaultLocale, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getPostHeroImage } from '../../lib/blog';
import { getCollection } from 'astro:content';

const locale = defaultLocale;
const t = useTranslations(locale);

const allPosts = await getCollection('blog', ({ data, id }) => {
  return id.startsWith(`${locale}/`) && !data.draft;
});

const posts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const allTags = posts.flatMap((post) => post.data.tags);

function getSlug(id: string): string {
  return id.replace(`${locale}/`, '').replace(/\.md$/, '');
}
---

<Layout
  title={`${t('blog.title')} — Eugen Soloviov`}
  description={t('blog.description')}
  locale={locale}
>
  <div class="pt-24 pb-16">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-8">
        <div class="mb-4 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-amber-200/70">
          <span class="h-px w-8 bg-amber-200/60"></span>
          <span>{posts.length} {t('blog.archiveCount')}</span>
        </div>
        <h1 class="mb-3 text-4xl font-semibold tracking-[-0.03em] text-white sm:text-5xl">{t('blog.title')}</h1>
        <p class="max-w-2xl text-lg leading-relaxed text-gray-400">{t('blog.description')}</p>
      </header>

      <div class="mb-10 flex items-center justify-between gap-4 border-y border-white/10 py-4">
        <p class="text-sm text-gray-500">{t('blog.searchHint')}</p>
        <FilterDrawer tags={allTags} locale={locale}>
          <Search slot="search" placeholder={t('blog.search')} noResultsText={t('blog.noResults')} />
        </FilterDrawer>
      </div>

      <div id="blog-search-container" data-no-results={t('blog.noResults')}>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <div data-blog-post data-title={post.data.title} data-description={post.data.description} data-slug={getSlug(post.id)} data-tags={post.data.tags.join(',')} data-pubdate={post.data.pubDate.toISOString()}>
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
                heroImage={getPostHeroImage(getSlug(post.id), post.data.heroImage)}
                slug={`/blog/${getSlug(post.id)}/`}
                readMoreLabel={t('blog.readMore')}
              />
            </div>
          ))}
        </div>
        <p id="no-results" class="text-center text-gray-500 py-12 hidden">{t('blog.noResults')}</p>
      </div>
    </div>
  </div>
</Layout>
