---
import { localeNames, type Locale } from '../i18n/config';
import { getLocalePrefix } from '../i18n/utils';

interface Props {
  currentLocale: Locale;
  slug: string;
  availableLocales: Locale[];
  label: string;
}

const { currentLocale, slug, availableLocales, label } = Astro.props;
const otherLocales = availableLocales.filter((locale) => locale !== currentLocale);
---

{otherLocales.length > 0 && (
  <nav class="translation-links" aria-label={label}>
    <span class="translation-links__label">{label}</span>
    <span class="translation-links__line" aria-hidden="true"></span>
    {otherLocales.map((locale) => (
      <a href={`${getLocalePrefix(locale)}/blog/${slug}/`} hreflang={locale}>
        <span>{locale.toUpperCase()}</span>
        <span>{localeNames[locale]}</span>
      </a>
    ))}
  </nav>
)}

<style>
  .translation-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.8rem;
    color: rgb(var(--ink-rgb) / max(0.4, var(--ink-floor)));
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .translation-links__line {
    width: 1.5rem;
    height: 1px;
    background: rgb(var(--ink-rgb) / 0.2);
  }

  .translation-links a {
    display: inline-flex;
    gap: 0.45rem;
    border-inline-start: 1px solid rgb(var(--ink-rgb) / 0.16);
    padding-inline-start: 0.8rem;
    color: rgb(var(--ink-rgb) / max(0.56, var(--ink-floor)));
    text-decoration: none;
    transition: color 160ms ease;
  }

  .translation-links a span:first-child {
    color: var(--terminal-accent);
  }

  .translation-links a:hover {
    color: var(--terminal-ink);
  }

  .translation-links a:focus-visible {
    outline: 1px solid var(--terminal-accent);
    outline-offset: 3px;
  }
</style>
