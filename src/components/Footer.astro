---
import { resumeUrl } from '../lib/cv';
import { defaultLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale?: Locale;
  /** Contact block; the homepage hides it because its Contact section is the one contact block. */
  cta?: boolean;
}

const { locale = defaultLocale, cta = true } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const prefix = locale === defaultLocale ? '' : `/${locale}`;
const blogHref = `${prefix}/blog/`;
const rssHref = `${blogHref}feed.xml`;

const navLinks = [
  { label: t('nav.about'), href: `${prefix}/#about` },
  { label: t('nav.algotrading'), href: `${prefix}/#algotrading` },
  { label: t('nav.projects'), href: `${prefix}/#projects` },
  { label: t('nav.production'), href: `${prefix}/production/` },
  { label: t('nav.blog'), href: blogHref },
  { label: t('nav.contact'), href: `${prefix}/#contact` },
  { label: t('nav.cv'), href: resumeUrl(locale) },
];

const socialLinks = [
  { label: 'GITHUB', href: 'https://github.com/suenot' },
  { label: 'TELEGRAM', href: 'https://t.me/suenot' },
  { label: 'LINKEDIN', href: 'https://www.linkedin.com/in/suenot/' },
  { label: 'RSS', href: rssHref },
];
---

<footer class="site-footer">
  <div class="footer-shell">
    {cta && (
      <div class="footer-contact">
        <p class="terminal-label">{t('footer.status_available')}</p>
        <a class="footer-email" href="mailto:suenot@gmail.com">suenot@gmail.com<span aria-hidden="true">↗</span></a>
        <a class="footer-tg" href="https://t.me/suenot" target="_blank" rel="noopener noreferrer">Telegram @suenot ↗</a>
      </div>
    )}

    <div class="footer-stage" data-stage>
      <div class="footer-wordmark display-type" aria-label="Suenot" data-wordmark>
        {'SUENOT'.split('').map((ch) => <span class="footer-letter" aria-hidden="true">{ch}</span>)}
        <button type="button" class="bot" data-bot aria-label="Pixel bot: click to make it jump">
          <span class="bot__body">
            <svg class="bot__frame bot__frame--idle" viewBox="0 0 11 12" shape-rendering="crispEdges" aria-hidden="true"><rect x="5" y="0" width="1.02" height="1.02" fill="var(--terminal-accent)"/><rect x="5" y="1" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="1" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="2" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="3" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="4" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="5" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="6" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="7" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="8" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="9" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="1" y="3" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="2" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="3" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="4" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="5" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="6" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="7" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="8" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="9" y="3" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="1" y="4" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="2" y="4" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="3" y="4" width="1.02" height="1.02" fill="var(--sprite-glow)" class="eye"/><rect x="4" y="4" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="5" y="4" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="6" y="4" width="1.02" height="1.02" fill="var(-