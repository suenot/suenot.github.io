            <svg class="bot__frame bot__frame--jump" viewBox="0 0 11 12" shape-rendering="crispEdges" aria-hidden="true"><rect x="5" y="0" width="1.02" height="1.02" fill="var(--terminal-accent)"/><rect x="5" y="1" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="1" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="2" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="3" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="4" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="5" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="6" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="7" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="8" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="9" y="2" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="1" y="3" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="2" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="3" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="4" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="5" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="6" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="7" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="8" y="3" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="9" y="3" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="1" y="4" width="1.02" height="1.02" fill="var(--sprite-ink)"/><rect x="2" y="4" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="3" y="4" width="1.02" height="1.02" fill="var(--sprite-glow)" class="eye"/><rect x="4" y="4" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="5" y="4" width="1.02" height="1.02" fill="var(--sprite-screen)"/><rect x="6" y="4" width="1.02" height="1.02" fill="var(-