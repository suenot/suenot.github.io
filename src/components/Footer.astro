---
import { defaultLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const prefix = locale === defaultLocale ? '' : `/${locale}`;
const blogHref = `${prefix}/blog/`;
const rssHref = `${blogHref}feed.xml`;

const navLinks = [
  { label: t('nav.about'), href: `${prefix}/#about` },
  { label: t('nav.algotrading'), href: `${prefix}/#algotrading` },
  { label: t('nav.projects'), href: `${prefix}/#projects` },
  { label: t('nav.blog'), href: blogHref },
  { label: t('nav.contact'), href: `${prefix}/#contact` },
];

const socialLinks = [
  { label: 'GITHUB', href: 'https://github.com/suenot' },
  { label: 'TELEGRAM', href: 'https://t.me/suenot' },
  { label: 'LINKEDIN', href: 'https://www.linkedin.com/in/suenot/' },
  { label: 'RSS', href: rssHref },
];
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-primary">
      <div>
        <div class="terminal-label">{t('footer.status_available')}</div>
        <div class="footer-wordmark display-type" aria-hidden="true">SUENOT</div>
      </div>
      <div class="footer-command">
        <span class="terminal-label">[ DIRECT CHANNEL ]</span>
        <a class="terminal-button terminal-button--primary" href="mailto:suenot@gmail.com">
          SUENOT@GMAIL.COM <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="footer-index">
      <nav aria-label={t('footer.col_sitemap')}>
        <span class="terminal-label">NAV / INDEX</span>
        <ul role="list">
          {navLinks.map((link, index) => (
            <li><a href={link.href}>{String(index + 1).padStart(2, '0')} {link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <span class="terminal-label">EXTERNAL / LINKS</span>
        <ul role="list">
          {socialLinks.map((link) => (
            <li><a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.label} ↗</a></li>
          ))}
        </ul>
      </div>

    </div>

    <div class="footer-strip">
      <span>© {year} EUGEN SOLOVIOV</span>
      <span>{t('footer.tagline')}</span>
      <button type="button" id="footer-top">{t('footer.scroll_top')} ↑</button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--terminal-line);
    background: #070908;
  }

  .footer-shell {
    width: min(100%, var(--terminal-max));
    margin-inline: auto;
  }

  .footer-primary {
    display: grid;
    min-height: 26rem;
    padding: clamp(2rem, 5vw, 5rem) clamp(1rem, 3vw, 3rem) 0;
    grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr);
    gap: 2rem;
  }

  .footer-wordmark {
    margin-block-start: clamp(3rem, 9vw, 8rem);
    color: var(--terminal-ink);
    font-size: clamp(5.5rem, 17vw, 18rem);
    white-space: nowrap;
  }

  .footer-command {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 1rem;
    padding-block-end: clamp(2.25rem, 5vw, 5rem);
  }

  .footer-index {
    display: grid;
    gap: 1px;
    border-block-start: 1px solid var(--terminal-line);
    border-block-end: 1px solid var(--terminal-line);
    background: var(--terminal-line);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .footer-index > * {
    min-width: 0;
    padding: 1.5rem clamp(1rem, 3vw, 3rem);
    background: var(--terminal-bg);
  }

  .footer-index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.15rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .footer-index a,
  .footer-strip button {
    border: 0;
    background: transparent;
    color: var(--terminal-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .footer-index a:hover,
  .footer-strip button:hover {
    color: var(--terminal-accent);
  }

  .footer-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1rem, 3vw, 3rem);
    color: var(--terminal-dim);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 56rem) {
    .footer-primary {
      min-height: 22rem;
      grid-template-columns: 1fr;
    }

    .footer-wordmark {
      white-space: normal;
    }

    .footer-command {
      justify-content: start;
      padding-block-end: 2rem;
    }

    .footer-index {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    .footer-primary {
      min-height: 19rem;
    }

    .footer-wordmark {
      font-size: clamp(4.5rem, 25vw, 8rem);
    }

    .footer-strip {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<script>
  document.getElementById('footer-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
