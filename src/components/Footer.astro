---
import { getCollection } from 'astro:content';
import { resumeUrl } from '../lib/cv';
import { defaultLocale, locales, localeNames, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { localeUrl } from '../i18n/utils';
import { featured, iconOf, monogram, hueOf } from '../data/projects';

interface Props {
  locale?: Locale;
  /** Contact block; the homepage hides it because its Contact section is the one contact block. */
  cta?: boolean;
  /** Locales this page exists in, for the language column. */
  availableLocales?: readonly Locale[];
}

const { locale = defaultLocale, cta = true, availableLocales = locales } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const prefix = locale === defaultLocale ? '' : `/${locale}`;
const blogHref = `${prefix}/blog/`;
const rssHref = `${blogHref}feed.xml`;

const navLinks = [
  { label: t('nav.about'), href: `${prefix}/#about` },
  { label: t('nav.algotrading'), href: `${prefix}/algotrading/` },
  { label: t('nav.projects'), href: `${prefix}/projects/` },
  { label: t('nav.production'), href: `${prefix}/production/` },
  { label: t('nav.blog'), href: blogHref },
  { label: t('nav.contact'), href: `${prefix}/#contact` },
  { label: t('nav.cv'), href: resumeUrl(locale) },
];

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/suenot' },
  { label: 'Telegram', href: 'https://t.me/suenot' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/suenot/' },
  { label: 'suenot@gmail.com', href: 'mailto:suenot@gmail.com' },
  { label: 'RSS', href: rssHref },
];

const dateFormat = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric' });
const posts = (await getCollection('blog', ({ data, id }) => id.startsWith(`${locale}/`) && !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    date: post.data.pubDate,
    href: `${blogHref}${post.id.slice(locale.length + 1).replace(/\.mdx?$/, '')}/`,
  }));

const languages = locales
  .filter((code) => availableLocales.includes(code))
  .map((code) => ({ code, name: localeNames[code], href: localeUrl(Astro.url.pathname, code) }));

const external = (href: string) => href.startsWith('http')
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<footer class="site-footer">
  <div class="footer-shell">
    {cta && (
      <div class="footer-contact">
        <p class="terminal-label">{t('footer.status_available')}</p>
        <a class="footer-email" href="mailto:suenot@gmail.com">suenot@gmail.com<span aria-hidden="true">↗</span></a>
        <a class="footer-tg" href="https://t.me/suenot" target="_blank" rel="noopener noreferrer">Telegram @suenot ↗</a>
      </div>
    )}

    <div class="footer-index">
      <nav class="footer-col footer-col--site" aria-labelledby="footer-col-site">
        <h2 id="footer-col-site" class="footer-col__label terminal-label">{t('footer.col_sitemap')}</h2>
        <ul role="list">
          {navLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-col footer-col--work">
        <h2 class="footer-col__label terminal-label">{t('footer.col_products')}</h2>
        <ul role="list">
          {featured.map((project) => {
            const icon = iconOf(project);
            return (
              <li>
                <a class="footer-product" href={project.url} {...external(project.url)}>
                  {icon
                    ? <img src={icon} alt="" width="20" height="20" loading="lazy" decoding="async" />
                    : <span class="footer-product__mono" style={`--hue:${hueOf(project.name)}`} aria-hidden="true">{monogram(project.name)}</span>}
                  <span>{project.name}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <div class="footer-col footer-col--writing">
        <h2 class="footer-col__label terminal-label">{t('footer.work_articles')}</h2>
        <ul role="list">
          {posts.map((post) => (
            <li>
              <a class="footer-post" href={post.href}>
                <span class="footer-post__title">{post.title}</span>
                <time datetime={post.date.toISOString()}>{dateFormat.format(post.date)}</time>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col footer-col--connect">
        <h2 class="footer-col__label terminal-label">{t('footer.col_connect')}</h2>
        <ul role="list">
          {socialLinks.map((link) => <li><a href={link.href} {...external(link.href)}>{link.label}</a></li>)}
        </ul>
      </div>

      {languages.length > 1 && (
        <nav class="footer-col footer-col--lang" aria-labelledby="footer-col-lang">
          <h2 id="footer-col-lang" class="footer-col__label terminal-label">{t('footer.col_language')}</h2>
          <ul role="list">
            {languages.map((lang) => (
              <li>
                <a href={lang.href} lang={lang.code} hreflang={lang.code} aria-current={lang.code === locale ? 'page' : undefined}>{lang.name}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <div class="footer-stage">
      <div class="footer-wordmark display-type" aria-label="Suenot" data-wordmark>
        {'SUENOT'.split('').map((ch) => <span class="footer-letter" data-letter aria-hidden="true">{ch}</span>)}
      </div>
    </div>

    <div class="footer-strip">
      <span>© {year} Eugen Soloviov</span>
      <span>{t('footer.tagline')}</span>
      <button type="button" id="footer-top">{t('footer.scroll_top')} ↑</button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --clawd: #d97757;
    --clawd-eye: #141413;
    border-block-start: 1px solid var(--terminal-line);
    background: var(--terminal-footer);
    overflow: hidden;
  }

  .footer-shell {
    width: min(100%, var(--terminal-max));
    margin-inline: auto;
  }

  .footer-contact {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(3.5rem, 8vw, 7rem) clamp(1.25rem, 4vw, 3rem) 0;
  }

  .footer-email {
    display: inline-flex;
    align-items: baseline;
    gap: .15em;
    color: var(--terminal-ink);
    font-size: clamp(2.25rem, 7.4vw, 7rem);
    font-weight: 800;
    letter-spacing: -.055em;
    line-height: .95;
    text-decoration: none;
    background: linear-gradient(var(--terminal-accent), var(--terminal-accent)) no-repeat 0 100% / 0 .06em;
    transition: background-size 420ms var(--ease-out, ease), color 200ms;
  }

  .footer-email span { color: var(--terminal-accent); font-size: .55em; transition: transform 300ms var(--ease-out, ease); }
  .footer-email:hover { background-size: 100% .06em; }
  .footer-email:hover span { transform: translate(.08em, -.08em); }
  .footer-email:focus-visible, .footer-tg:focus-visible { outline: 2px solid var(--terminal-accent); outline-offset: 4px; }

  .footer-tg {
    color: var(--terminal-ink-2);
    font: 500 .875rem/1 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .footer-tg:hover { color: var(--terminal-accent); }

  .footer-index {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1px;
    border-block-end: 1px solid var(--terminal-line);
    background: var(--terminal-line);
  }

  .footer-contact + .footer-index {
    margin-block-start: clamp(3.5rem, 7vw, 6rem);
    border-block-start: 1px solid var(--terminal-line);
  }

  .footer-col {
    grid-column: span 2;
    min-width: 0;
    padding: 1.75rem clamp(1.25rem, 2.2vw, 2rem) 2.25rem;
    background: var(--terminal-footer);
  }

  .footer-col--work,
  .footer-col--writing { grid-column: span 3; }

  .footer-col__label { margin: 0; font-weight: 500; }

  .footer-col ul {
    display: grid;
    gap: .7rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .footer-col a {
    color: var(--terminal-ink-2);
    font-size: .95rem;
    line-height: 1.35;
    text-decoration: none;
    transition: color 160ms;
  }

  .footer-col a:hover { color: var(--terminal-accent); }
  .footer-col a:focus-visible,
  .footer-strip button:focus-visible { outline: 2px solid var(--terminal-accent); outline-offset: 3px; }

  .footer-col--lang a[aria-current] {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    color: var(--terminal-ink);
  }

  /* One pixel of Clawd marks the current language. */
  .footer-col--lang a[aria-current]::before {
    content: '';
    inline-size: .4rem;
    block-size: .4rem;
    background: var(--terminal-accent);
  }

  .footer-product {
    display: flex;
    inline-size: fit-content;
    align-items: center;
    gap: .65rem;
  }

  .footer-product img,
  .footer-product__mono {
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border-radius: .3rem;
  }

  .footer-product__mono {
    display: grid;
    place-items: center;
    background: hsl(var(--hue) 45% 45%);
    color: #fff;
    font: 700 .55rem/1 var(--font-mono);
  }

  .footer-post {
    display: grid;
    gap: .3rem;
  }

  .footer-post__title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    text-wrap: pretty;
  }

  .footer-post time {
    color: var(--terminal-muted);
    font: 500 .7rem/1.2 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .footer-stage {
    container-type: inline-size;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3rem) 2.2cqi;
  }

  .footer-wordmark {
    position: relative;
    display: flex;
    justify-content: space-between;
    color: var(--terminal-ink);
    font-size: 24.6cqi;
    letter-spacing: -.04em;
    line-height: .74;
    user-select: none;
  }

  .footer-letter {
    display: inline-block;
    transform-origin: 50% 100%;
    transition: color 320ms;
  }

  .footer-letter.is-hit { animation: letter-hit 420ms var(--ease-out, ease); }
  /* Clawd paints the letters orange one by one, then back to ink, round and round. */
  .footer-letter[data-painted] { color: var(--terminal-accent); }

  @keyframes letter-hit {
    0% { transform: translateY(0) scaleY(1); }
    30% { transform: translateY(.045em) scaleY(.94); }
    100% { transform: translateY(0) scaleY(1); }
  }

  .footer-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1.25rem, 4vw, 3rem);
    color: var(--terminal-dim);
    font-size: .75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase; font-family: var(--font-mono);
  }

  .footer-strip button {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--terminal-muted);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .footer-strip button:hover { color: var(--terminal-accent); }

  @media (max-width: 64rem) {
    .footer-col { grid-column: span 4; }
    .footer-col--work,
    .footer-col--writing { grid-column: span 6; order: -1; }
  }

  @media (max-width: 38rem) {
    .footer-col { grid-column: span 6; }
    .footer-col--work,
    .footer-col--writing,
    .footer-col--lang { grid-column: span 12; }
    .footer-col--lang ul { display: flex; flex-wrap: wrap; gap: .7rem 1.25rem; }
    .footer-strip { align-items: flex-start; flex-direction: column; }
  }
</style>

<script>
  document.getElementById('footer-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
