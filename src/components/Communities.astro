---
import { defaultLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const t = getHome(locale).communities;

interface Community {
  key: keyof typeof t.items;
  url: string;
  handle: string;
  platform: string;
}

const communities: Community[] = [
  {
    key: 'suenot_dev',
    url: 'https://t.me/suenot_dev',
    handle: '@suenot_dev',
    platform: 'Telegram',
  },
  {
    key: 'klavaorg',
    url: 'https://t.me/klavaorg',
    handle: '@klavaorg',
    platform: 'Telegram',
  },
  {
    key: 'klavaorgwork',
    url: 'https://t.me/klavaorgwork',
    handle: '@klavaorgwork',
    platform: 'Telegram',
  },
];
---

<section id="communities" class="communities terminal-section" aria-labelledby="communities-heading">
  <div class="terminal-container communities__layout">
    <header class="communities__header">
      <p class="terminal-kicker">{t.eyebrow} / PUBLIC CHANNELS</p>
      <h2 id="communities-heading" class="terminal-heading">{t.heading}</h2>
      <p aria-hidden="true">BROADCAST DIRECTORY<br />3 ACTIVE STREAMS</p>
    </header>

    <div class="communities__list">
      {communities.map((community, index) => (
        <a href={community.url} target="_blank" rel="noopener noreferrer">
          <span class="community__index">0{index + 1}</span>
          <div class="community__identity">
            <span>{community.platform} / {community.handle}</span>
            <h3>{t.items[community.key].name}</h3>
          </div>
          <p>{t.items[community.key].desc}</p>
          <span class="community__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .communities { border-block-end: 1px solid var(--terminal-line, #303431); }
  .communities__layout { display: grid; grid-template-columns: minmax(17rem, .58fr) minmax(0, 1.42fr); }
  .communities__header { padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 3.5vw, 3.75rem); border-inline-end: 1px solid var(--terminal-line, #303431); }
  .communities__header .terminal-heading { max-inline-size: 10ch; margin-block-start: 1.25rem; font-size: clamp(3.1rem, 5.2vw, 6rem); line-height: .85; }
  .communities__header > p:last-child { margin-block-start: 5rem; color: var(--terminal-muted, #747a75); font: .57rem/1.7 var(--font-mono, monospace); letter-spacing: .1em; }
  .communities__list a { display: grid; grid-template-columns: 2.5rem minmax(12rem, .8fr) 1.2fr auto; gap: 1.25rem; align-items: center; min-block-size: 9.5rem; padding: 1.5rem clamp(1rem, 3.5vw, 3.75rem); border-block-end: 1px solid var(--terminal-line, #303431); color: inherit; text-decoration: none; }
  .communities__list a:last-child { border-block-end: 0; }
  .community__index { color: #ff3b30; font: .6rem/1 var(--font-mono, monospace); }
  .community__identity > span { color: var(--terminal-muted, #747a75); font: .54rem/1 var(--font-mono, monospace); letter-spacing: .08em; text-transform: uppercase; }
  .community__identity h3 { margin-block-start: .6rem; color: var(--terminal-fg, #e7e9e3); font-size: clamp(1.25rem, 2.2vw, 2.25rem); font-weight: 700; letter-spacing: -.035em; line-height: 1; }
  .communities__list a > p { max-inline-size: 55ch; color: var(--terminal-muted, #8b908c); font-size: .75rem; line-height: 1.55; }
  .community__arrow { color: #ff3b30; font: 1.25rem/1 var(--font-mono, monospace); }
  .communities__list a:hover, .communities__list a:focus-visible { background: #151816; }
  .communities__list a:focus-visible { outline: 2px solid #ff3b30; outline-offset: -3px; }
  @media (max-width: 800px) {
    .communities__layout { grid-template-columns: 1fr; }
    .communities__header { border-inline-end: 0; border-block-end: 1px solid var(--terminal-line, #303431); }
  }
  @media (max-width: 600px) {
    .communities__list a { grid-template-columns: 2rem 1fr auto; }
    .communities__list a > p { grid-column: 2 / -1; }
  }
</style>
