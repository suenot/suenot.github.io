---
import { locales, localeNames, defaultLocale, type Locale } from '../i18n/config';

interface Props {
  currentLocale: Locale;
  availableLocales?: readonly Locale[];
}

const { currentLocale, availableLocales = locales } = Astro.props;
const selectableLocales = locales.filter((locale) => availableLocales.includes(locale));

function getLocaleUrl(targetLocale: Locale): string {
  const pathname = Astro.url.pathname;
  const localePrefix = new RegExp(`^/(?:${locales.join('|')})(?=/|$)`);
  const barePath = pathname.replace(localePrefix, '') || '/';
  return targetLocale === defaultLocale ? barePath : `/${targetLocale}${barePath}`;
}
---

{selectableLocales.length > 1 ? (
<div class="language-selector" id="lang-selector">
  <button
    id="lang-toggle"
    class="language-toggle"
    type="button"
    aria-label="Select language"
    aria-expanded="false"
    aria-controls="lang-menu"
  >
    <span>{currentLocale.toUpperCase()}</span>
    <span aria-hidden="true">▾</span>
  </button>
  <div id="lang-menu" class="language-menu" hidden>
    <div class="language-menu-label">LOCALE / SELECT</div>
    {selectableLocales.map((loc) => (
      <a href={getLocaleUrl(loc)} aria-current={loc === currentLocale ? 'true' : undefined}>
        <span>{String(locales.indexOf(loc) + 1).padStart(2, '0')}</span>
        <span>{localeNames[loc]}</span>
        <span>{loc.toUpperCase()}</span>
      </a>
    ))}
  </div>
</div>
) : (
  <span class="language-static" aria-label={localeNames[currentLocale]}>{currentLocale.toUpperCase()}</span>
)}

<style>
  .language-selector {
    position: relative;
  }

  .language-static {
    color: var(--terminal-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
  }

  .language-toggle {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.45rem;
    padding-inline: 0.5rem;
    border: 0;
    background: transparent;
    color: var(--terminal-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
  }

  .language-toggle:hover {
    color: var(--terminal-ink);
  }

  .language-menu {
    position: absolute;
    z-index: 70;
    inset-block-start: calc(100% + 1rem);
    inset-inline-end: 0;
    width: min(19rem, calc(100vw - 2rem));
    border: 1px solid var(--terminal-line-strong);
    background: var(--terminal-bg);
  }

  .language-menu-label {
    padding: 0.65rem 0.75rem;
    border-block-end: 1px solid var(--terminal-line);
    color: var(--terminal-dim);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
  }

  .language-menu a {
    display: grid;
    align-items: center;
    padding: 0.7rem 0.75rem;
    border-block-end: 1px solid var(--terminal-line);
    grid-template-columns: 2rem 1fr auto;
    color: var(--terminal-muted);
    font-size: 0.6875rem;
    text-decoration: none;
  }

  .language-menu a:last-child {
    border-block-end: 0;
  }

  .language-menu a:hover,
  .language-menu a[aria-current='true'] {
    background: var(--terminal-panel-strong);
    color: var(--terminal-ink);
  }

  .language-menu a[aria-current='true'] span:first-child {
    color: var(--terminal-accent);
  }

  @media (max-width: 38rem) {
    .language-menu {
      position: fixed;
      inset-block-start: calc(var(--terminal-header) + 0.5rem);
      inset-inline: 1rem;
      width: auto;
    }
  }
</style>

<script>
  const toggle = document.getElementById('lang-toggle');
  const menu = document.getElementById('lang-menu');

  const close = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('hidden', '');
  };

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    if (expanded) menu?.setAttribute('hidden', '');
    else menu?.removeAttribute('hidden');
  });

  document.addEventListener('click', (event) => {
    const selector = document.getElementById('lang-selector');
    if (selector && !selector.contains(event.target as Node)) close();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      close();
      toggle.focus();
    }
  });
</script>
