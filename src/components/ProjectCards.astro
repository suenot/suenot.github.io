---
/**
 * A grid of project cards. Used for the home page selection and for the
 * marketmaker.cc ecosystem on /algotrading; the full list is Projects.astro.
 */
import { defaultLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';
import { useTranslations } from '../i18n/ui';
import { formatYears } from '../i18n/utils';
import { roleOf, iconOf, hueOf, monogram, hostOf, type Project } from '../data/projects';

interface Props {
  locale?: Locale;
  items: Project[];
  /** Column span out of 12 on wide screens, by project name; the rest take 4. */
  spans?: Record<string, 6 | 8 | 12>;
  level?: 'h2' | 'h3';
}
const { locale = defaultLocale, items, spans = {}, level = 'h3' } = Astro.props;
const t = getHome(locale).projects;
const ui = useTranslations(locale);
const Name = level;
---

<ul class="pcards" role="list">
  {items.map((project) => {
    const Card = project.url ? 'a' : 'div';
    const span = spans[project.name] ?? 4;
    const icon = iconOf(project);
    const host = hostOf(project);
    return (
      <li class:list={['pcard', span > 4 && 'pcard--wide', span > 6 && 'pcard--lead']} style={`--span:${span}`} data-reveal>
        <Card class="pcard__body" {...(project.url ? { href: project.url, target: '_blank', rel: 'noopener noreferrer' } : {})}>
          <div class="pcard__top">
            {icon
              ? <img class="pcard__avatar" src={icon} alt="" width="56" height="56" loading="lazy" decoding="async" />
              : <span class="pcard__avatar pcard__avatar--mono" style={`--hue:${hueOf(project.name)}`} aria-hidden="true">{monogram(project.name)}</span>}
            {project.url && <span class="pcard__arrow" aria-hidden="true">↗</span>}
          </div>
          <Name class="pcard__name">{project.name}</Name>
          <p class="pcard__meta">
            {(project.title || roleOf(project) !== 'founder') && <span class="pcard__role">{project.title ?? t.roles[roleOf(project)]}</span>}
            <span class:list={['pcard__status', `pcard__status--${project.status}`]}>{t.status[project.status]}</span>
            {project.years && <bdi class="pcard__years">{formatYears(project.years, ui('projects.present'))}</bdi>}
          </p>
          <p class="pcard__desc">{t.descs[project.descKey]}</p>
          <div class="pcard__foot">
            {host && <span class="pcard__host" dir="ltr">{host}</span>}
            <span class="pcard__tags">{project.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}</span>
          </div>
        </Card>
      </li>
    );
  })}
</ul>

<style>
  .pcards { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--terminal-line); border: 1px solid var(--terminal-line); }
  .pcard { grid-column: span var(--span, 4); display: flex; min-width: 0; background: var(--terminal-bg); }
  .pcard__body { display: flex; flex-direction: column; inline-size: 100%; min-block-size: 100%; padding: clamp(1.25rem, 2.2vw, 2rem); color: inherit; text-decoration: none; transition: background-color 160ms ease; }
  .pcard__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .pcard__avatar { flex: none; inline-size: 3.25rem; block-size: 3.25rem; border-radius: .8rem; object-fit: contain; background: var(--terminal-panel); box-shadow: inset 0 0 0 1px var(--terminal-line); }
  img.pcard__avatar { padding: .4rem; }
  .pcard__avatar--mono { display: grid; place-items: center; background: oklch(.56 .11 var(--hue)); color: #fff; font: 800 1.125rem/1 var(--font-sans); letter-spacing: -.02em; box-shadow: none; }
  .pcard__arrow { color: var(--terminal-accent); font: 1.375rem/1 var(--font-sans); opacity: .35; transition: opacity 160ms ease, transform 220ms var(--ease-out); }
  .pcard__name { margin: clamp(1.5rem, 3vw, 2.5rem) 0 0; color: var(--terminal-ink); font: 800 clamp(1.5rem, 2.4vw, 2.125rem)/1.05 var(--font-sans); letter-spacing: -.035em; overflow-wrap: anywhere; }
  .pcard--wide .pcard__name { font-size: clamp(2rem, 4vw, 3.5rem); line-height: .95; letter-spacing: -.045em; }
  .pcard--wide .pcard__avatar { inline-size: 4rem; block-size: 4rem; border-radius: 1rem; }
  .pcard__meta { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem 1rem; margin: .85rem 0 0; color: var(--terminal-muted); font: .75rem/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .pcard__role { color: var(--terminal-accent); }
  .pcard__status { display: inline-flex; align-items: center; gap: .45rem; }
  .pcard__status::before { content: ""; inline-size: .4rem; block-size: .4rem; border-radius: 50%; border: 1px solid currentColor; }
  .pcard__status--active { color: var(--terminal-ink); }
  .pcard__status--active::before { border: 0; background: var(--terminal-signal); }
  .pcard__status--wip { color: var(--terminal-accent); }
  .pcard__years { font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  .pcard__desc { flex: 1; max-inline-size: 52ch; margin: 1rem 0 0; color: var(--terminal-ink-2); font-size: var(--text-base); line-height: 1.55; text-wrap: pretty; }
  .pcard--wide .pcard__desc { font-size: clamp(1.0625rem, 1.3vw, 1.1875rem); }
  .pcard__foot { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem 1.25rem; margin-block-start: clamp(1.25rem, 2.5vw, 2rem); padding-block-start: 1rem; border-block-start: 1px solid var(--terminal-line); font: .75rem/1.4 var(--font-mono); letter-spacing: .02em; }
  .pcard__host { color: var(--terminal-ink); }
  .pcard__tags { display: flex; flex-wrap: wrap; gap: .25rem .8rem; color: var(--terminal-muted); }
  a.pcard__body:hover, a.pcard__body:focus-visible { background: var(--terminal-panel); }
  a.pcard__body:hover .pcard__arrow, a.pcard__body:focus-visible .pcard__arrow { opacity: 1; }
  a.pcard__body:focus-visible { outline: 2px solid var(--terminal-accent); outline-offset: -2px; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    a.pcard__body:hover .pcard__arrow { transform: translate3d(.2rem, -.2rem, 0); }
    :global([dir='rtl']) a.pcard__body:hover .pcard__arrow { transform: translate3d(-.2rem, -.2rem, 0); }
  }
  @media (max-width: 1050px) {
    .pcard { grid-column: span 6; }
    .pcard--lead { grid-column: span 12; }
  }
  @media (max-width: 680px) {
    .pcard, .pcard--wide { grid-column: span 12; }
  }
</style>
