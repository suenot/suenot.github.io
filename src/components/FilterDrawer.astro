---
import TagList from './TagList.astro';
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  tags: string[];
  locale: Locale;
  activeTag?: string;
  activeCount?: number;
}

const { tags, locale, activeTag, activeCount = 0 } = Astro.props;
const t = useTranslations(locale);
const drawerId = `filters-drawer-${locale}`;
---

<div class="filter-drawer" data-filter-drawer data-open="false">
  <button
    type="button"
    class="filter-drawer__toggle"
    data-filter-toggle
    aria-controls={drawerId}
    aria-expanded="false"
  >
    <span class="filter-drawer__toggle-icon" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <span>{t('blog.filters')}</span>
    {activeCount > 0 && <span class="filter-drawer__count">{String(activeCount).padStart(2, '0')}</span>}
  </button>

  <div class="filter-drawer__overlay" data-filter-overlay aria-hidden="true"></div>

  <aside
    id={drawerId}
    class="filter-drawer__panel"
    data-filter-panel
    aria-hidden="true"
    aria-label={t('blog.filters')}
    tabindex="-1"
    inert
  >
    <header class="filter-drawer__header">
      <div>
        <p class="filter-drawer__eyebrow">SYS/FILTER MATRIX</p>
        <h2>{t('blog.filters')}</h2>
      </div>
      <button
        type="button"
        data-filter-close
        class="filter-drawer__close"
        aria-label={t('blog.closeFilters')}
      >
        <span aria-hidden="true">[X]</span>
      </button>
    </header>

    <div class="filter-drawer__content">
      <slot name="search" />
      <div class="filter-drawer__label">
        <p>{t('blog.tags')}</p>
        <span>{String(new Set(tags).size).padStart(2, '0')} CHANNELS</span>
      </div>
      <TagList tags={tags} locale={locale} activeTag={activeTag} allLabel={t('blog.allPosts')} />
    </div>

  </aside>
</div>

<style>
  .filter-drawer {
    position: relative;
    z-index: 60;
    height: 3rem;
  }

  .filter-drawer__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    border: 1px solid rgba(231, 233, 227, 0.2);
    border-radius: 0;
    background: transparent;
    padding: 0 0.9rem;
    color: #e7e9e3;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .filter-drawer__toggle:hover {
    border-color: rgba(255, 59, 48, 0.72);
    background: rgba(231, 233, 227, 0.04);
  }

  .filter-drawer__toggle:active {
    transform: translateY(1px);
  }

  .filter-drawer__toggle:focus-visible,
  .filter-drawer__close:focus-visible {
    outline: 1px solid #ff3b30;
    outline-offset: 3px;
  }

  .filter-drawer__toggle-icon {
    display: grid;
    width: 1rem;
    gap: 3px;
  }

  .filter-drawer__toggle-icon i {
    display: block;
    height: 1px;
    background: currentColor;
  }

  .filter-drawer__toggle-icon i:nth-child(2) {
    width: 65%;
  }

  .filter-drawer__toggle-icon i:nth-child(3) {
    width: 35%;
  }

  .filter-drawer__count {
    display: inline-grid;
    min-width: 1.55rem;
    min-height: 1.55rem;
    place-items: center;
    border-inline-start: 1px solid rgba(231, 233, 227, 0.2);
    margin-inline-end: -0.9rem;
    padding-inline: 0.35rem;
    color: #ff3b30;
    font-variant-numeric: tabular-nums;
  }

  .filter-drawer__overlay {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: rgba(3, 4, 3, 0.78);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .filter-drawer__panel {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: 1;
    display: flex;
    width: min(100%, 27rem);
    height: 100dvh;
    flex-direction: column;
    border-inline-start: 1px solid rgba(231, 233, 227, 0.22);
    outline: 0;
    background: #0b0d0c;
    transform: translateX(100%);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html[dir='rtl']) .filter-drawer__panel {
    transform: translateX(-100%);
  }

  .filter-drawer[data-open='true'] .filter-drawer__overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .filter-drawer[data-open='true'] .filter-drawer__panel {
    transform: translateX(0);
  }

  .filter-drawer__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid rgba(231, 233, 227, 0.16);
    padding: 1.35rem 1.5rem;
  }

  .filter-drawer__eyebrow,
  .filter-drawer__label {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .filter-drawer__eyebrow {
    margin: 0 0 0.4rem;
    color: rgba(255, 59, 48, 0.75);
  }

  .filter-drawer__header h2 {
    margin: 0;
    color: #e7e9e3;
    font-size: 1.45rem;
    font-weight: 650;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .filter-drawer__close {
    border: 0;
    background: transparent;
    padding: 0.35rem;
    color: rgba(231, 233, 227, 0.55);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
    cursor: pointer;
  }

  .filter-drawer__close:hover {
    color: #ff3b30;
  }

  .filter-drawer__content {
    min-height: 0;
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .filter-drawer__content :global(.terminal-search) {
    margin-bottom: 1.5rem;
  }

  .filter-drawer__label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.7rem;
    color: rgba(231, 233, 227, 0.43);
  }

  .filter-drawer__label p {
    margin: 0;
    color: #e7e9e3;
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-drawer__overlay,
    .filter-drawer__panel {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-filter-drawer]');
    if (!root) return;

    const toggle = root.querySelector('[data-filter-toggle]');
    const close = root.querySelector('[data-filter-close]');
    const overlay = root.querySelector('[data-filter-overlay]');
    const panel = root.querySelector('[data-filter-panel]');
    if (!(toggle instanceof HTMLElement) || !(close instanceof HTMLElement) ||
      !(overlay instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;

    let lastFocused = null;

    const focusableElements = () => Array.from(panel.querySelectorAll(
      'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
    )).filter((element) => element instanceof HTMLElement && !element.hidden);

    const setOpen = (open) => {
      root.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
      panel.toggleAttribute('inert', !open);
      overlay.setAttribute('aria-hidden', String(!open));
      document.documentElement.classList.toggle('overflow-hidden', open);

      if (open) {
        lastFocused = document.activeElement;
        close.focus();
      } else if (lastFocused instanceof HTMLElement) {
        lastFocused.focus();
      }
    };

    toggle.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));
    overlay.addEventListener('click', () => setOpen(false));

    document.addEventListener('keydown', (event) => {
      if (root.dataset.open !== 'true') return;

      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
        return;
      }

      if (event.key !== 'Tab') return;
      const focusable = focusableElements();
      if (focusable.length === 0) {
        event.preventDefault();
        panel.focus();
        return;
      }

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  })();
</script>
