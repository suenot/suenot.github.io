---
import TagList from './TagList.astro';
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  tags: string[];
  locale: Locale;
  activeTag?: string;
  activeCount?: number;
}

const { tags, locale, activeTag, activeCount = 0 } = Astro.props;
const t = useTranslations(locale);
const drawerId = `filters-drawer-${locale}`;
---

<div class="filter-drawer" data-filter-drawer data-open="false">
  <button
    type="button"
    class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.03] px-3.5 py-2.5 text-sm font-medium text-gray-200 transition-all duration-200 hover:border-amber-300/35 hover:bg-white/[0.06] hover:text-white active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300/50"
    data-filter-toggle
    aria-controls={drawerId}
    aria-expanded="false"
  >
    <svg aria-hidden="true" class="h-4 w-4 text-amber-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M7 12h10M10 18h4" />
    </svg>
    <span>{t('blog.filters')}</span>
    {activeCount > 0 && (
      <span class="inline-flex min-w-5 items-center justify-center rounded-full bg-amber-200 px-1.5 py-0.5 text-[11px] font-semibold text-[#17130b]">
        {activeCount}
      </span>
    )}
  </button>

  <div class="filter-drawer__overlay" data-filter-overlay aria-hidden="true"></div>

  <aside
    id={drawerId}
    class="filter-drawer__panel"
    data-filter-panel
    aria-hidden="true"
    aria-label={t('blog.filters')}
  >
    <div class="flex items-start justify-between gap-6 border-b border-white/10 px-6 py-5">
      <div>
        <p class="mb-1 font-mono text-[10px] uppercase tracking-[0.18em] text-amber-200/70">{t('blog.filterLabel')}</p>
        <h2 class="text-xl font-semibold tracking-tight text-white">{t('blog.filters')}</h2>
      </div>
      <button
        type="button"
        data-filter-close
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-white/10 text-gray-400 transition-colors hover:border-white/20 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300/50"
        aria-label={t('blog.closeFilters')}
      >
        <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <div class="flex min-h-0 flex-1 flex-col overflow-y-auto px-6 py-6">
      <slot name="search" />
      <div class="mb-3 flex items-center justify-between gap-4">
        <p class="text-sm font-medium text-gray-200">{t('blog.tags')}</p>
        <span class="font-mono text-[11px] text-gray-500">{new Set(tags).size}</span>
      </div>
      <TagList tags={tags} locale={locale} activeTag={activeTag} allLabel={t('blog.allPosts')} />
    </div>
  </aside>
</div>

<style>
  .filter-drawer {
    position: relative;
    z-index: 60;
  }

  .filter-drawer__overlay {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: rgba(5, 6, 10, 0.62);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .filter-drawer__panel {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 1;
    display: flex;
    width: min(100%, 25rem);
    height: 100dvh;
    flex-direction: column;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(17, 18, 22, 0.98);
    box-shadow: -24px 0 70px rgba(0, 0, 0, 0.28);
    transform: translateX(100%);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .filter-drawer[data-open='true'] .filter-drawer__overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .filter-drawer[data-open='true'] .filter-drawer__panel {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-drawer__overlay,
    .filter-drawer__panel {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-filter-drawer]');
    if (!root) return;

    const toggle = root.querySelector('[data-filter-toggle]');
    const close = root.querySelector('[data-filter-close]');
    const overlay = root.querySelector('[data-filter-overlay]');
    const panel = root.querySelector('[data-filter-panel]');
    if (!toggle || !close || !overlay || !panel) return;

    let lastFocused = null;

    const setOpen = (open) => {
      root.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
      overlay.setAttribute('aria-hidden', String(!open));
      document.documentElement.classList.toggle('overflow-hidden', open);
      if (open) {
        lastFocused = document.activeElement;
        close.focus();
      } else if (lastFocused instanceof HTMLElement) {
        lastFocused.focus();
      }
    };

    toggle.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));
    overlay.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.dataset.open === 'true') setOpen(false);
    });
  })();
</script>
