---
/** Home page projects: the eight I run now, and a way to the full archive. */
import ProjectCards from './ProjectCards.astro';
import MoreLink from './MoreLink.astro';
import { defaultLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';
import { getPages } from '../i18n/pages';
import { featured, allProjects } from '../data/projects';

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const t = getHome(locale).projects;
const p = getPages(locale).featured;
const prefix = locale === defaultLocale ? '' : `/${locale}`;
---

<section id="projects" class="featured terminal-section" aria-labelledby="featured-heading">
  <div class="terminal-container">
    <header class="featured__header">
      <div>
        <p class="terminal-kicker">{t.eyebrow}</p>
        <h2 id="featured-heading" class="terminal-heading">{t.heading}</h2>
      </div>
      <p data-reveal>{p.intro}</p>
    </header>
    <ProjectCards locale={locale} items={featured} spans={{ 'Marketmaker.cc': 6, 'Cmdop.com': 6 }} />
    <MoreLink locale={locale} href={`${prefix}/projects/`} label={p.all} count={allProjects.length} note={p.allNote} />
  </div>
</section>

<style>
  .featured { padding-block: clamp(4rem, 8vw, 7rem); }
  .featured__header { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: end; padding-block-end: clamp(2rem, 4vw, 3rem); }
  .featured__header .terminal-heading { margin-block-start: 1rem; }
  .featured__header > p { max-inline-size: 46ch; margin: 0; color: var(--terminal-muted); font-size: var(--text-base); line-height: 1.6; text-wrap: pretty; }
  @media (max-width: 900px) {
    .featured__header { grid-template-columns: 1fr; align-items: start; }
  }
</style>
