---
import { defaultLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const t = getHome(locale).frontier;

interface FrontierProject {
  name: keyof typeof t.descs;
  tags: string[];
  url: string;
  signal: string;
}

const frontier: FrontierProject[] = [
  { name: 'Marketmaker.cc', tags: ['Go', 'TypeScript', 'QuestDB', 'DuckDB'], url: 'https://marketmaker.cc', signal: 'MM/CORE-01' },
  { name: 'Cmdop.com', tags: ['TypeScript', 'AI Agents'], url: 'https://cmdop.com', signal: 'CMD/OPS-02' },
];
---

<section id="frontier" class="frontier terminal-section" aria-labelledby="frontier-heading">
  <div class="terminal-container">
    <header class="frontier__header">
      <div>
        <p class="terminal-kicker">{t.eyebrow} / COMMAND SYSTEMS</p>
        <h2 id="frontier-heading" class="terminal-heading">{t.heading}</h2>
      </div>
      <p>{t.intro}</p>
      <span aria-hidden="true">[ LEAD / BUILD / SHIP ]</span>
    </header>

    <div class="frontier__projects">
      {frontier.map((project, index) => (
        <a href={project.url} target="_blank" rel="noopener noreferrer" class="frontier__project">
          <div class="project__meta">
            <span>0{index + 1}</span>
            <span>{project.signal}</span>
            <span class="project__status"><i aria-hidden="true"></i>{t.status_active}</span>
          </div>
          <div class="project__title-row">
            <h3 class="display-type">{project.name}</h3>
            <span aria-hidden="true">↗</span>
          </div>
          <p class="project__role">[ {t.roles[project.name]} / OPERATING ROLE ]</p>
          <p class="project__desc">{t.descs[project.name]}</p>
          <div class="project__tags">
            {project.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <svg viewBox="0 0 520 82" preserveAspectRatio="none" aria-hidden="true">
            <path d={index === 0 ? 'M0 58L37 55L74 59L111 31L148 47L185 24L222 46L259 12L296 35L333 28L370 42L407 19L444 34L481 22L520 27' : 'M0 43L37 40L74 48L111 45L148 22L185 33L222 29L259 35L296 16L333 24L370 20L407 30L444 12L481 21L520 17'} />
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .frontier { border-block-end: 1px solid var(--terminal-line, #303431); }
  .frontier__header { display: grid; grid-template-columns: 1fr .55fr auto; align-items: end; gap: 3rem; padding: clamp(3.5rem, 7vw, 7rem) clamp(1rem, 3.5vw, 3.75rem); border-block-end: 1px solid var(--terminal-line, #303431); }
  .frontier__header .terminal-heading { max-inline-size: 12ch; margin-block-start: 1.25rem; font-size: clamp(3.5rem, 6.5vw, 7.5rem); line-height: .85; }
  .frontier__header > p { color: var(--terminal-muted, #8b908c); font: .75rem/1.65 var(--font-mono, monospace); }
  .frontier__header > span { color: #ff3b30; font: .56rem/1 var(--font-mono, monospace); letter-spacing: .1em; }
  .frontier__projects { display: grid; grid-template-columns: 1.12fr .88fr; }
  .frontier__project { position: relative; min-width: 0; min-block-size: 34rem; padding: clamp(1.5rem, 3.5vw, 3.75rem); overflow: hidden; color: inherit; text-decoration: none; }
  .frontier__project:first-child { border-inline-end: 1px solid var(--terminal-line, #303431); }
  .project__meta { display: grid; grid-template-columns: 2rem 1fr auto; gap: 1rem; color: var(--terminal-muted, #747a75); font: .58rem/1 var(--font-mono, monospace); letter-spacing: .09em; }
  .project__status { display: inline-flex; align-items: center; gap: .55rem; text-transform: uppercase; }
  .project__status i { inline-size: .35rem; block-size: .35rem; background: #4af626; }
  .project__title-row { display: flex; align-items: start; justify-content: space-between; gap: 1rem; margin-block-start: 5rem; }
  .project__title-row h3 { color: var(--terminal-fg, #e7e9e3); font-size: clamp(2.8rem, 5.7vw, 6.8rem); font-weight: 850; letter-spacing: -.065em; line-height: .82; text-transform: uppercase; overflow-wrap: anywhere; }
  .project__title-row > span { color: #ff3b30; font: 2rem/1 var(--font-mono, monospace); }
  .project__role { margin-block-start: 1.5rem; color: #ff3b30; font: .62rem/1 var(--font-mono, monospace); letter-spacing: .1em; }
  .project__desc { max-inline-size: 55ch; margin-block-start: 2.25rem; color: var(--terminal-muted, #969b97); font-size: .85rem; line-height: 1.65; }
  .project__tags { position: absolute; inset-inline: clamp(1.5rem, 3.5vw, 3.75rem); inset-block-end: 2.2rem; display: flex; flex-wrap: wrap; gap: 1rem; color: var(--terminal-muted, #747a75); font: .57rem/1 var(--font-mono, monospace); letter-spacing: .08em; text-transform: uppercase; }
  .project__tags span::before { content: "[ "; }.project__tags span::after { content: " ]"; }
  .frontier__project > svg { position: absolute; inset-inline: 45% -3rem; inset-block-end: 5rem; inline-size: 58%; block-size: 5rem; opacity: .45; }
  .frontier__project > svg path { fill: none; stroke: var(--terminal-muted, #747a75); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .frontier__project:hover { background: #151816; }
  .frontier__project:hover h3 { color: #ff3b30; }
  .frontier__project:focus-visible { outline: 2px solid #ff3b30; outline-offset: -3px; }
  @media (max-width: 800px) {
    .frontier__header { grid-template-columns: 1fr; }
    .frontier__header > span { display: none; }
    .frontier__projects { grid-template-columns: 1fr; }
    .frontier__project:first-child { border-inline-end: 0; border-block-end: 1px solid var(--terminal-line, #303431); }
  }
  @media (max-width: 520px) { .frontier__project { min-block-size: 30rem; } }
</style>
