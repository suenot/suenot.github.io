---
import * as si from 'simple-icons';
import { defaultLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const t = getHome(locale).tech;
type TechCategoryKey = keyof typeof t.categories;

// Map tech names to simple-icons slugs
const iconMap: Record<string, string> = {
  'TypeScript': 'siTypescript',
  'JavaScript': 'siJavascript',
  'Python': 'siPython',
  'Go': 'siGo',
  'Swift': 'siSwift',
  'Zig': 'siZig',
  'Rust': 'siRust',
  'Lua': 'siLua',
  'C++': 'siCplusplus',
  'C#': 'siCsharp',
  'Kotlin': 'siKotlin',
  'Haskell': 'siHaskell',
  'PostgreSQL': 'siPostgresql',
  'QuestDB': 'siQuestdb',
  'Redis': 'siRedis',
  'MongoDB': 'siMongodb',
  'DuckDB': 'siDuckdb',
  'MySQL': 'siMysql',
  'SQLite': 'siSqlite',
  'Apache Kafka': 'siApachekafka',
  'Hasura': 'siHasura',
  'GraphQL': 'siGraphql',
  'React': 'siReact',
  'Vue': 'siVuedotjs',
  'Angular': 'siAngular',
  'Svelte': 'siSvelte',
  'Docker': 'siDocker',
  'Kubernetes': 'siKubernetes',
  'Terraform': 'siTerraform',
  'Argo CD': 'siArgocd',
  'Pulumi': 'siPulumi',
  'Nginx': 'siNginx',
  'Apache': 'siApache',
  'Traefik': 'siTraefikproxy',
  'Istio': 'siIstio',
  'Prometheus': 'siPrometheus',
  'Grafana': 'siGrafana',
  'containerd': 'siContainerd',
  'ClickHouse': 'siClickhouse',
  'Apache ECharts': 'siApacheecharts',
  'Electron': 'siElectron',
  'Ionic': 'siIonic',
  'Capacitor': 'siCapacitor',
  'Binance': 'siBinance',
};

function getIcon(name: string): { path: string; hex: string } | null {
  const key = iconMap[name];
  if (!key) return null;
  const icon = (si as Record<string, { path: string; hex: string } | undefined>)[key];
  return icon ?? null;
}

const techCategories = [
