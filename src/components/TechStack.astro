---
import * as si from 'simple-icons';
import { defaultLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';
import { techCategories, sparkRays, sparkRayWidth, skillCount } from '../data/tech';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const t = getHome(locale).tech;
type TechCategoryKey = keyof typeof t.categories;

// Map tech names to simple-icons slugs
const iconMap: Record<string, string> = {
  'TypeScript': 'siTypescript',
  'JavaScript': 'siJavascript',
  'Python': 'siPython',
  'Go': 'siGo',
  'Swift': 'siSwift',
  'Zig': 'siZig',
  'Rust': 'siRust',
  'Lua': 'siLua',
  'C++': 'siCplusplus',
  'C#': 'siCsharp',
  'Kotlin': 'siKotlin',
  'Haskell': 'siHaskell',
  'PostgreSQL': 'siPostgresql',
  'QuestDB': 'siQuestdb',
  'Redis': 'siRedis',
  'MongoDB': 'siMongodb',
  'DuckDB': 'siDuckdb',
  'MySQL': 'siMysql',
  'SQLite': 'siSqlite',
  'Apache Kafka': 'siApachekafka',
  'Hasura': 'siHasura',
  'GraphQL': 'siGraphql',
  'React': 'siReact',
  'Astro': 'siAstro',
  'Vue': 'siVuedotjs',
  'Angular': 'siAngular',
  'Svelte': 'siSvelte',
  'Docker': 'siDocker',
  'Kubernetes': 'siKubernetes',
  'Terraform': 'siTerraform',
  'Argo CD': 'siArgocd',
  'Pulumi': 'siPulumi',
  'Nginx': 'siNginx',
  'Apache': 'siApache',
  'Traefik': 'siTraefikproxy',
  'Istio': 'siIstio',
  'Prometheus': 'siPrometheus',
  'Grafana': 'siGrafana',
  'containerd': 'siContainerd',
  'ClickHouse': 'siClickhouse',
  'Apache ECharts': 'siApacheecharts',
  'Electron': 'siElectron',
  'Ionic': 'siIonic',
  'Capacitor': 'siCapacitor',
  'Binance': 'siBinance',
};

function getIcon(name: string): { path: string; hex: string } | null {
  const key = iconMap[name];
  if (!key) return null;
  const icon = (si as Record<string, { path: string; hex: string } | undefined>)[key];
  return icon ?? null;
}

const rays = sparkRays;
const rayWidth = sparkRayWidth;
let skillIndex = 0;
---

<section id="tech" class="tech terminal-section" aria-labelledby="tech-heading">
  <div class="terminal-container tech__layout">
    <header class="tech__header">
      <p class="terminal-kicker">{t.eyebrow}</p>
      <h2 id="tech-heading" class="terminal-heading">{t.heading}</h2>
      <figure class="spark" data-spark aria-label={`${skillCount} skills`}>
        <div class="spark__stage" data-spark-stage>
          <svg class="spark__rays" viewBox="-110 -110 220 220" aria-hidden="true">
            <g class="spark__body" data-spark-body>
              {rays.map((ray, i) => (
                <line class="spark__ray" data-ray={i} x1={0} y1={0} x2={ray.x.toFixed(2)} y2={ray.y.toFixed(2)} style={`--dx:${(ray.gx * 14).toFixed(2)}px;--dy:${(ray.gy * 14).toFixed(2)}px`} stroke-width={rayWidth} />
              ))}
            </g>
          </svg>
          {/* Poke the spark: eyes open; poke fast and it gets annoyed, then angry. */}
          <svg class="spark__face" viewBox="-110 -110 220 220" aria-hidden="true">
            <path class="spark__brows" d="M-27 -25L-9 -15M27 -25L9 -15" />
            <rect class="spark__eye" x="-20" y="-11" width="9" height="15" />
            <rect class="spark__eye" x="11" y="-11" width="9" height="15" />
          </svg>
        </div>
        <figcaption><span data-spark-name>{skillCount}</span> <span data-spark-label>skills</span></figcaption>
      </figure>
      <div class="tech__legend" aria-hidden="true" data-reveal>
        <span>PRIMARY / HIGH</span><span>SECONDARY / OPERATIONAL</span>
      </div>
    </header>

    <div class="tech__matrix">
      {techCategories.map((category, categoryIndex) => (
        <section class:list={["tech__category", { "tech__category--primary": category.primary }]}>
          <header data-reveal>
            <span>{String(categoryIndex + 1).padStart(2, '0')}</span>
            <h3>{t.categories[category.name as TechCategoryKey] ?? category.name}</h3>
            <span>{category.items.length} UNITS</span>
          </header>
          <ul>
            {category.items.map((tech, techIndex) => {
              const icon = getIcon(tech.name);
              return (
                <li data-reveal data-skill={skillIndex++}>
                  <span class="tech__id">{String(categoryIndex + 1).padStart(2, '0')}.{String(techIndex + 1).padStart(2, '0')}</span>
                  {icon ? (
                    <svg role="img" viewBox="0 0 24 24" aria-label={tech.name}><path d={icon.path} /></svg>
                  ) : <span class="tech__fallback" aria-hidden="true">+</span>}
                  <span class="tech__name">{tech.name}</span>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .tech { border-block-end: 1px solid var(--terminal-line, #303431); }
  .tech__layout { display: grid; grid-template-columns: minmax(18rem, .58fr) minmax(0, 1.42fr); }
  .tech__header { position: sticky; inset-block-start: 4rem; align-self: start; min-block-size: min(48rem, 92dvh); padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 3.5vw, 3.75rem); border-inline-end: 1px solid var(--terminal-line, #303431); }
  .tech__header .terminal-heading { max-inline-size: 9ch; margin-block-start: 1.25rem; font-size: clamp(3.6rem, 6vw, 7rem); line-height: .84; }
  .tech__legend { position: absolute; inset-inline: clamp(1rem, 3.5vw, 3.75rem); inset-block-end: 2rem; display: grid; gap: .65rem; color: var(--terminal-muted, #747a75); font: .75rem/1 var(--font-mono); letter-spacing: .1em; }
  .tech__legend span::before { content: "□"; margin-inline-end: .7rem; color: var(--terminal-accent); }
  .tech__matrix { min-width: 0; }
  .spark { margin: clamp(2rem, 4vw, 3.5rem) 0 6rem; inline-size: min(100%, 20rem); }
  .spark { user-select: none; }
  .spark svg { display: block; inline-size: 100%; overflow: visible; }
  .spark__stage { position: relative; cursor: pointer; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .spark__body { transform-box: fill-box; transform-origin: center; }
  /* --heat (0..1) is how angry the spark is; it reddens the rays. */
  .spark__ray { stroke: color-mix(in oklab, #d97757, #d42a1c calc(var(--heat, 0) * 100%)); stroke-linecap: round; transition: transform 260ms var(--ease-out), stroke 200ms, stroke-width 260ms var(--ease-out), opacity 200ms; }
  .spark.is-focus .spark__ray { opacity: .35; }
  .spark .spark__ray.is-on { opacity: 1; stroke: #c15f3c; stroke-width: calc(var(--w, 4) * 1px); transform: translate(var(--dx), var(--dy)); }
  .spark figcaption { margin-block-start: 1.25rem; color: var(--terminal-muted); font: .75rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .spark figcaption [data-spark-name] { color: var(--terminal-ink); }
  .spark[data-mood="angry"] figcaption [data-spark-name] { color: #d42a1c; }
  .spark__face { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 220ms; }
  .spark[data-mood] .spark__face { opacity: 1; }
  .spark__eye { fill: #141413; transform-box: fill-box; transform-origin: 50% 100%; transition: scale 160ms var(--ease-out, ease); }
  .spark__brows { fill: none; stroke: #141413; stroke-width: 6; stroke-linecap: square; opacity: 0; transition: opacity 160ms; }
  .spark[data-mood="annoyed"] .spark__eye { scale: 1 .4; }
  .spark[data-mood="angry"] .spark__eye { scale: 1 .6; }
  .spark[data-mood="angry"] .spark__brows { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .spark__rays { animation: spark-spin 120s linear infinite; }
    .spark.is-focus .spark__rays { animation-play-state: paused; }
    .spark[data-mood="angry"] .spark__stage { animation: spark-shake 110ms linear infinite; }
  }
  @keyframes spark-spin { to { rotate: 360deg; } }
  @keyframes spark-shake {
    0%, 100% { translate: 0 0; }
    25% { translate: -2px 1px; }
    50% { translate: 2px -1px; }
    75% { translate: -1px -2px; }
  }
  .tech__category { border-block-end: 1px solid var(--terminal-line, #303431); }
  .tech__category > header { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1rem; padding: 1rem 1.4rem; color: var(--terminal-muted, #8b908c); font: .75rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .tech__category header h3 { color: var(--terminal-fg, #e7e9e3); font: inherit; }
  .tech__category ul { display: grid; grid-template-columns: repeat(3, 1fr); border-block-start: 1px solid var(--terminal-line, #303431); }
  .tech__category li { display: grid; grid-template-columns: 2.25rem 1rem 1fr; gap: .65rem; align-items: center; min-block-size: 3.4rem; padding: .8rem 1rem; border-inline-end: 1px solid var(--terminal-line, #303431); border-block-end: 1px solid var(--terminal-line, #303431); color: var(--terminal-muted, #969b97); font: .75rem/1.25 var(--font-mono); }
  .tech__category li:nth-child(3n) { border-inline-end: 0; }
  .tech__category li:hover { color: var(--terminal-fg, #e7e9e3); background: var(--terminal-hover); }
  .tech__category--primary li { min-block-size: 4.25rem; color: var(--terminal-fg, #e7e9e3); }
  .tech__category svg { inline-size: .85rem; block-size: .85rem; fill: currentColor; }
  .tech__id { color: var(--terminal-faint); font-size: .75rem; }
  .tech__fallback { color: var(--terminal-accent); }
  @media (max-width: 900px) {
    .spark { margin-block-end: 2rem; inline-size: min(70%, 16rem); }
    .tech__layout { grid-template-columns: 1fr; }
    .tech__header { position: relative; inset-block-start: auto; min-block-size: 24rem; border-inline-end: 0; border-block-end: 1px solid var(--terminal-line, #303431); }
  }
  @media (max-width: 620px) {
    .tech__category ul { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .tech__category li { grid-template-columns: 2rem 1rem minmax(0, 1fr); }
    .tech__name { overflow-wrap: anywhere; }
    .tech__category li:nth-child(3n) { border-inline-end: 1px solid var(--terminal-line, #303431); }
    .tech__category li:nth-child(2n) { border-inline-end: 0; }
  }
  @media (max-width: 400px) {
    .tech__category ul { grid-template-columns: 1fr; }
    .tech__category li { border-inline-end: 0 !important; }
  }
  .tech .terminal-heading { font-size: clamp(2.25rem, 3.6vw, 3.5rem); }
</style>

<script>
  /* Hover a skill: its ray of the spark grows. */
  const initSpark = () => {
    const spark = document.querySelector<HTMLElement>('[data-spark]');
    if (!spark) return;
    const rays = [...spark.querySelectorAll<SVGLineElement>('[data-ray]')];
    const name = spark.querySelector<HTMLElement>('[data-spark-name]')!;
    const label = spark.querySelector<HTMLElement>('[data-spark-label]')!;
    const total = name.textContent;
    const width = parseFloat(rays[0]?.getAttribute('stroke-width') ?? '4');
    spark.style.setProperty('--w', String(Math.max(width * 2.4, 9)));
    document.querySelectorAll<HTMLElement>('#tech [data-skill]').forEach((li) => {
      const ray = rays[Number(li.dataset.skill)];
      if (!ray) return;
      li.addEventListener('pointerenter', () => {
        ray.classList.add('is-on');
        spark.classList.add('is-focus');
        name.textContent = li.querySelector('.tech__name')?.textContent ?? '';
        label.textContent = '';
      });
      li.addEventListener('pointerleave', () => {
        ray.classList.remove('is-on');
        spark.classList.remove('is-focus');
        name.textContent = total;
        label.textContent = 'skills';
      });
    });
  };
  /* Poke the spark: it looks at you; poke fast and it gets annoyed, then angry (red, bristling, spinning, shaking). It cools down on its own. */
  const initPoke = () => {
    const spark = document.querySelector<HTMLElement>('[data-spark]');
    const stage = spark?.querySelector<HTMLElement>('[data-spark-stage]');
    const body = spark?.querySelector<SVGGElement>('[data-spark-body]');
    if (!spark || !stage || !body || stage.dataset.poke) return;
    stage.dataset.poke = '1';
    const name = spark.querySelector<HTMLElement>('[data-spark-name]')!;
    const label = spark.querySelector<HTMLElement>('[data-spark-label]')!;
    const total = name.textContent;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rays = [...body.querySelectorAll<SVGLineElement>('[data-ray]')].map((el) => {
      const x = Number(el.getAttribute('x2'));
      const y = Number(el.getAttribute('y2'));
      const len = Math.hypot(x, y) || 1;
      return { el, gx: x / len, gy: y / len };
    });
    const PER_POKE = .16;
    const COOL_PER_S = .45;
    let heat = 0;
    let mood = '';
    let frame = 0;
    let last = 0;
    let twitched = 0;
    let poked = 0;
    const LOOK_MS = 1200;

    const kick = (ray: typeof rays[number], k: number, ms: number) => {
      ray.el.animate(
        [{ translate: '0 0' }, { translate: `${(ray.gx * k).toFixed(1)}px ${(ray.gy * k).toFixed(1)}px` }, { translate: '0 0' }],
        { duration: ms, easing: 'cubic-bezier(.2,.7,.3,1)' },
      );
    };

    const setMood = (next: string) => {
      if (next === mood) return;
      const was = mood;
      mood = next;
      if (next) spark.dataset.mood = next;
      else delete spark.dataset.mood;
      if (next === 'angry') {
        name.textContent = '!!!';
        label.textContent = '';
        if (!still) rays.forEach((r) => kick(r, 24 + Math.random() * 18, 420 + Math.random() * 240));
      } else if (was === 'angry') {
        name.textContent = total;
        label.textContent = 'skills';
      }
      /* Calmed down: one slow breath out. */
      if (!next && was && was !== 'poked' && !still) {
        body.animate([{ scale: 1 }, { scale: .95 }, { scale: 1 }], { duration: 1100, easing: 'ease-in-out' });
      }
    };

    const tick = (now: number) => {
      heat = Math.max(0, heat - ((now - last) / 1000) * COOL_PER_S);
      last = now;
      const h = Math.min(heat, 1);
      spark.style.setProperty('--heat', h.toFixed(3));
      stage.querySelector('.spark__rays')?.getAnimations().forEach((a) => a.updatePlaybackRate(1 + h * h * 70));
      const looking = now - poked < LOOK_MS;
      setMood(heat >= .75 ? 'angry' : heat >= .4 ? 'annoyed' : heat > .02 || looking ? 'poked' : '');
      /* Angry: random rays keep bristling. */
      if (mood === 'angry' && !still && now - twitched > 90) {
        twitched = now;
        for (let i = 0; i < 6; i++) kick(rays[(Math.random() * rays.length) | 0], 8 + Math.random() * 14, 220);
      }
      if (heat > 0 || looking) frame = requestAnimationFrame(tick);
      else {
        frame = 0;
        spark.style.removeProperty('--heat');
      }
    };

    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      heat = Math.min(1.25, heat + PER_POKE);
      poked = performance.now();
      if (!frame) {
        last = performance.now();
        frame = requestAnimationFrame(tick);
      }
      if (still) return;
      const h = Math.min(heat, 1);
      body.animate(
        [{ scale: 1 }, { scale: .86 }, { scale: 1.05 + h * .12 }, { scale: 1 }],
        { duration: 460, easing: 'cubic-bezier(.3,.7,.3,1)' },
      );
      rays.forEach((r) => kick(r, (3 + h * 16) * (.5 + Math.random()), 320 + Math.random() * 160));
    });
  };

  initSpark();
  initPoke();
  document.addEventListener('astro:page-load', () => { initSpark(); initPoke(); });
</script>
