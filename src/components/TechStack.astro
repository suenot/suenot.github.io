---

<section id="tech" class="tech terminal-section" aria-labelledby="tech-heading">
  <div class="terminal-container tech__layout">
    <header class="tech__header">
      <p class="terminal-kicker">{t.eyebrow} / CAPABILITY MATRIX</p>
      <h2 id="tech-heading" class="terminal-heading">{t.heading}</h2>
      <div class="tech__legend" aria-hidden="true">
        <span>PRIMARY / HIGH</span><span>SECONDARY / OPERATIONAL</span>
      </div>
    </header>

    <div class="tech__matrix">
      {techCategories.map((category, categoryIndex) => (
        <section class:list={["tech__category", { "tech__category--primary": category.primary }]}>
          <header>
            <span>{String(categoryIndex + 1).padStart(2, '0')}</span>
            <h3>{t.categories[category.name as TechCategoryKey] ?? category.name}</h3>
            <span>{category.items.length} UNITS</span>
          </header>
          <ul>
            {category.items.map((tech, techIndex) => {
              const icon = getIcon(tech.name);
              return (
                <li>
                  <span class="tech__id">{String(categoryIndex + 1).padStart(2, '0')}.{String(techIndex + 1).padStart(2, '0')}</span>
                  {icon ? (
                    <svg role="img" viewBox="0 0 24 24" aria-label={tech.name}><path d={icon.path} /></svg>
                  ) : <span class="tech__fallback" aria-hidden="true">+</span>}
                  <span class="tech__name">{tech.name}</span>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .tech { border-block-end: 1px solid var(--terminal-line, #303431); }
  .tech__layout { display: grid; grid-template-columns: minmax(18rem, .58fr) minmax(0, 1.42fr); }
  .tech__header { position: sticky; inset-block-start: 4rem; align-self: start; min-block-size: min(48rem, 92dvh); padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 3.5vw, 3.75rem); border-inline-end: 1px solid var(--terminal-line, #303431); }
  .tech__header .terminal-heading { max-inline-size: 9ch; margin-block-start: 1.25rem; font-size: clamp(3.6rem, 6vw, 7rem); line-height: .84; }
  .tech__legend { position: absolute; inset-inline: clamp(1rem, 3.5vw, 3.75rem); inset-block-end: 2rem; display: grid; gap: .65rem; color: var(--terminal-muted, #747a75); font: .57rem/1 var(--font-mono, monospace); letter-spacing: .1em; }
  .tech__legend span::before { content: "□"; margin-inline-end: .7rem; color: #ff3b30; }
  .tech__matrix { min-width: 0; }
  .tech__category { border-block-end: 1px solid var(--terminal-line, #303431); }
  .tech__category > header { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1rem; padding: 1rem 1.4rem; color: var(--terminal-muted, #8b908c); font: .58rem/1 var(--font-mono, monospace); letter-spacing: .1em; text-transform: uppercase; }
  .tech__category header h3 { color: var(--terminal-fg, #e7e9e3); font: inherit; }
  .tech__category ul { display: grid; grid-template-columns: repeat(3, 1fr); border-block-start: 1px solid var(--terminal-line, #303431); }
  .tech__category li { display: grid; grid-template-columns: 2.25rem 1rem 1fr; gap: .65rem; align-items: center; min-block-size: 3.4rem; padding: .8rem 1rem; border-inline-end: 1px solid var(--terminal-line, #303431); border-block-end: 1px solid var(--terminal-line, #303431); color: var(--terminal-muted, #969b97); font: .65rem/1.25 var(--font-mono, monospace); }
  .tech__category li:nth-child(3n) { border-inline-end: 0; }
  .tech__category li:hover { color: var(--terminal-fg, #e7e9e3); background: #151816; }
  .tech__category--primary li { min-block-size: 4.25rem; color: var(--terminal-fg, #e7e9e3); }
  .tech__category svg { inline-size: .85rem; block-size: .85rem; fill: currentColor; }
  .tech__id { color: #5d625e; font-size: .5rem; }
  .tech__fallback { color: #ff3b30; }
  @media (max-width: 900px) {
    .tech__layout { grid-template-columns: 1fr; }
    .tech__header { position: relative; inset-block-start: auto; min-block-size: 24rem; border-inline-end: 0; border-block-end: 1px solid var(--terminal-line, #303431); }
  }
  @media (max-width: 620px) {
    .tech__category ul { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .tech__category li { grid-template-columns: 2rem 1rem minmax(0, 1fr); }
    .tech__name { overflow-wrap: anywhere; }
    .tech__category li:nth-child(3n) { border-inline-end: 1px solid var(--terminal-line, #303431); }
    .tech__category li:nth-child(2n) { border-inline-end: 0; }
  }
  @media (max-width: 400px) {
    .tech__category ul { grid-template-columns: 1fr; }
    .tech__category li { border-inline-end: 0 !important; }
  }
</style>
