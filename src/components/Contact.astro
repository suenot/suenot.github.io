---
import { defaultLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const t = getHome(locale).contact;

const links = [
  { name: 'GitHub', handle: 'suenot', url: 'https://github.com/suenot' },
  { name: 'Telegram', handle: '@suenot', url: 'https://t.me/suenot' },
  { name: 'LinkedIn', handle: 'suenot', url: 'https://www.linkedin.com/in/suenot/' },
  { name: 'Email', handle: 'suenot@gmail.com', url: 'mailto:suenot@gmail.com' },
  { name: 'Stack Overflow', handle: 'eugen-soloviov', url: 'https://stackoverflow.com/users/937966/eugen-soloviov' },
  { name: 'Habr', handle: 'suenot', url: 'https://habr.com/ru/users/suenot/' },
  { name: 'X / Twitter', handle: '@suenot', url: 'https://x.com/suenot' },
  { name: 'Instagram', handle: 'evgeniy.soloviov', url: 'https://www.instagram.com/evgeniy.soloviov/' },
  { name: 'Facebook', handle: 'soloviov.evgeniy', url: 'https://www.facebook.com/soloviov.evgeniy/' },
];
---

<section id="contact" class="contact terminal-section" aria-labelledby="contact-heading">
  <div class="terminal-container">
    <header class="contact__header">
      <p class="terminal-kicker">{t.eyebrow} / OPEN COMMUNICATION LINK</p>
      <h2 id="contact-heading" class="terminal-heading">{t.heading}</h2>
      <p>{t.intro}</p>
    </header>

    <a class="contact__primary" href="mailto:suenot@gmail.com">
      <span>PRIMARY CHANNEL / EMAIL</span>
      <strong>suenot@gmail.com</strong>
      <span aria-hidden="true">→</span>
    </a>

    <nav class="contact__links" aria-label="Contact channels">
      {links.map((link, index) => (
        <a href={link.url} target={link.url.startsWith('mailto:') ? undefined : '_blank'} rel={link.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div><strong>{link.name}</strong><span>{link.handle}</span></div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .contact { border-block-end: 1px solid var(--terminal-line, #303431); }
  .contact__header { display: grid; grid-template-columns: 1fr .6fr; gap: 2rem 6rem; align-items: end; padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 3.5vw, 3.75rem) 3rem; }
  .contact__header .terminal-kicker { grid-column: 1 / -1; }
  .contact__header .terminal-heading { max-inline-size: 10ch; font-size: clamp(4rem, 9vw, 10.5rem); line-height: .78; }
  .contact__header > p:last-child { max-inline-size: 48ch; color: var(--terminal-muted, #969b97); font: .78rem/1.7 var(--font-mono, monospace); }
  .contact__primary { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 1rem; padding: clamp(2rem, 4vw, 4rem) clamp(1rem, 3.5vw, 3.75rem); border-block: 1px solid var(--terminal-line, #303431); color: inherit; text-decoration: none; }
  .contact__primary > span:first-child { grid-column: 1 / -1; color: #ff3b30; font: .6rem/1 var(--font-mono, monospace); letter-spacing: .12em; }
  .contact__primary strong { color: var(--terminal-fg, #e7e9e3); font-size: clamp(2rem, 5.5vw, 6.5rem); font-weight: 750; letter-spacing: -.06em; line-height: .85; overflow-wrap: anywhere; }
  .contact__primary > span:last-child { color: #ff3b30; font: clamp(2rem, 4vw, 4.5rem)/1 var(--font-mono, monospace); }
  .contact__primary:hover { background: var(--terminal-fg, #e7e9e3); }
  .contact__primary:hover strong { color: var(--terminal-bg, #0b0d0c); }
  .contact__links { display: grid; grid-template-columns: repeat(3, 1fr); }
  .contact__links a { display: grid; grid-template-columns: 2rem 1fr auto; gap: 1rem; align-items: center; min-block-size: 6.5rem; padding: 1.25rem clamp(1rem, 2vw, 2rem); border-inline-end: 1px solid var(--terminal-line, #303431); border-block-end: 1px solid var(--terminal-line, #303431); color: inherit; text-decoration: none; }
  .contact__links a:nth-child(3n) { border-inline-end: 0; }
  .contact__links a > span:first-child { color: #ff3b30; font: .55rem/1 var(--font-mono, monospace); }
  .contact__links a div { display: grid; gap: .45rem; min-width: 0; }
  .contact__links strong { color: var(--terminal-fg, #e7e9e3); font: 600 .75rem/1 var(--font-mono, monospace); letter-spacing: .07em; text-transform: uppercase; }
  .contact__links div span { color: var(--terminal-muted, #747a75); font: .58rem/1 var(--font-mono, monospace); overflow-wrap: anywhere; }
  .contact__links a > span:last-child { color: var(--terminal-muted, #747a75); }
  .contact__links a:hover, .contact__links a:focus-visible { background: #151816; }
  .contact__links a:hover > span:last-child { color: #ff3b30; }
  .contact a:focus-visible { outline: 2px solid #ff3b30; outline-offset: -3px; }
  @media (max-width: 800px) {
    .contact__header { grid-template-columns: 1fr; }
    .contact__header .terminal-kicker { grid-column: auto; }
    .contact__links { grid-template-columns: 1fr 1fr; }
    .contact__links a:nth-child(3n) { border-inline-end: 1px solid var(--terminal-line, #303431); }
    .contact__links a:nth-child(2n) { border-inline-end: 0; }
  }
  @media (max-width: 520px) {
    .contact__links { grid-template-columns: 1fr; }
    .contact__links a { border-inline-end: 0 !important; }
  }
</style>
