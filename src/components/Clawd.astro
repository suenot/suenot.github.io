---
/**
 * Clawd, the pixel critter. One instance per page, in a layer over the whole document.
 * On pages with tour, it walks the visitor through the page: it waits on the heading of the
 * section being read and jumps to the next one as it scrolls into view. Everywhere it ends on
 * the footer wordmark, where it patrols the letters.
 * Clicked, it hops in place, and every hop batters what it stands on: a title square is pressed in,
 * tilts, hangs by a corner and falls off (Clawd puts a new one in); a heading sinks and tips; a
 * footer letter sinks and leans. Once the clicking stops, Clawd mends it step by step.
 */
interface Props {
  /** Visit every h1/h2 in main before the footer. */
  tour?: boolean;
}

const { tour = false } = Astro.props;

/* 13 x 9 pixel frames: # body, e eye. */
const frames = {
  idle: [
    '..#########..',
    '..#########..',
    '..##e###e##..',
    '####e###e####',
    '#############',
    '..#########..',
    '..#########..',
    '..#.#...#.#..',
    '..#.#...#.#..',
  ],
  jump: [
    '..#########..',
    '..#########..',
    '####e###e####',
    '####e###e####',
    '..#########..',
    '..#########..',
    '..#########..',
    '.#..#...#..#.',
    '#...........#',
  ],
};

/* Horizontal runs, a hair taller than a pixel so scaled frames show no seams between rows. */
const runs = (rows: string[], test: (ch: string) => boolean) =>
  rows
    .flatMap((row, y) => [...row.matchAll(/./g)]
      .reduce<{ x: number; n: number }[]>((acc, m) => {
        const x = m.index ?? 0;
        if (!test(m[0])) return acc;
        const last = acc.at(-1);
        if (last && last.x + last.n === x) last.n += 1;
        else acc.push({ x, n: 1 });
        return acc;
      }, [])
      .map(({ x, n }) => `M${x} ${y}h${n}v1.04h-${n}z`))
    .join('');

const art = Object.entries(frames).map(([name, rows]) => ({
  name,
  body: runs(rows, (ch) => ch !== '.'),
  eyes: runs(rows, (ch) => ch === 'e'),
}));
---

<div class="clawd-layer" data-clawd-layer data-tour={tour ? '' : undefined} aria-hidden="true">
  <div class="clawd" data-clawd>
    <div class="clawd__body">
      {art.map((frame) => (
        <svg class={`clawd__frame clawd__frame--${frame.name}`} viewBox="0 0 13 9" shape-rendering="crispEdges">
          <path d={frame.body} fill="var(--clawd)" />
          <path class="clawd__eyes" d={frame.eyes} fill="var(--clawd-eye)" />
        </svg>
      ))}
    </div>
  </div>
</div>

<style is:global>
  .clawd-layer {
    --clawd: #d97757;
    --clawd-eye: #141413;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 40;
    width: 100%;
    height: 0;
    overflow-x: clip;
    pointer-events: none;
  }

  .clawd {
    position: absolute;
    top: 0;
    left: 0;
    width: 52px;
    height: 36px;
    transform-origin: 50% 100%;
    cursor: pointer;
    pointer-events: auto;
    will-change: transform;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
  }

  .clawd:not([data-ready]) { visibility: hidden; }

  .clawd__body {
    position: absolute;
    inset: 0;
    transform-origin: 50% 100%;
    transition: transform 120ms ease-out;
  }

  .clawd__frame { position: absolute; inset: 0; width: 100%; height: 100%; }
  .clawd__frame--jump { visibility: hidden; }
  .clawd[data-air] .clawd__frame--jump { visibility: visible; }
  .clawd[data-air] .clawd__frame--idle { visibility: hidden; }
  .clawd[data-flip] .clawd__body { scale: -1 1; }
  .clawd[data-blink] .clawd__eyes { fill: var(--clawd); }

  .clawd-spark {
    position: absolute;
    background: var(--clawd);
    pointer-events: none;
  }

  @media (max-width: 43.75rem) {
    .clawd { width: 39px; height: 27px; }
  }
</style>

<script>
  type Pt = { x: number; y: number; s: number; r?: number; el?: HTMLElement };
  type Kind = 'text' | 'box' | 'mark';
  type Stop = { el: HTMLElement; kind: Kind; major: boolean; top: number; bottom: number; pts: Pt[] };
  type Glyph = { l: number; r: number; top: number; b: number; el?: HTMLElement };
  type Pose = { dy: number; sy: number; rot: number };
  /* A target Clawd has battered: its untouched geometry (document coordinates), the pivot it gives
     around, how many steps of damage it has taken and the pose it is in now. */
  type Hurt = {
    el: HTMLElement;
    kind: Kind;
    d: number;
    pose: Pose;
    job: number;
    ox: number;
    oy: number;
    top: number;
    bottom: number;
    unit: number;
    lever: number;
    sign: number;
    pts: Pt[];
  };

  let stopClawd: (() => void) | undefined;

  const initClawd = () => {
    stopClawd?.();
    const layer = document.querySelector<HTMLElement>('[data-clawd-layer]');
    const bot = layer?.querySelector<HTMLElement>('[data-clawd]');
    if (!layer || !bot) return;
    const body = bot.querySelector<HTMLElement>('.clawd__body')!;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tour = layer.hasAttribute('data-tour') && !still;
    const rtl = document.documentElement.dir === 'rtl';
    const mark = document.querySelector<HTMLElement>('[data-wordmark]');
    const ctx = document.createElement('canvas').getContext('2d');

    let stops: Stop[] = [];
    let cur: Stop | null = null;
    let at = 0;
    let dir = 1;
    let pos: Pt = { x: 0, y: 0, s: 1 };
    let busy = false;
    let alive = true;
    let timer = 0;
    let raf = 0;
    let letterTarget: number | null = null;
    let dirty = false;
    const visited = new WeakSet<HTMLElement>();
    const hurts = new Map<HTMLElement, Hurt>();
    let pounds = 0;
    let healTimer = 0;
    let air = false;

    const W = () => bot.offsetWidth;
    const H = () => bot.offsetHeight;

    /* Ink top of every glyph on the first line of el, in document coordinates.
       A text range box spans the font's ascent and descent; the canvas gives the same font's
       ascent and the glyph's own ascent, so the ink top is box top + ascent - glyph ascent. */
    const glyphs = (el: HTMLElement): Glyph[] => {
      const out: Glyph[] = [];
      const range = document.createRange();
      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      let line = -Infinity;
      for (let node = walker.nextNode() as Text | null; node; node = walker.nextNode() as Text | null) {
        const parent = node.parentElement!;
        if (parent.closest('[aria-hidden="true"]') && parent !== el && !parent.closest('[data-wordmark]')) continue;
        const cs = getComputedStyle(parent);
        if (ctx) ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        const text = node.data;
        for (let i = 0; i < text.length; i += 1) {
          const ch = text[i];
          if (!ch.trim()) continue;
          range.setStart(node, i);
          range.setEnd(node, i + 1);
          const r = range.getBoundingClientRect();
          if (!r.width) continue;
          if (line === -Infinity) line = r.top;
          if (r.top > line + r.height * .5) return out;
          const m = ctx?.measureText(cs.textTransform === 'uppercase' ? ch.toUpperCase() : ch);
          const top = m && m.fontBoundingBoxAscent
            ? r.top + m.fontBoundingBoxAscent - m.actualBoundingBoxAscent
            : r.top + r.height * .2;
          out.push({ l: r.left + scrollX, r: r.right + scrollX, top: top + scrollY, b: r.bottom + scrollY, el: parent });
        }
      }
      return out;
    };

    /* Standing spots along a line of glyphs, about a body apart; feet rest on the tallest glyph under them. */
    const spots = (list: Glyph[], s: number, every = 1.05) => {
      const half = W() * s * .34;
      const out: Pt[] = [];
      let last = -Infinity;
      [...list].sort((a, b) => a.l - b.l).forEach((g) => {
        const x = (g.l + g.r) / 2;
        if (x - last < W() * s * every) return;
        const under = list.filter((o) => o.r > x - half && o.l < x + half);
        out.push({ x, y: Math.min(...under.map((o) => o.top)), s });
        last = x;
      });
      return rtl ? out.reverse() : out;
    };

    /* Damage, one step per hop Clawd takes on it. A title square is pressed in, then tilts on the
       corner that ties it to the word and hangs; one more hop and it falls off. A heading sinks, then
       tips down on Clawd's side around the far end of its line. A footer letter sinks and leans. */
    const MAX = 6;
    const BOX_PRESS = [1, .9, .8, .74, .74, .74, .74];
    const BOX_TILT = [0, 0, 0, 6, 14, 28, 44];
    const TEXT_SINK = [0, .025, .05, .06, .06, .06, .06];
    const TEXT_DROP = [0, 0, 0, .14, .28, .44, .6];
    const LETTER_SINK = [0, .012, .024, .03, .03, .03, .03];
    const LETTER_TILT = [0, 0, 0, 4, 9, 15, 21];

    const poseOf = (h: Hurt): Pose => {
      const d = Math.max(0, Math.min(h.d, MAX));
      if (h.kind === 'box') return { dy: 0, sy: BOX_PRESS[d], rot: h.sign * BOX_TILT[d] };
      if (h.kind === 'text') {
        const tilt = Math.min(12, (Math.atan2(h.unit * TEXT_DROP[d], h.lever) * 180) / Math.PI);
        return { dy: h.unit * TEXT_SINK[d], sy: 1, rot: h.sign * tilt };
      }
      return { dy: h.unit * LETTER_SINK[d], sy: 1, rot: h.sign * LETTER_TILT[d] };
    };

    /* Where a point of the untouched element is now: its translate, rotate and scale applied around
       the pivot, in the order CSS applies them. Clawd leans with the surface it stands on, but only
       so far: past ~26° he holds on rather than tipping with it. */
    const warp = (h: Hurt, p: Pt): Pt => {
      const a = (h.pose.rot * Math.PI) / 180;
      const x = p.x - h.ox;
      const y = (p.y - h.oy) * h.pose.sy;
      return {
        ...p,
        x: h.ox + x * Math.cos(a) - y * Math.sin(a),
        y: h.oy + h.pose.dy + x * Math.sin(a) + y * Math.cos(a),
        r: Math.max(-26, Math.min(26, h.pose.rot)),
      };
    };

    const measure = (st: Stop) => {
      const hurt = hurts.get(st.el);
      if (hurt) {
        st.top = hurt.top;
        st.bottom = hurt.bottom;
        st.pts = hurt.pts.map((p) => warp(hurt, p));
        return;
      }
      const r = st.el.getBoundingClientRect();
      st.top = r.top + scrollY;
      st.bottom = r.bottom + scrollY;
      if (st.kind === 'box') {
        /* Nudged toward the line end so its arms clear the glyph before the dot. */
        st.pts = [{ x: r.left + r.width / 2 + scrollX + W() * .2 * (rtl ? -1 : 1), y: r.top + scrollY, s: 1 }];
      } else if (st.kind === 'mark') {
        const fs = parseFloat(getComputedStyle(st.el).fontSize);
        const s = Math.min(2.2, Math.max(.6, (fs * (W() < 50 ? .32 : .26)) / W()));
        st.pts = [...st.el.querySelectorAll<HTMLElement>('[data-letter]')].map((letter) => {
          const bent = hurts.get(letter);
          if (bent) return warp(bent, bent.pts[0]);
          const g = glyphs(letter)[0];
          const b = letter.getBoundingClientRect();
          return g
            ? { x: (g.l + g.r) / 2, y: g.top, s, el: letter }
            : { x: b.left + b.width / 2 + scrollX, y: b.top + scrollY, s, el: letter };
        });
      } else {
        st.pts = spots(glyphs(st.el), 1);
      }
      if (!st.pts.length) st.pts = [{ x: r.left + scrollX + W() / 2, y: r.top + scrollY, s: 1 }];
    };

    const stopOf = (el: HTMLElement, major: boolean): Stop => {
      const box = el.querySelector<HTMLElement>('[data-clawd-stop]');
      const st: Stop = { el: box ?? el, kind: box ? 'box' : 'text', major, top: 0, bottom: 0, pts: [] };
      measure(st);
      return st;
    };

    const shown = (el: HTMLElement) => el.getClientRects().length > 0 && !!el.textContent?.trim();

    /* Section headings first; where two of them are more than a screen apart, smaller headings
       in between (project names, timeline entries) fill the gap, so Clawd stays in sight. */
    const collect = () => {
      let list: Stop[] = [];
      if (tour) {
        const major = [...document.querySelectorAll<HTMLElement>('main :is(h1, h2)')].filter(shown).map((h) => stopOf(h, true));
        const minor = [...document.querySelectorAll<HTMLElement>('main h3')].filter(shown).map((h) => stopOf(h, false));
        const end = mark ? mark.getBoundingClientRect().top + scrollY : document.documentElement.scrollHeight;
        const gap = innerHeight * .75;
        list = [...major];
        major.forEach((st, i) => {
          const next = i + 1 < major.length ? major[i + 1].top : end;
          let last = st.top;
          minor
            .filter((m) => m.top > st.top && m.top < next - innerHeight * .4)
            .sort((a, b) => a.top - b.top)
            .forEach((m) => { if (m.top - last >= gap) { list.push(m); last = m.top; } });
        });
      }
      if (mark) {
        const st: Stop = { el: mark, kind: 'mark', major: true, top: 0, bottom: 0, pts: [] };
        measure(st);
        list.push(st);
      }
      list.sort((a, b) => a.top - b.top);
      stops = list;
    };

    /* The stop for the current scroll: the last one that has risen above 70% of the viewport;
       at the bottom of the page, the footer. */
    const pick = (): Stop | null => {
      if (!stops.length) return null;
      const doc = document.documentElement;
      const last = stops[stops.length - 1];
      if (scrollY + innerHeight >= doc.scrollHeight - 4) return last;
      if (last.kind === 'mark' && last.bottom <= scrollY + innerHeight) return last;
      if (scrollY < innerHeight * .15) return stops[0];
      const line = scrollY + innerHeight * .7;
      let best = stops[0];
      for (const st of stops) if (st.top <= line) best = st;
      return best;
    };

    const place = (p: Pt) => {
      pos = p;
      bot.style.transform = `translate3d(${p.x - W() / 2}px, ${p.y - H()}px, 0) scale(${p.s}) rotate(${p.r ?? 0}deg)`;
    };

    const squash = (k: number) => { body.style.transform = `scale(${1 + k * .18}, ${1 - k * .22})`; };

    const blink = () => {
      bot.setAttribute('data-blink', '');
      window.setTimeout(() => bot.removeAttribute('data-blink'), 140);
    };

    const linear = (t: number) => t;

    const flight = (a: Pt, b: Pt, peak: number, dur: number, ease = linear, crouch = true) => new Promise<void>((done) => {
      if (Math.abs(b.x - a.x) > 1) bot.toggleAttribute('data-flip', b.x < a.x);
      const t0 = performance.now();
      air = true;
      if (crouch) squash(1);
      const tick = (now: number) => {
        if (!alive) return done();
        const t = Math.min((now - t0) / dur, 1);
        if (t > .08) { bot.setAttribute('data-air', ''); squash(t < .2 ? -.6 : 0); }
        place({
          x: a.x + (b.x - a.x) * t,
          y: a.y + (b.y - a.y) * ease(t) - peak * 4 * t * (1 - t),
          s: a.s + (b.s - a.s) * t,
          /* Square to the surface at both ends, upright at the top of the arc. */
          r: ((a.r ?? 0) + ((b.r ?? 0) - (a.r ?? 0)) * t) * Math.abs(1 - 2 * t),
        });
        if (t < 1) { raf = requestAnimationFrame(tick); return; }
        air = false;
        bot.removeAttribute('data-air');
        squash(1);
        window.setTimeout(() => { squash(0); done(); }, 140);
      };
      raf = requestAnimationFrame(tick);
    });

    /* Pixel chips fly off where it lands: the critter is fixing the page. */
    const sparks = (p: Pt) => {
      const u = (W() / 13) * p.s;
      for (let k = 0; k < 5; k += 1) {
        const chip = document.createElement('i');
        chip.className = 'clawd-spark';
        chip.style.cssText = `left:${p.x - u / 2}px;top:${p.y - u}px;width:${u}px;height:${u}px`;
        layer.append(chip);
        const angle = Math.PI * (1 + (k + .5) / 5);
        const reach = u * (3.5 + Math.random() * 3);
        chip.animate(
          [
            { transform: 'translate(0, 0)', opacity: 1 },
            { transform: `translate(${Math.cos(angle) * reach}px, ${Math.sin(angle) * reach}px)`, opacity: 0 },
          ],
          { duration: 380 + k * 50, easing: 'cubic-bezier(.2,.7,.3,1)' },
        ).finished.finally(() => chip.remove());
      }
    };

    /* The wordmark is painted orange letter by letter; once all are orange it is painted back to ink, and again. */
    let painting = true;
    const paint = (mark: HTMLElement, letter: HTMLElement) => {
      letter.toggleAttribute('data-painted', painting);
      const letters = mark.querySelectorAll('[data-letter]');
      const done = mark.querySelectorAll('[data-letter][data-painted]').length;
      if (painting ? done === letters.length : done === 0) painting = !painting;
    };

    const stomp = (st: Stop, p: Pt, chips = false) => {
      const target = st.kind === 'mark' ? p.el : st.el;
      if (st.kind === 'mark' && target) {
        target.classList.remove('is-hit');
        void target.offsetWidth;
        target.classList.add('is-hit');
        paint(st.el, target);
      } else if (target && !hurts.has(target)) {
        /* A battered target already sits where it gave; this dip would snap it back for a moment. */
        target.animate([{ translate: '0 0' }, { translate: '0 .035em' }, { translate: '0 0' }], { duration: 260, easing: 'cubic-bezier(.2,.8,.2,1)' });
      }
      if (chips) sparks(p);
    };

    const wait = (ms: number) => new Promise<void>((done) => window.setTimeout(done, ms));
    const backOut = (t: number) => 1 + 2.70158 * (t - 1) ** 3 + 1.70158 * (t - 1) ** 2;

    const targetOf = (st: Stop, i: number) => (st.kind === 'mark' ? st.pts[i]?.el : st.el) ?? null;
    const basePt = (h: Hurt, i: number) => h.pts[h.kind === 'mark' ? 0 : Math.min(i, h.pts.length - 1)];
    const riding = (h: Hurt) => !air && !!cur && targetOf(cur, at) === h.el;

    const paintHurt = (h: Hurt) => {
      h.el.style.translate = `0 ${h.pose.dy}px`;
      h.el.style.rotate = `${h.pose.rot}deg`;
      h.el.style.scale = `1 ${h.pose.sy}`;
    };

    const dropHurt = (h: Hurt) => {
      h.job += 1;
      h.el.style.translate = '';
      h.el.style.rotate = '';
      h.el.style.scale = '';
      h.el.style.transformOrigin = '';
      hurts.delete(h.el);
    };

    const resetHurts = () => {
      hurts.forEach((h) => {
        h.el.getAnimations().forEach((a) => a.cancel());
        dropHurt(h);
      });
    };

    /* The first hop on a target records its untouched geometry and the pivot it will give around. */
    const hurtOf = (st: Stop, i: number): Hurt | null => {
      const el = targetOf(st, i);
      if (!el) return null;
      const known = hurts.get(el);
      if (known) return known;
      const r = el.getBoundingClientRect();
      const left = r.left + scrollX;
      const right = r.right + scrollX;
      const top = r.top + scrollY;
      const bottom = r.bottom + scrollY;
      const p = st.pts[i] ?? pos;
      const unit = st.kind === 'box' ? r.height : parseFloat(getComputedStyle(el).fontSize);
      /* The square hangs on the corner that touches the word. */
      let ox = rtl ? right : left;
      let oy = bottom;
      let sign = rtl ? -1 : 1;
      let lever = 1;
      if (st.kind === 'text') {
        /* Held at the far end of its first line, it tips down on Clawd's side. */
        const line = glyphs(el);
        const l = line.length ? Math.min(...line.map((g) => g.l)) : left;
        const e = line.length ? Math.max(...line.map((g) => g.r)) : right;
        const nearEnd = p.x - l > e - p.x;
        ox = nearEnd ? l : e;
        oy = line.length ? Math.max(...line.map((g) => g.b)) : bottom;
        sign = nearEnd ? 1 : -1;
        lever = Math.max(e - l, unit);
      } else if (st.kind === 'mark') {
        /* A letter leans to one side, on the bottom corner of that side. */
        sign = Math.random() < .5 ? -1 : 1;
        ox = sign > 0 ? right : left;
      }
      el.style.transformOrigin = `${ox - left}px ${oy - top}px`;
      const h: Hurt = {
        el,
        kind: st.kind,
        d: 0,
        pose: { dy: 0, sy: 1, rot: 0 },
        job: 0,
        ox,
        oy,
        top,
        bottom,
        unit,
        lever,
        sign,
        pts: (st.kind === 'mark' ? [p] : st.pts).map((q) => ({ ...q, r: 0 })),
      };
      hurts.set(el, h);
      return h;
    };

    /* Moves a target from one pose to another; Clawd, standing on it, moves with it. */
    const shift = (h: Hurt, to: Pose, dur: number, from: Pose = h.pose) => new Promise<void>((done) => {
      h.job += 1;
      const job = h.job;
      const t0 = performance.now();
      const step = (now: number) => {
        if (!alive || h.job !== job) return done();
        const t = Math.min((now - t0) / dur, 1);
        const k = backOut(t);
        h.pose = {
          dy: from.dy + (to.dy - from.dy) * k,
          sy: from.sy + (to.sy - from.sy) * k,
          rot: from.rot + (to.rot - from.rot) * k,
        };
        paintHurt(h);
        if (riding(h)) place(warp(h, basePt(h, at)));
        if (t < 1) requestAnimationFrame(step);
        else done();
      };
      step(t0);
    });

    /* The square gives way: it falls off the title, Clawd drops onto the baseline, then puts a new
       square in, which grows under its feet and lifts it back up. */
    const topple = async (h: Hurt) => {
      h.job += 1;
      const base = basePt(h, at);
      const fall = h.el.animate(
        [
          { translate: `0 ${h.pose.dy}px`, rotate: `${h.pose.rot}deg`, scale: `1 ${h.pose.sy}`, opacity: 1 },
          { translate: `${h.sign * h.unit * 2}px ${innerHeight * .6}px`, rotate: `${h.pose.rot + h.sign * 200}deg`, scale: `1 ${h.pose.sy}`, opacity: 0 },
        ],
        { duration: 900, easing: 'cubic-bezier(.45,0,.9,.5)', fill: 'forwards' },
      );
      bot.setAttribute('data-air', '');
      await wait(240);
      if (!alive) return;
      const ground = { x: base.x, y: h.oy, s: base.s, r: 0 };
      await flight(pos, ground, 0, 320, (t) => t * t, false);
      if (!alive) return;
      sparks(ground);
      await wait(650);
      if (!alive) return;
      h.d = 0;
      h.pose = { dy: 0, sy: 0, rot: 0 };
      paintHurt(h);
      fall.cancel();
      await shift(h, { dy: 0, sy: 1, rot: 0 }, 420);
      if (!alive) return;
      sparks(pos);
      dropHurt(h);
    };

    /* One hop's worth of damage: the target gives with a jolt and springs to its new pose. */
    const batter = async (st: Stop, p: Pt) => {
      const h = hurtOf(st, at);
      if (!h) return;
      h.d += 1;
      if (h.kind === 'box' && h.d > MAX) { await topple(h); return; }
      h.d = Math.min(h.d, MAX);
      const kick = h.d > 3 ? h.sign * 2 : 0;
      const jolt = h.kind === 'box'
        ? { ...h.pose, sy: h.pose.sy - .12, rot: h.pose.rot + kick }
        : h.kind === 'text'
          ? { ...h.pose, dy: h.pose.dy + h.unit * .03, rot: h.pose.rot + kick / 2 }
          : h.pose;
      void shift(h, poseOf(h), 320, jolt);
      if (st.kind === 'mark') stomp(st, p);
      sparks(pos);
    };

    /* Clawd mends what it broke, a step at a time, once the clicking stops. */
    const heal = async () => {
      if (!alive || !hurts.size) return;
      if (busy) { healTimer = window.setTimeout(heal, 400); return; }
      busy = true;
      try {
        await Promise.all([...hurts.values()].map(async (h) => {
          h.d = Math.min(h.d, MAX) - 1;
          await shift(h, poseOf(h), 480);
          if (h.d <= 0 && hurts.get(h.el) === h) dropHurt(h);
        }));
      } finally {
        free();
      }
      if (alive && hurts.size && !busy) healTimer = window.setTimeout(heal, 420);
    };

    /* Hops in place while clicks are queued: one high hop, or quick low ones while more are waiting. */
    const pound = async () => {
      if (busy || !cur || !alive) return;
      busy = true;
      window.clearTimeout(healTimer);
      try {
        while (pounds > 0 && alive && cur) {
          pounds -= 1;
          measure(cur);
          at = Math.min(at, cur.pts.length - 1);
          const p = cur.pts[at] ?? pos;
          const more = pounds > 0;
          await flight(p, p, H() * p.s * (more ? 1.2 : 2.2), more ? 420 : 700);
          if (alive) await batter(cur, p);
        }
      } finally {
        busy = false;
      }
      if (alive && hurts.size) healTimer = window.setTimeout(heal, 3000);
    };

    const free = () => {
      busy = false;
      if (pounds && alive) void pound();
    };

    const onScreen = (p: Pt) => p.y > scrollY - H() && p.y - H() * p.s < scrollY + innerHeight;

    const nearest = (st: Stop) => {
      let best = 0;
      st.pts.forEach((p, i) => { if (Math.abs(p.x - pos.x) < Math.abs(st.pts[best].x - pos.x)) best = i; });
      return best;
    };

    /* Travel to another stop. Off-screen ends are pulled to the viewport edge,
       so the jump is short and seen: it drops in from above or leaps out below. */
    const go = async (st: Stop) => {
      measure(st);
      const first = !cur;
      const idx = first ? 0 : nearest(st);
      const b = st.pts[idx];
      const top = scrollY;
      const bottom = scrollY + innerHeight;
      const side = (p: Pt) => (p.y < top ? -1 : p.y - H() * p.s > bottom ? 1 : 0);
      let a = { ...pos };
      if (first) {
        if (!tour || side(b)) { place(b); bot.setAttribute('data-ready', ''); cur = st; at = idx; return; }
        a = { ...b, y: top - 8 };
        place(a);
        bot.setAttribute('data-ready', '');
      }
      const sa = side(a);
      const sb = side(b);
      if (sa && sb) {
        place(b);
      } else {
        const edge = (p: Pt, s: number, toward: Pt) => ({ ...p, x: p.x + (toward.x - p.x) * .5, y: s < 0 ? top - 8 : bottom + H() * p.s + 8 });
        const a2 = sa ? edge(a, sa, b) : a;
        const b2 = sb ? edge(b, sb, a) : b;
        const dy = b2.y - a2.y;
        const dist = Math.hypot(b2.x - a2.x, dy);
        const long = Math.abs(dy) > innerHeight * .2;
        const ease = !long ? linear : dy > 0 ? (t: number) => t * t : (t: number) => 1 - (1 - t) ** 2;
        const peak = long ? H() * 1.4 : Math.min(H() * 3, Math.max(H() * .8, dist * .35));
        await flight(a2, b2, peak, Math.min(950, 380 + dist * .45), ease);
        if (sb) place(b);
      }
      cur = st;
      at = idx;
      if (!alive || sb) return;
      const fresh = !visited.has(st.el);
      visited.add(st.el);
      stomp(st, b, true);
      if (fresh && st.major && st.kind !== 'mark') {
        /* Two quick taps on a heading it has not visited yet. */
        for (let k = 0; k < 2 && alive; k += 1) {
          await flight(b, b, H() * .28, 190);
          stomp(st, b, true);
        }
      }
    };

    const patrol = async (st: Stop) => {
      measure(st);
      at = Math.min(at, st.pts.length - 1);
      let to = at;
      if (st.kind === 'mark' && letterTarget !== null && letterTarget !== at) {
        to = letterTarget;
        letterTarget = null;
      } else if (st.pts.length > 1) {
        if (at + dir < 0 || at + dir >= st.pts.length) dir = -dir;
        to = at + dir;
      } else if (Math.random() < .6) {
        return;
      }
      const a = st.pts[at];
      const b = st.pts[to];
      const dist = Math.abs(b.x - a.x);
      await flight(a, b, to === at ? H() * a.s * .5 : Math.max(H() * a.s * .6, dist * .3), 360 + dist * .6);
      at = to;
      if (alive) stomp(st, b);
    };

    const loop = async () => {
      if (!alive) return;
      window.clearTimeout(timer);
      if (!busy && !document.hidden) {
        busy = true;
        try {
          if (dirty) { dirty = false; resetHurts(); collect(); }
          const want = pick();
          if (want && want !== cur) await go(want);
          else if (cur && onScreen(pos)) await patrol(cur);
        } finally {
          free();
        }
      }
      if (!alive) return;
      if (Math.random() < .25) blink();
      timer = window.setTimeout(loop, pick() !== cur ? 40 : 700 + Math.random() * 900);
    };

    const settle = () => {
      if (busy || !cur) return;
      measure(cur);
      at = Math.min(at, cur.pts.length - 1);
      place(cur.pts[at]);
    };

    let frame = 0;
    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (busy) return;
        if (dirty) { dirty = false; resetHurts(); collect(); }
        if (pick() !== cur) loop();
      });
    };

    let resizeTimer = 0;
    const ro = new ResizeObserver(() => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (busy) { dirty = true; return; }
        resetHurts();
        collect();
        settle();
      }, 120);
    });

    const letters = mark ? [...mark.querySelectorAll<HTMLElement>('[data-letter]')] : [];
    const onLetter = (e: Event) => {
      const i = letters.indexOf(e.currentTarget as HTMLElement);
      if (i >= 0 && cur?.kind === 'mark') { letterTarget = i; if (!busy) loop(); }
    };
    /* Each click is one more hop in place; clicks that come while it is busy wait their turn. */
    const onClick = () => {
      if (!cur || still) return;
      pounds = Math.min(pounds + 1, 3);
      if (!busy) void pound();
    };

    const start = () => {
      if (!alive) return;
      collect();
      const first = pick();
      if (!first) return;
      if (still || !tour) {
        go(first);
      } else {
        busy = true;
        window.setTimeout(() => {
          go(first).finally(free);
        }, 700);
      }
      ro.observe(document.body);
      if (!still) {
        window.addEventListener('scroll', onScroll, { passive: true });
        letters.forEach((l) => l.addEventListener('pointerenter', onLetter));
        bot.addEventListener('click', onClick);
        timer = window.setTimeout(loop, 1600);
      }
    };

    if (document.fonts?.status === 'loaded') start();
    else document.fonts.ready.then(start);

    stopClawd = () => {
      alive = false;
      window.clearTimeout(timer);
      window.clearTimeout(healTimer);
      resetHurts();
      window.clearTimeout(resizeTimer);
      cancelAnimationFrame(raf);
      cancelAnimationFrame(frame);
      ro.disconnect();
      window.removeEventListener('scroll', onScroll);
      letters.forEach((l) => l.removeEventListener('pointerenter', onLetter));
      bot.removeEventListener('click', onClick);
    };
  };

  initClawd();
  document.addEventListener('astro:page-load', initClawd);
</script>
