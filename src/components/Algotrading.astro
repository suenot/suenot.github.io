---
import { defaultLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';
import { getPages } from '../i18n/pages';
import MoreLink from './MoreLink.astro';

interface Props {
  locale?: Locale;
  /** compact: the home page teaser that links to /algotrading; full: every case with its bullets. */
  variant?: 'compact' | 'full';
  /** Replaces the home page eyebrow ("02. algotrading") on the standalone page. */
  kicker?: string;
}
const { locale = defaultLocale, variant = 'compact', kicker } = Astro.props;
const t = getHome(locale).algotrading;
const teaser = getPages(locale).algoTeaser;
const prefix = locale === defaultLocale ? '' : `/${locale}`;

const sectionTags = [
  ['Python', 'Zig', 'Optuna'],
  ['Rust', 'Zig', 'gRPC'],
  ['Golang', 'Rust', 'C++'],
  ['Go', 'Python', 'Next.js'],
  ['Python', 'SciPy', 'Math'],
];
---

<section id={variant === 'compact' ? 'algotrading' : 'engineering'} class:list={['trading terminal-section', `trading--${variant}`]} aria-labelledby="trading-heading">
  <div class="terminal-container">
    <header class="trading__header">
      <div>
        <p class="terminal-kicker">{kicker ?? t.eyebrow}</p>
        <h2 id="trading-heading" class="terminal-heading">{t.heading}</h2>
      </div>
      <p data-reveal>{t.intro}</p>
      <div class="trading__signal" aria-hidden="true" data-reveal>
        <span>LATENCY ENVELOPE</span>
        <svg viewBox="0 0 240 55" preserveAspectRatio="none" data-wipe>
          <path d="M0 38L14 36L28 39L42 29L56 34L70 12L84 36L98 30L112 35L126 26L140 31L154 18L168 34L182 32L196 22L210 36L224 29L240 33" />
        </svg>
      </div>
    </header>

    {variant === 'compact' && (
      <ol class="trading__grid">
        {t.sections.map((section, index) => (
          <li class="tcell" data-reveal>
            <span class="case__number">0{index + 1}</span>
            <p class="tcell__subtitle">{section.subtitle}</p>
            <h3 class="tcell__title display-type">{section.title}</h3>
            <div class="tcell__tags">
              {(sectionTags[index] ?? []).map((tag) => <span>[ {tag} ]</span>)}
            </div>
          </li>
        ))}
      </ol>
    )}
    {variant === 'compact' && (
      <div class="trading__more">
        <MoreLink locale={locale} href={`${prefix}/algotrading/`} label={teaser.more} note={teaser.note} />
      </div>
    )}

    {variant === 'full' && <ol class="trading__cases">
      {t.sections.map((section, index) => (
        <li class="trading__case">
          <header class="case__header" data-reveal>
            <span class="case__number">0{index + 1}</span>
            <p class="case__subtitle">{section.subtitle}</p>
            <h3 class="display-type">{section.title}</h3>
            <div class="case__tags">
              {(sectionTags[index] ?? []).map((tag) => <span>[ {tag} ]</span>)}
            </div>
          </header>

          <div class="case__body">
            <div class="case__meta" aria-hidden="true" data-reveal>
              <span>UNIT / HFT-{String(index + 1).padStart(2, '0')}</span>
              <span>MODE / PRODUCTION</span>
            </div>
            <ul>
              {section.bullets.map((bullet, bulletIndex) => (
                <li data-reveal>
                  <span>{String(bulletIndex + 1).padStart(2, '0')}</span>
                  <p set:html={bullet} />
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>}
  </div>
</section>

<style>
  .trading { border-block-end: 1px solid var(--terminal-line, #303431); }
  .trading__header { display: grid; grid-template-columns: 1.15fr .7fr .45fr; gap: clamp(2rem, 5vw, 6rem); align-items: end; padding: clamp(3.5rem, 7vw, 7rem) clamp(1rem, 3.5vw, 3.75rem); border-block-end: 1px solid var(--terminal-line, #303431); }
  .trading__header .terminal-heading { max-inline-size: 12ch; margin-block-start: 1.2rem; font-size: clamp(3.5rem, 6vw, 7rem); line-height: .86; }
  .trading__header > p { max-inline-size: 48ch; color: var(--terminal-muted, #8b908c); font: 1rem/1.65 var(--font-sans); text-wrap: pretty; }
  .trading__signal { color: var(--terminal-muted, #747a75); font: .75rem/1 var(--font-mono); letter-spacing: .12em; }
  .trading__signal svg { display: block; inline-size: 100%; block-size: 3.5rem; margin-block-start: .8rem; border-block: 1px solid var(--terminal-line, #303431); }
  .trading__signal path { fill: none; stroke: var(--terminal-muted, #747a75); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .trading__cases { counter-reset: cases; }
  .trading__case { display: grid; grid-template-columns: minmax(17rem, .72fr) minmax(0, 1.28fr); border-block-end: 1px solid var(--terminal-line, #303431); }
  .trading__case:nth-child(even) .case__header { grid-column: 2; border-inline-end: 0; border-inline-start: 1px solid var(--terminal-line, #303431); }
  .trading__case:nth-child(even) .case__body { grid-column: 1; grid-row: 1; }
  .case__header { position: relative; min-block-size: 22rem; padding: 2rem clamp(1rem, 3vw, 3rem); border-inline-end: 1px solid var(--terminal-line, #303431); }
  .case__number { display: block; color: var(--terminal-accent); font: 1rem/1 var(--font-sans); }
  .case__subtitle { margin-block-start: 3.5rem; color: var(--terminal-muted, #8b908c); font: .75rem/1 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; }
  .case__header h3 { max-inline-size: 12ch; margin-block-start: .65rem; color: var(--terminal-fg, #e7e9e3); font-size: clamp(2.1rem, 3.6vw, 4rem); font-weight: 800; letter-spacing: -.045em; line-height: .95; text-wrap: balance; }
  .case__tags { position: absolute; inset-block-end: 2rem; inset-inline: clamp(1rem, 3vw, 3rem); display: flex; flex-wrap: wrap; gap: .75rem; color: var(--terminal-muted, #747a75); font: .75rem/1 var(--font-mono); letter-spacing: .06em; }
  .case__body { align-self: stretch; padding: 2rem clamp(1rem, 4vw, 4.5rem); }
  .case__meta { display: flex; justify-content: space-between; gap: 1rem; padding-block-end: 1rem; color: var(--terminal-muted, #666b67); font: .75rem/1 var(--font-mono); letter-spacing: .1em; border-block-end: 1px solid var(--terminal-line, #303431); }
  .case__body > ul > li { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; padding-block: 1.25rem; border-block-end: 1px solid var(--terminal-line, #303431); }
  .case__body li > span { color: var(--terminal-accent); font: .75rem/1.55 var(--font-mono); }
  .case__body li p { max-inline-size: 85ch; color: var(--terminal-muted, #969b97); font-size: 1rem; line-height: 1.65; }
  .case__body li :global(strong) { color: var(--terminal-fg, #e7e9e3); font-weight: 600; }
  .trading__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .tcell { display: flex; flex-direction: column; min-block-size: 19rem; padding: 2rem clamp(1rem, 2vw, 2rem); border-inline-end: 1px solid var(--terminal-line, #303431); }
  .tcell:last-child { border-inline-end: 0; }
  .tcell__subtitle { margin-block-start: 2.75rem; color: var(--terminal-muted, #8b908c); font: .75rem/1.3 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; }
  .tcell__title { margin-block-start: .65rem; color: var(--terminal-fg, #e7e9e3); font-size: clamp(1.5rem, 2.1vw, 2.25rem); font-weight: 800; letter-spacing: -.04em; line-height: 1; text-wrap: balance; }
  .tcell__tags { display: flex; flex-wrap: wrap; gap: .5rem .75rem; margin-block-start: auto; padding-block-start: 2rem; color: var(--terminal-muted, #747a75); font: .75rem/1 var(--font-mono); letter-spacing: .06em; }
  .trading__more { padding: 0 clamp(1rem, 3.5vw, 3.75rem) clamp(3rem, 6vw, 5rem); border-block-start: 1px solid var(--terminal-line, #303431); }
  @media (max-width: 1100px) {
    .trading__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tcell { min-block-size: 15rem; border-block-end: 1px solid var(--terminal-line, #303431); }
    .tcell:nth-child(even) { border-inline-end: 0; }
    .tcell:last-child { grid-column: 1 / -1; border-block-end: 0; }
  }
  @media (max-width: 900px) {
    .trading__header { grid-template-columns: 1fr 1fr; }
    .trading__signal { display: none; }
    .trading__case { grid-template-columns: minmax(14rem, .7fr) 1.3fr; }
  }
  @media (max-width: 680px) {
    .trading__header { grid-template-columns: 1fr; }
    .trading__grid { grid-template-columns: 1fr; }
    .tcell { min-block-size: 0; border-inline-end: 0; }
    .tcell__subtitle { margin-block-start: 1.5rem; }
    .trading__case { display: block; }
    .trading__case:nth-child(even) .case__header { border-inline-start: 0; }
    .case__header { min-block-size: 17rem; border-inline-end: 0; border-block-end: 1px solid var(--terminal-line, #303431); }
    .case__subtitle { margin-block-start: 2rem; }
    .case__tags { inset-block-end: 1.5rem; }
    .case__body { padding-block-end: 3rem; }
  }
</style>
