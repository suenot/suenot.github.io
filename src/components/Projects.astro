---

<section id="projects" class="projects terminal-section" aria-labelledby="projects-heading">
  <div class="terminal-container">
    <header class="projects__header">
      <div>
        <p class="terminal-kicker">{t.eyebrow} / COMPLETE ARCHIVE</p>
        <h2 id="projects-heading" class="terminal-heading">{t.heading}</h2>
      </div>
      <p>{t.intro}</p>
      <dl aria-label="Archive summary">
        <div><dt>GROUPS</dt><dd>{projects.length.toString().padStart(2, '0')}</dd></div>
        <div><dt>RECORDS</dt><dd>{projects.reduce((sum, group) => sum + group.items.length, 0)}</dd></div>
      </dl>
    </header>

    <div class="projects__archive">
      {projects.map((group, groupIndex) => (
        <section class="project-group">
          <header class="project-group__header">
            <span>{String(groupIndex + 1).padStart(2, '0')}</span>
            <h3 class="display-type">{t.categories[group.category]}</h3>
            <span>{String(group.items.length).padStart(2, '0')} RECORDS</span>
          </header>
          <div class="project-group__columns" aria-hidden="true">
            <span>ID / PROJECT</span><span>DESCRIPTION</span><span>STACK</span><span>STATE</span>
          </div>
          <ol>
            {group.items.map((project, projectIndex) => (
              <li>
                <a href={project.url} target="_blank" rel="noopener noreferrer">
                  <div class="project-row__name">
                    <span class="project-row__id">{String(groupIndex + 1).padStart(2, '0')}.{String(projectIndex + 1).padStart(2, '0')}</span>
                    <h4>{project.name}</h4>
                    <span class="project-row__access" title={project.private ? 'Private repository' : 'Public link'}>{project.private ? 'LOCK' : 'OPEN'}</span>
                  </div>
                  <p>{t.descs[project.descKey]}</p>
                  <div class="project-row__tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
                  <span class:list={["project-row__status", statusStyles[project.status]]}>{t.status[project.status]}</span>
                  <span class="project-row__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .projects { border-block-end: 1px solid var(--terminal-line, #303431); }
  .projects__header { display: grid; grid-template-columns: 1fr .55fr auto; gap: clamp(2rem, 5vw, 6rem); align-items: end; padding: clamp(3.5rem, 7vw, 7rem) clamp(1rem, 3.5vw, 3.75rem); border-block-end: 1px solid var(--terminal-line, #303431); }
  .projects__header .terminal-heading { max-inline-size: 11ch; margin-block-start: 1.25rem; font-size: clamp(3.5rem, 6.6vw, 7.6rem); line-height: .84; }
  .projects__header > p { max-inline-size: 48ch; color: var(--terminal-muted, #8b908c); font: .75rem/1.65 var(--font-mono, monospace); }
  .projects__header dl { display: flex; gap: 1.6rem; }
  .projects__header dl div { display: grid; gap: .5rem; }
  .projects__header dt { color: var(--terminal-muted, #747a75); font: .52rem/1 var(--font-mono, monospace); letter-spacing: .1em; }
  .projects__header dd { color: var(--terminal-fg, #e7e9e3); font: 600 1.65rem/1 var(--font-mono, monospace); font-variant-numeric: tabular-nums; }
  .project-group__header { display: grid; grid-template-columns: 3rem 1fr auto; gap: 1rem; align-items: center; min-block-size: 5.6rem; padding: 1rem clamp(1rem, 3.5vw, 3.75rem); border-block-end: 1px solid var(--terminal-line, #303431); }
  .project-group__header > span { color: #ff3b30; font: .6rem/1 var(--font-mono, monospace); letter-spacing: .1em; }
  .project-group__header > span:last-child { color: var(--terminal-muted, #747a75); }
  .project-group__header h3 { color: var(--terminal-fg, #e7e9e3); font-size: clamp(1.6rem, 2.8vw, 3rem); font-weight: 750; letter-spacing: -.04em; line-height: 1; text-transform: uppercase; }
  .project-group__columns, .project-group a { display: grid; grid-template-columns: minmax(13rem, .8fr) minmax(22rem, 1.2fr) minmax(12rem, .7fr) 5rem 1rem; gap: 1.2rem; }
  .project-group__columns { padding: .7rem clamp(1rem, 3.5vw, 3.75rem); border-block-end: 1px solid var(--terminal-line, #303431); color: #5d625e; font: .5rem/1 var(--font-mono, monospace); letter-spacing: .1em; }
  .project-group li { border-block-end: 1px solid var(--terminal-line, #303431); }
  .project-group a { align-items: start; padding: 1rem clamp(1rem, 3.5vw, 3.75rem); color: inherit; text-decoration: none; }
  .project-row__name { display: grid; grid-template-columns: 2.3rem 1fr auto; gap: .7rem; align-items: start; min-width: 0; }
  .project-row__id, .project-row__access { color: #5d625e; font: .5rem/1.5 var(--font-mono, monospace); }
  .project-row__name h4 { color: var(--terminal-fg, #e7e9e3); font: 600 .72rem/1.35 var(--font-mono, monospace); overflow-wrap: anywhere; }
  .project-group a > p { color: var(--terminal-muted, #8b908c); font-size: .72rem; line-height: 1.5; text-wrap: pretty; }
  .project-row__tags { display: flex; flex-wrap: wrap; gap: .35rem .75rem; color: var(--terminal-muted, #747a75); font: .52rem/1.35 var(--font-mono, monospace); }
  .project-row__tags span::before { content: "["; margin-inline-end: .2rem; }.project-row__tags span::after { content: "]"; margin-inline-start: .2rem; }
  .project-row__status { display: inline-flex; align-items: center; gap: .45rem; color: var(--terminal-muted, #747a75); font: .52rem/1.3 var(--font-mono, monospace); letter-spacing: .07em; text-transform: uppercase; }
  .project-row__status::before { content: ""; inline-size: .3rem; block-size: .3rem; border: 1px solid currentColor; }
  .status--active::before { border: 0; background: #4af626; }.status--wip { color: #ff3b30; }.status--rip { opacity: .55; }
  .project-row__arrow { color: #ff3b30; font: .8rem/1 var(--font-mono, monospace); opacity: 0; }
  .project-group a:hover, .project-group a:focus-visible { background: #151816; }
  .project-group a:hover .project-row__arrow, .project-group a:focus-visible .project-row__arrow { opacity: 1; }
  .project-group a:focus-visible { outline: 2px solid #ff3b30; outline-offset: -3px; }
  @media (max-width: 1050px) {
    .project-group__columns { display: none; }
    .project-group a { grid-template-columns: minmax(12rem, .8fr) 1.2fr 5rem 1rem; }
    .project-row__tags { grid-column: 2; }
    .project-row__status { grid-column: 3; grid-row: 1; }
  }
  @media (max-width: 760px) {
    .projects__header { grid-template-columns: 1fr; }
    .project-group a { grid-template-columns: 1fr auto; gap: .8rem 1rem; }
    .project-row__name { grid-column: 1; }
    .project-group a > p { grid-column: 1 / -1; }
    .project-row__tags { grid-column: 1; }
    .project-row__status { grid-column: 2; grid-row: 1; }
    .project-row__arrow { grid-column: 2; grid-row: 3; align-self: end; opacity: 1; }
  }
</style>
