---
import { defaultLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';
import { useTranslations } from '../i18n/ui';
import { formatYears } from '../i18n/utils';
import { projects, roleOf, iconOf, hueOf, monogram, type ProjectGroup, type StatusKey } from '../data/projects';

interface Props {
  locale?: Locale;
  /** Defaults to the whole archive. */
  groups?: ProjectGroup[];
  /** Off on the pages, where the page hero already says what this is. */
  showHeader?: boolean;
  showRoles?: boolean;
  id?: string;
}
const { locale = defaultLocale, groups = projects, showHeader = true, showRoles = true, id = 'archive' } = Astro.props;
const t = getHome(locale).projects;
const ui = useTranslations(locale);
// Without the section header the groups are the top level under the page h1.
const GroupHeading = showHeader ? 'h3' : 'h2';
const NameHeading = showHeader ? 'h4' : 'h3';

const allItems = groups.flatMap((group) => group.items);
const roleCounts = {
  founder: allItems.filter((project) => roleOf(project) === 'founder').length,
  hired: allItems.filter((project) => roleOf(project) === 'hired').length,
  partner: allItems.filter((project) => roleOf(project) === 'partner').length,
};
const roleKeys = ['founder', 'hired', 'partner'] as const;

const statusStyles: Record<StatusKey, string> = {
  active: 'status--active',
  wip: 'status--wip',
  concept: 'status--concept',
  paused: 'status--paused',
  left: 'status--left',
  rip: 'status--rip',
};
---

<section id={id} class:list={["projects terminal-section", !showHeader && "projects--bare"]} aria-labelledby={showHeader ? `${id}-heading` : undefined}>
  <div class="terminal-container">
    {showHeader && <header class="projects__header">
      <div>
        <p class="terminal-kicker">{t.eyebrow}</p>
        <h2 id={`${id}-heading`} class="terminal-heading">{t.heading}</h2>
      </div>
      <p data-reveal>{t.intro}</p>
      <dl aria-label="Archive summary" data-reveal>
        <div><dt>GROUPS</dt><dd data-count>{groups.length.toString().padStart(2, '0')}</dd></div>
        <div><dt>RECORDS</dt><dd data-count>{allItems.length}</dd></div>
      </dl>
    </header>}

    {showRoles && <ul class="projects__roles" aria-label="Role legend" data-reveal>
      {roleKeys.map((role) => (
        <li class={`role role--${role}`}><span class="role__mark" aria-hidden="true"></span>{t.roles[role]}<span class="role__count">{String(roleCounts[role]).padStart(2, '0')}</span></li>
      ))}
    </ul>}

    <div class="projects__archive">
      {groups.map((group, groupIndex) => (
        <section class="project-group">
          <header class="project-group__header" data-reveal>
            <span>{String(groupIndex + 1).padStart(2, '0')}</span>
            <GroupHeading class="project-group__title display-type">{t.categories[group.category]}</GroupHeading>
            <span>{String(group.items.length).padStart(2, '0')}</span>
          </header>
          <ol>
            {group.items.map((project, projectIndex) => {
              const Row = project.url ? 'a' : 'div';
              return (
              <li data-reveal>
                <Row class={`project-row project-row--${roleOf(project)}`} data-role={roleOf(project)} {...(project.url ? { href: project.url, target: "_blank", rel: "noopener noreferrer" } : {})}>
                  <span class="project-row__id">{String(projectIndex + 1).padStart(2, '0')}</span>
                  <div class="project-row__main">
                    <div class="project-row__name">
                      {iconOf(project)
                        ? <img class="project-row__avatar" src={iconOf(project)} alt="" width="40" height="40" loading="lazy" decoding="async" />
                        : <span class="project-row__avatar project-row__avatar--mono" style={`--hue:${hueOf(project.name)}`} aria-hidden="true">{monogram(project.name)}</span>}
                      <NameHeading class="project-row__title">{project.name}</NameHeading>
                      {project.private && <span class="project-row__access" title="Private repository">Private</span>}
                    </div>
                    <p>{t.descs[project.descKey]}</p>
                  </div>
                  <div class="project-row__tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
                  <div class="project-row__state">
                    <span class={`role role--${roleOf(project)}`}><span class="role__mark" aria-hidden="true"></span>{project.title ?? t.roles[roleOf(project)]}</span>
                    <span class:list={["project-row__status", statusStyles[project.status]]}>{t.status[project.status]}</span>
                    {project.years && <bdi class="project-row__years" data-years>{formatYears(project.years, ui('projects.present'))}</bdi>}
                  </div>
                  {project.url && <span class="project-row__arrow" aria-hidden="true">↗</span>}
                </Row>
              </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .projects { padding-block: clamp(4rem, 8vw, 7rem); }
  .projects--bare { padding-block-start: 0; }
  .projects--bare .project-group:first-of-type { margin-block-start: clamp(1.5rem, 3vw, 2.5rem); }
  .projects__header { display: grid; grid-template-columns: 1fr minmax(0, .8fr) auto; gap: clamp(2rem, 5vw, 5rem); align-items: end; padding-block-end: clamp(2rem, 4vw, 3rem); }
  .projects__header .terminal-heading { margin-block-start: 1rem; }
  .projects__header > p { max-inline-size: 46ch; margin: 0; color: var(--terminal-muted); font-size: var(--text-base); line-height: 1.6; }
  .projects__header dl { display: flex; gap: 2rem; margin: 0; }
  .projects__header dl div { display: grid; gap: .35rem; }
  .projects__header dt { color: var(--terminal-muted); font: .75rem/1 var(--font-mono); letter-spacing: .1em; }
  .projects__header dd { margin: 0; color: var(--terminal-ink); font: 800 2.25rem/1 var(--font-sans); letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
  .projects__roles { display: flex; flex-wrap: wrap; gap: .6rem 1.8rem; margin: 0; padding: 1rem 0; list-style: none; border-block: 1px solid var(--terminal-line); }
  .project-group { margin-block-start: clamp(2.5rem, 5vw, 4rem); }
  .project-group__header { display: flex; align-items: baseline; gap: 1rem; padding-block-end: 1rem; border-block-end: 1px solid var(--terminal-line-strong); }
  .project-group__header > span { color: var(--terminal-accent); font: .75rem/1 var(--font-mono); letter-spacing: .1em; }
  .project-group__header > span:last-child { margin-inline-start: auto; color: var(--terminal-muted); }
  .project-group__title { margin: 0; color: var(--terminal-ink); font-size: var(--text-h3); font-weight: 800; letter-spacing: -.035em; line-height: 1.1; }
  .project-group ol { margin: 0; padding: 0; list-style: none; }
  .project-group li { border-block-end: 1px solid var(--terminal-line); }
  .project-row { position: relative; display: grid; grid-template-columns: 2.25rem minmax(0, 1.6fr) minmax(0, .75fr) 8rem 1.25rem; gap: 1.5rem; align-items: start; padding: 1.5rem .75rem; color: inherit; text-decoration: none; transition: background-color 160ms ease; }
  .project-row__id { padding-block-start: .7rem; color: var(--terminal-dim); font: .75rem/1 var(--font-mono); letter-spacing: .06em; font-variant-numeric: tabular-nums; }
  .project-row__main { min-width: 0; }
  .project-row__name { display: flex; align-items: center; gap: .85rem; min-width: 0; }
  .project-row__avatar { flex: none; inline-size: 2.5rem; block-size: 2.5rem; border-radius: .6rem; object-fit: contain; background: var(--terminal-panel); box-shadow: inset 0 0 0 1px var(--terminal-line); }
  img.project-row__avatar { padding: .3rem; }
  .project-row__avatar--mono { display: grid; place-items: center; background: oklch(.56 .11 var(--hue)); color: #fff; font: 800 .9375rem/1 var(--font-sans); letter-spacing: -.02em; box-shadow: none; }
  .project-row__title { margin: 0; color: var(--terminal-ink); font: 800 clamp(1.25rem, 1.9vw, 1.625rem)/1.15 var(--font-sans); letter-spacing: -.03em; overflow-wrap: anywhere; }
  .project-row__access { padding: .2rem .45rem; border: 1px solid var(--terminal-line-strong); color: var(--terminal-muted); font: .6875rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .project-row__main > p { max-inline-size: 60ch; margin: .65rem 0 0 3.35rem; color: var(--terminal-ink-2); font-size: var(--text-base); line-height: 1.55; text-wrap: pretty; }
  .project-row__tags { display: flex; flex-wrap: wrap; gap: .35rem .9rem; padding-block-start: .65rem; color: var(--terminal-muted); font: .75rem/1.4 var(--font-mono); letter-spacing: .02em; }
  .project-row__state { display: grid; gap: .4rem; justify-items: start; padding-block-start: .6rem; }
  .project-row__years { color: var(--terminal-muted); font: .75rem/1.3 var(--font-mono); font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  .project-row__status { display: inline-flex; align-items: center; gap: .45rem; color: var(--terminal-muted); font: .75rem/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .project-row__status::before { content: ""; inline-size: .4rem; block-size: .4rem; border-radius: 50%; border: 1px solid currentColor; }
  .status--active { color: var(--terminal-ink); }
  .status--active::before { border: 0; background: var(--terminal-signal); }.status--wip { color: var(--terminal-accent); }.status--rip { color: var(--terminal-dim); }
  .role { display: inline-flex; align-items: center; gap: .45rem; color: var(--terminal-muted); font: .75rem/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .role__mark { inline-size: .5rem; block-size: .5rem; border: 1px solid currentColor; }
  .role--founder { color: var(--terminal-accent); }
  .role--founder .role__mark { background: currentColor; }
  .role--partner .role__mark { background: linear-gradient(90deg, currentColor 50%, transparent 50%); }
  .role__count { color: var(--terminal-dim); }
  .project-row__arrow { padding-block-start: .55rem; color: var(--terminal-accent); font: 1.125rem/1 var(--font-sans); opacity: .35; transition: opacity 160ms ease; }
  .project-group a:hover, .project-group a:focus-visible { background: var(--terminal-panel); }
  .project-group a:hover .project-row__arrow, .project-group a:focus-visible .project-row__arrow { opacity: 1; }
  .project-group a:focus-visible { outline: 2px solid var(--terminal-accent); outline-offset: -2px; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-row__title, .project-row__arrow { transition: transform 220ms var(--ease-out), opacity 160ms ease; }
    .project-group a:hover .project-row__title { transform: translate3d(calc(var(--dir, 1) * .25rem), 0, 0); }
    .project-group a:hover .project-row__arrow { transform: translate3d(.15rem, -.15rem, 0); }
  }
  @media (max-width: 1050px) {
    .projects__header { grid-template-columns: 1fr; align-items: start; }
    .project-row { grid-template-columns: 2rem minmax(0, 1fr) 7.5rem 1.25rem; }
    .project-row__tags { grid-column: 2; grid-row: 2; padding-block-start: 0; padding-inline-start: 3.35rem; }
    .project-row__state { grid-column: 3; grid-row: 1; }
    .project-row__arrow { grid-column: 4; grid-row: 1; }
  }
  @media (max-width: 760px) {
    .project-row { grid-template-columns: minmax(0, 1fr) auto; gap: .75rem 1rem; padding-inline: 0; }
    .project-row__id { display: none; }
    .project-row__main { grid-column: 1 / -1; }
    .project-row__main > p { margin-inline-start: 0; }
    .project-row__tags { grid-column: 1; grid-row: 2; padding-inline-start: 0; }
    .project-row__state { grid-column: 1; grid-row: 3; display: flex; flex-wrap: wrap; gap: .5rem 1rem; padding-block-start: 0; }
    .project-row__arrow { grid-column: 2; grid-row: 3; opacity: 1; }
  }
</style>
