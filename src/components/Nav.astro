---
import LanguageSelector from './LanguageSelector.astro';
import ThemeToggle from './ThemeToggle.astro';
import CvMenu from './CvMenu.astro';
import { type Locale, defaultLocale, locales } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale?: Locale;
  availableLocales?: readonly Locale[];
}

const { locale = defaultLocale, availableLocales = locales } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === defaultLocale ? '' : `/${locale}`;
const pathname = Astro.url.pathname;

const links = [
  { code: '01', href: `${prefix}/#about`, label: t('nav.about'), key: 'about' },
  { code: '02', href: `${prefix}/#algotrading`, label: t('nav.algotrading'), key: 'trading' },
  { code: '03', href: `${prefix}/#projects`, label: t('nav.projects'), key: 'projects' },
  { code: '04', href: `${prefix}/production/`, label: t('nav.production'), key: 'production' },
  { code: '05', href: `${prefix}/blog/`, label: t('nav.blog'), key: 'blog' },
  { code: '06', href: `${prefix}/#contact`, label: t('nav.contact'), key: 'contact' },
];
---

<nav class="site-nav" aria-label="Primary navigation">
  <div class="nav-shell">
    <a class="nav-identity" href={`${prefix}/`} aria-label="Eugen Soloviov — home">
      <span class="nav-identity__mark" aria-hidden="true"></span>
      <span>Eugen Soloviov</span>
    </a>

    <ul class="nav-index" role="list" data-nav-index>
      {links.map((link) => {
        const isCurrent = (link.key === 'blog' && pathname.includes('/blog')) || (link.key === 'production' && pathname.includes('/production'));
        return (
          <li>
            <a href={link.href} aria-current={isCurrent ? 'page' : undefined}>
              <span>{link.code}</span>
              <span>{link.label}</span>
            </a>
          </li>
        );
      })}
      <li class="nav-index__cursor-track" aria-hidden="true"><span class="nav-index__cursor" data-nav-cursor></span></li>
    </ul>

    <div class="nav-actions">
      <div class="nav-cv"><CvMenu locale={locale} /></div>
      <LanguageSelector currentLocale={locale} availableLocales={availableLocales} />
      <ThemeToggle locale={locale} />
      <button
        id="mobile-menu-toggle"
        class="nav-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span aria-hidden="true">Menu</span>
      </button>
    </div>
  </div>

  <span class="nav-depth" data-readout-bar aria-hidden="true"></span>

  <div id="mobile-menu" class="mobile-menu" aria-hidden="true" inert>
    <div class="mobile-menu-meta">
      <span>Navigation</span>
      <span>suenot.com</span>
    </div>
    <ul role="list">
      {links.map((link) => (
        <li>
          <a href={link.href} data-mobile-nav-link>
            <span>{link.code}</span>
            <span>{link.label}</span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
    <CvMenu locale={locale} variant="list" />
    <ThemeToggle locale={locale} variant="menu" />
    <a class="mobile-github" href="https://github.com/suenot" target="_blank" rel="noopener noreferrer">
      GitHub ↗
    </a>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    z-index: 60;
    inset-block-start: 0;
    inset-inline: 0;
    height: var(--terminal-header);
    border-block-end: 1px solid var(--terminal-line);
    background: rgb(var(--bg-rgb) / 0.96);
  }

  .nav-shell {
    display: grid;
    width: min(100%, var(--terminal-max));
    height: 100%;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
  }

  .nav-identity,
  .nav-actions,
  .nav-index a {
    display: flex;
    align-items: center;
    min-width: 0;
    color: var(--terminal-muted);
    font-size: .75rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase; font-family: var(--font-mono);
  }

  .nav-identity {
    gap: 0.6rem;
    color: var(--terminal-ink);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    text-transform: none;
    white-space: nowrap;
  }

  .nav-identity__mark {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    background: var(--terminal-accent);
  }

  .nav-index {
    display: flex;
    justify-content: center;
    gap: clamp(0.75rem, 1.8vw, 1.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-index li {
    min-width: 0;
  }

  .nav-index a {
    height: 100%;
    justify-content: center;
    gap: 0.45rem;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .nav-index a span:first-child {
    color: var(--terminal-dim);
  }

  .nav-index a:hover,
  .nav-index a[aria-current='page'] {
    color: var(--terminal-ink);
  }

  .nav-index a[aria-current='page'] span:first-child {
    color: var(--terminal-accent);
  }

  /* Section in view (set by hud-readout.ts). */
  .nav-index a[data-active] {
    color: var(--terminal-ink);
  }

  .nav-index a[data-active] span:first-child {
    color: var(--terminal-accent);
  }

  .nav-index {
    position: relative;
  }

  .nav-index li.nav-index__cursor-track {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    height: 2px;
    border: 0;
    pointer-events: none;
  }

  .nav-index__cursor {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 100%;
    background: var(--terminal-accent);
    opacity: 0;
    transform-origin: 0 0;
    transition: transform 420ms var(--ease-in-out), opacity 200ms ease;
  }

  .nav-index__cursor[data-visible] {
    opacity: 1;
  }

  /* Depth hairline along the top edge of the bar. */
  .nav-depth {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 1px;
    background: var(--terminal-accent);
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  :global([dir='rtl']) .nav-depth {
    transform-origin: right center;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-index__cursor {
      transition: none;
    }
  }

  .nav-actions {
    gap: 0.75rem;
  }

  .nav-toggle {
    display: none;
    min-height: 2.5rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--terminal-line-strong);
    border-radius: 0;
    background: transparent;
    color: var(--terminal-ink);
    font-size: .75rem;
    letter-spacing: 0.08em;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 68rem) {
    .nav-shell {
      grid-template-columns: 1fr auto;
    }

    .nav-index {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
      align-items: center;
    }

    .mobile-menu {
      position: fixed;
      inset-block-start: var(--terminal-header);
      inset-inline: 0;
      bottom: 0;
      z-index: 59;
      overflow-y: auto;
      background: var(--terminal-bg);
    }

    .mobile-menu[data-open='true'] {
      display: block;
    }

    .mobile-menu-meta {
      display: flex;
      justify-content: space-between;
      padding: 1rem;
      border-block-end: 1px solid var(--terminal-line);
      color: var(--terminal-dim);
      font-size: .75rem;
      letter-spacing: 0.12em;
    }

    .mobile-menu ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .mobile-menu li {
      border-block-end: 1px solid var(--terminal-line);
    }

    .mobile-menu li a {
      display: grid;
      min-height: 4.75rem;
      align-items: center;
      padding-inline: 1rem;
      grid-template-columns: 3rem 1fr auto;
      color: var(--terminal-ink);
      font-family: var(--font-sans);
      font-size: clamp(1.75rem, 7vw, 3rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      text-decoration: none;
    }

    .mobile-menu li a span:first-child,
    .mobile-menu li a span:last-child {
      color: var(--terminal-accent);
      font-family: var(--font-mono);
      font-weight: 500;
      font-size: .875rem;
      letter-spacing: 0.08em;
    }

    .mobile-github {
      display: block;
      padding: 1rem;
      color: var(--terminal-muted);
      font-size: .75rem;
      letter-spacing: 0.1em;
      text-decoration: none;
    }
  }

  @media (max-width: 38rem) {
    .nav-actions {
      gap: 0.4rem;
    }

    /* CV links stay in the mobile menu; the header has no room for them. */
    .nav-cv {
      display: none;
    }
  }
</style>

<script>
  let teardownMobileMenu: (() => void) | undefined;

  const initMobileMenu = () => {
    teardownMobileMenu?.();

    const button = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!button || !menu) return;

    const controller = new AbortController();
    const { signal } = controller;
    const buttonLabel = button.querySelector('span');
    const desktopQuery = window.matchMedia('(min-width: 68.001rem)');

    const setOpen = (open, restoreFocus = true) => {
      if (open) menu.setAttribute('data-open', 'true');
      else menu.removeAttribute('data-open');
      menu.toggleAttribute('inert', !open);
      menu.setAttribute('aria-hidden', String(!open));
      button.setAttribute('aria-expanded', String(open));
      if (buttonLabel) buttonLabel.textContent = open ? 'Close' : 'Menu';
      document.documentElement.classList.toggle('overflow-hidden', open);
      [document.querySelector('main'), document.querySelector('.site-footer'), document.querySelector('.skip-link')]
        .filter((element) => element instanceof HTMLElement)
        .forEach((element) => element.toggleAttribute('inert', open));

      if (open) {
        document.getElementById('lang-menu')?.setAttribute('hidden', '');
        document.getElementById('lang-toggle')?.setAttribute('aria-expanded', 'false');
        menu.querySelector('[data-mobile-nav-link]')?.focus();
      } else if (restoreFocus && menu.contains(document.activeElement)) {
        button.focus();
      }
    };

    setOpen(false, false);

    button.addEventListener(
      'click',
      () => setOpen(button.getAttribute('aria-expanded') !== 'true'),
      { signal },
    );
    menu.querySelectorAll('a[href]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false), { signal });
    });
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          return;
        }

        if (event.key === 'Tab' && button.getAttribute('aria-expanded') === 'true') {
          const focusable = [button, ...menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      },
      { signal },
    );
    desktopQuery.addEventListener(
      'change',
      (event) => {
        if (event.matches) setOpen(false, false);
      },
      { signal },
    );

    teardownMobileMenu = () => {
      setOpen(false, false);
      controller.abort();
      teardownMobileMenu = undefined;
    };
  };

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
  document.addEventListener('astro:before-swap', () => teardownMobileMenu?.());
</script>
