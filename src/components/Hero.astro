---
import { defaultLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getHome(locale).hero;

let repoCount = '450+';
let starCount = '650+';

try {
  const userRes = await fetch('https://api.github.com/users/suenot', {
    headers: { Accept: 'application/vnd.github.v3+json' },
  });
  const userData = await userRes.json();
  repoCount = String(userData.public_repos ?? '450+');

  let totalStars = 0;
  let page = 1;
  while (true) {
    const reposRes = await fetch(
      `https://api.github.com/users/suenot/repos?per_page=100&page=${page}&type=owner`,
      { headers: { Accept: 'application/vnd.github.v3+json' } },
    );
    const repos: { stargazers_count: number; fork: boolean }[] = await reposRes.json();
    if (!Array.isArray(repos) || repos.length === 0) break;
    totalStars += repos.filter((repo) => !repo.fork).reduce((sum, repo) => sum + repo.stargazers_count, 0);
    if (repos.length < 100) break;
    page++;
  }
  starCount = totalStars > 0 ? String(totalStars) : '650+';
} catch {
  // Build remains deterministic when GitHub is unavailable.
}

const currentYear = new Date().getFullYear();
const stats = [
  { value: `${currentYear - 2006}+`, label: t.stat_dev, code: 'EXP/DEV' },
  { value: `${currentYear - 2011}+`, label: t.stat_trading, code: 'EXP/MKT' },
  { value: starCount, label: t.stat_stars, code: 'GH/STAR' },
  { value: repoCount, label: t.stat_repos, code: 'GH/REPO' },
];

const orderBook = [
  ['67245.0', '0.258', '11.597', '67239.0', '1.358', 18, 42],
  ['67244.5', '1.102', '11.347', '67238.5', '0.950', 31, 26],
  ['67244.0', '0.880', '10.245', '67238.0', '1.100', 25, 35],
  ['67243.5', '1.004', '9.365', '67237.5', '0.780', 38, 29],
  ['67243.0', '2.531', '8.361', '67237.0', '2.450', 54, 63],
  ['67242.5', '0.409', '5.830', '67236.5', '1.020', 23, 46],
  ['67242.0', '1.350', '5.421', '67236.0', '0.880', 47, 37],
  ['67241.5', '1.200', '4.071', '67235.5', '0.670', 52, 32],
  ['67241.0', '2.100', '2.871', '67235.0', '1.520', 69, 58],
  ['67240.5', '0.771', '0.771', '67234.5', '2.200', 35, 76],
];

const metrics = [
  { label: 'CPU', value: '23%', path: 'M0 22L8 20L15 23L22 13L29 19L36 17L43 24L50 12L57 18L64 16L71 21L78 15L85 19L92 13L100 17' },
  { label: 'MEM', value: '41%', path: 'M0 18L8 19L15 14L22 20L29 17L36 18L43 13L50 15L57 14L64 19L71 16L78 17L85 12L92 15L100 14' },
  { label: 'NET IN', value: '1.2G', path: 'M0 23L8 22L15 21L22 8L29 19L36 17L43 21L50 15L57 19L64 10L71 17L78 15L85 20L92 12L100 18' },
  { label: 'NET OUT', value: '1.4G', path: 'M0 17L8 21L15 16L22 20L29 11L36 18L43 15L50 21L57 12L64 18L71 14L78 16L85 11L92 19L100 15' },
  { label: 'P99 LAT', value: '18µS', path: 'M0 21L8 19L15 20L22 17L29 19L36 10L43 18L50 16L57 20L64 15L71 17L78 8L85 16L92 13L100 15' },
];
---

<section id="top" class="hero terminal-section" aria-labelledby="hero-title">
  <div class="hero__frame terminal-container">
    <div class="hero__primary">
      <div class="hero__eyebrow terminal-kicker" aria-hidden="true">
        <span>PORTFOLIO / 2026</span>
        <span>BUILD 26.08</span>
      </div>

      <div class="hero__name-block">
        <span class="hero__rail" aria-hidden="true">C3 / 487</span>
        <h1 id="hero-title" class="hero__name display-type"><span>Eugen</span><span>Soloviov</span></h1>
      </div>

      <p class="hero__tagline">{t.tagline}</p>
      <p class="hero__description">{t.description}</p>
      <p class="hero__roles">┌ &nbsp;{t.badge}&nbsp; ┘</p>

      <div class="hero__actions">
        <a href="#projects" class="terminal-button hero__button">
          <span aria-hidden="true">→</span>
          <span>[ {t.cta_projects} ]</span>
        </a>
        <a href="#contact" class="terminal-link hero__contact">{t.cta_contact} / COMM-LINK</a>
      </div>
    </div>

    <aside class="hero__telemetry" aria-label="Trading and infrastructure telemetry">
      <section class="telemetry telemetry--book">
        <header><span>ORDER BOOK · BTC-USD</span><span>Δ 14MS</span></header>
        <div class="book__head"><span>PRICE</span><span>SIZE</span><span>TOTAL</span><span>PRICE</span><span>SIZE</span></div>
        <div class="book__rows">
          {orderBook.map((row, index) => (
            <div class="book__row" style={`--row:${index}; --bid:${row[5]}%; --ask:${row[6]}%;`}>
              <data value={row[0]}>{row[0]}</data>
              <data class="book__size book__size--bid" value={row[1]}>{row[1]}</data>
              <data value={row[2]}>{row[2]}</data>
              <data class="book__ask" value={row[3]}>{row[3]}</data>
              <data class="book__size book__size--ask" value={row[4]}>{row[4]}</data>
            </div>
          ))}
        </div>

        <div class="depth">
          <div class="depth__label"><span>MARKET DEPTH / ±150</span><span>0.5 TICK</span></div>
          <svg viewBox="0 0 520 152" preserveAspectRatio="none" role="img" aria-label="Animated BTC-USD market depth graph">
            <path class="depth__grid" d="M0 24.5H520M0 65.5H520M0 106.5H520M0 147.5H520M130 0V152M260 0V152M390 0V152" />
            <path class="depth__fill depth__fill--bid" d="M0 28H31V34H64V40H95V50H128V57H160V69H190V80H216V99H239V124H260V152H0Z" />
            <path class="depth__fill depth__fill--ask" d="M260 124H280V98H306V84H334V73H365V63H395V51H428V40H460V31H489V24H520V152H260Z" />
            <path class="depth__line depth__line--bid" pathLength="1" d="M0 28H31V34H64V40H95V50H128V57H160V69H190V80H216V99H239V124H260" />
            <path class="depth__line depth__line--ask" pathLength="1" d="M260 124H280V98H306V84H334V73H365V63H395V51H428V40H460V31H489V24H520" />
            <path class="depth__mid" d="M260 0V152" />
          </svg>
          <div class="depth__axis" aria-hidden="true"><span>-150</span><span>-75</span><span>0</span><span>75</span><span>150</span></div>
        </div>
      </section>

      <section class="telemetry telemetry--network">
        <header><span>NETWORK TOPOLOGY</span><span>NODES / 08</span></header>
        <svg class="network" viewBox="0 0 360 218" role="img" aria-label="Animated server network topology diagram">
          <g class="network__links">
            <path pathLength="1" d="M42 97L111 35L191 26L308 90L297 171L202 186L102 177Z" />
            <path pathLength="1" d="M42 97L180 108L308 90M111 35L180 108L102 177M191 26L180 108L297 171M180 108L202 186" />
          </g>
          <g class="network__nodes">
            <circle style="--node:0" cx="42" cy="97" r="4"/><circle style="--node:1" cx="111" cy="35" r="4"/>
            <circle style="--node:2" cx="191" cy="26" r="4"/><circle style="--node:3" cx="308" cy="90" r="4"/>
            <circle style="--node:4" cx="297" cy="171" r="4"/><circle style="--node:5" cx="202" cy="186" r="4"/>
            <circle style="--node:6" cx="102" cy="177" r="4"/><rect style="--node:7" x="174" y="102" width="12" height="12"/>
          </g>
          <g class="network__labels">
            <text x="27" y="118">FRA</text><text x="97" y="25">LDN</text><text x="198" y="19">AMS</text>
            <text x="314" y="90">TYO</text><text x="303" y="179">NY4</text><text x="207" y="204">CHI</text>
            <text x="76" y="197">SGP</text><text x="192" y="105">CORE/GW</text>
          </g>
          <g class="network__packet" aria-hidden="true"><circle r="2.5"><animateMotion dur="4.8s" repeatCount="indefinite" path="M42 97L180 108L308 90L297 171L202 186L180 108L111 35" /></circle></g>
        </svg>
      </section>

      <section class="telemetry telemetry--metrics">
        <header><span>SYSTEM METRICS</span><span>60 SEC</span></header>
        <div class="metrics">
          {metrics.map((metric, index) => (
            <div class="metric" style={`--metric:${index}`}>
              <span>{metric.label}</span>
              <svg viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
                <path class="metric__baseline" d="M0 24.5H100" />
                <path class="metric__line" pathLength="1" d={metric.path} />
              </svg>
              <output>{metric.value}</output>
            </div>
          ))}
        </div>
      </section>
    </aside>

    <div class="hero__stats" aria-label="Career and GitHub statistics">
      {stats.map((stat, index) => (
        <div class="hero__stat">
          <span class="hero__stat-index">0{index + 1}</span>
          <data value={stat.value}>{stat.value}</data>
          <span>{stat.label}</span>
          <samp>[ {stat.code} ]</samp>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { min-height: 100dvh; padding-block-start: 4.25rem; border-block-end: 1px solid var(--terminal-line, #303431); }
  .hero__frame { display: grid; grid-template-columns: minmax(0, .97fr) minmax(36rem, 1.03fr); }
  .hero__primary { position: relative; min-width: 0; padding: clamp(1.5rem, 3.7vw, 4.5rem) clamp(1rem, 3.2vw, 3.5rem) 2.5rem; border-inline-end: 1px solid var(--terminal-line, #303431); }
  .hero__eyebrow { display: flex; justify-content: space-between; color: var(--terminal-muted, #747a75); margin-block-end: clamp(2.8rem, 5vw, 5.5rem); }
  .hero__name-block { position: relative; padding-inline-start: 2.7rem; }
  .hero__rail { position: absolute; inset-block: 0; inset-inline-start: 0; writing-mode: vertical-rl; color: #ff3b30; font: 600 .58rem/1 var(--font-mono, monospace); letter-spacing: .14em; border-inline-start: 2px solid #ff3b30; padding-inline-start: .55rem; }
  .hero__name { color: var(--terminal-fg, #e7e9e3); font-size: clamp(5.4rem, 9.2vw, 11rem); font-weight: 950; letter-spacing: -.082em; line-height: .76; text-transform: uppercase; text-wrap: nowrap; }
  .hero__name span { display: block; }
  .hero__tagline { margin: 1.55rem 0 0 2.7rem; color: var(--terminal-fg, #e7e9e3); font: 500 clamp(.78rem, 1.2vw, 1.1rem)/1.2 var(--font-mono, monospace); letter-spacing: .13em; text-transform: uppercase; }
  .hero__description { max-inline-size: 39rem; margin: 1rem 0 0 2.7rem; color: var(--terminal-muted, #929792); font: .76rem/1.55 var(--font-mono, monospace); letter-spacing: .035em; text-wrap: pretty; }
  .hero__roles { margin: 1.2rem 0 0 2.7rem; color: var(--terminal-muted, #8b908c); font: .64rem/1.6 var(--font-mono, monospace); letter-spacing: .11em; text-transform: uppercase; }
  .hero__actions { display: flex; align-items: center; gap: 2rem; margin: 1.45rem 0 0 2.7rem; }
  .hero__button { display: inline-grid; grid-template-columns: 3.2rem auto; align-items: center; min-block-size: 3rem; padding: 0 1.1rem 0 0; border: 1px solid currentColor; color: var(--terminal-fg, #e7e9e3); font: 600 .65rem/1 var(--font-mono, monospace); letter-spacing: .13em; text-transform: uppercase; }
  .hero__button > :first-child { display: grid; align-items: center; align-self: stretch; padding-inline: 1rem; border-inline-end: 1px solid currentColor; color: #ff3b30; font-size: 1.5rem; }
  .hero__button:hover { background: var(--terminal-fg, #e7e9e3); color: var(--terminal-bg, #0b0d0c); }
  .hero__contact { color: var(--terminal-muted, #8b908c); font: .64rem/1 var(--font-mono, monospace); letter-spacing: .1em; text-transform: uppercase; text-decoration: underline; text-underline-offset: .45rem; }
  .hero__contact:hover { color: #ff3b30; }

  .hero__telemetry { display: grid; grid-template-columns: 1.08fr .92fr; grid-template-rows: auto 1fr; min-width: 0; padding: clamp(1.5rem, 3.7vw, 4.5rem) clamp(.8rem, 1.5vw, 1.5rem) 1.5rem; gap: .7rem; }
  .telemetry { min-width: 0; overflow: hidden; border: 1px solid var(--terminal-line, #303431); color: var(--terminal-muted, #929792); }
  .telemetry header { display: flex; justify-content: space-between; gap: 1rem; padding: .5rem .65rem; border-block-end: 1px solid var(--terminal-line, #303431); color: #858b86; font: .51rem/1 var(--font-mono, monospace); letter-spacing: .12em; }
  .telemetry--book { grid-row: 1 / 3; }
  .book__head, .book__row { display: grid; grid-template-columns: 1.06fr .72fr .88fr 1.06fr .72fr; gap: .3rem; align-items: center; padding-inline: .65rem; font: .48rem/1.5 var(--font-mono, monospace); font-variant-numeric: tabular-nums; }
  .book__head { padding-block: .5rem .28rem; color: #5d625e; letter-spacing: .06em; }
  .book__row { position: relative; min-block-size: 1.18rem; animation: book-tick 5.4s calc(var(--row) * -410ms) infinite step-end; }
  .book__row:nth-child(5) { border-block: 1px solid #343834; }
  .book__ask { color: #ff4a40; }
  .book__size { position: relative; isolation: isolate; }
  .book__size::before { content: ''; position: absolute; z-index: -1; inset-block: .08rem; inset-inline-start: -.18rem; inline-size: var(--bid); background: #858b8613; transform-origin: left; animation: liquidity 4.6s calc(var(--row) * -330ms) ease-in-out infinite alternate; }
  .book__size--ask::before { inline-size: var(--ask); background: #ff3b301c; }
  .depth { margin-block-start: .55rem; border-block-start: 1px solid var(--terminal-line, #303431); }
  .depth__label { display: flex; justify-content: space-between; padding: .45rem .65rem 0; color: #5d625e; font: .46rem/1 var(--font-mono, monospace); letter-spacing: .08em; }
  .depth svg { display: block; inline-size: calc(100% - 1.3rem); block-size: 9rem; margin: .25rem .65rem 0; overflow: visible; }
  .depth__grid { fill: none; stroke: #282c29; stroke-width: 1; stroke-dasharray: 2 4; vector-effect: non-scaling-stroke; }
  .depth__fill { transform-box: fill-box; transform-origin: bottom; animation: depth-breathe 5s ease-in-out infinite alternate; }
  .depth__fill--bid { fill: #969c9710; }
  .depth__fill--ask { fill: #ff3b3016; animation-delay: -2.1s; }
  .depth__line { fill: none; stroke-width: 1.25; stroke-dasharray: 1; stroke-dashoffset: 1; vector-effect: non-scaling-stroke; animation: chart-draw 2.2s cubic-bezier(.2,.7,.2,1) forwards; }
  .depth__line--bid { stroke: #777d78; }
  .depth__line--ask { stroke: #ff3b30; animation-delay: .2s; }
  .depth__mid { stroke: #686e69; stroke-dasharray: 3 4; vector-effect: non-scaling-stroke; }
  .depth__axis { display: flex; justify-content: space-between; padding: 0 .65rem .45rem; color: #505551; font: .42rem/1 var(--font-mono, monospace); }

  .network { display: block; inline-size: 100%; block-size: clamp(10rem, 15vw, 13.5rem); }
  .network__links { fill: none; stroke: #484d49; stroke-width: 1; stroke-dasharray: .018 .018; animation: network-flow 13s linear infinite; }
  .network__nodes { fill: #969c97; }
  .network__nodes > * { transform-box: fill-box; transform-origin: center; animation: node-pulse 3.5s calc(var(--node) * -420ms) ease-in-out infinite; }
  .network__labels { fill: #858b86; font: 8px var(--font-mono, monospace); letter-spacing: 1px; }
  .network__packet { fill: #ff3b30; }

  .metrics { padding: .35rem .6rem .5rem; }
  .metric { display: grid; grid-template-columns: 3.4rem minmax(3rem, 1fr) 2.8rem; align-items: center; min-block-size: 1.75rem; gap: .4rem; font: .46rem/1 var(--font-mono, monospace); letter-spacing: .07em; }
  .metric svg { inline-size: 100%; block-size: 1.55rem; overflow: visible; }
  .metric__baseline { fill: none; stroke: #2b2f2c; stroke-width: 1; stroke-dasharray: 2 3; vector-effect: non-scaling-stroke; }
  .metric__line { fill: none; stroke: #858b86; stroke-width: 1; stroke-dasharray: 1; stroke-dashoffset: 1; vector-effect: non-scaling-stroke; animation: metric-draw 2.8s calc(var(--metric) * 130ms) cubic-bezier(.2,.7,.2,1) forwards, metric-flicker 7s calc(var(--metric) * -1.1s) ease-in-out infinite; }
  .metric output { justify-self: end; color: #a7aca8; font-variant-numeric: tabular-nums; }

  .hero__stats { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); border-block-start: 1px solid var(--terminal-line, #303431); }
  .hero__stat { display: grid; grid-template-columns: auto 1fr; min-block-size: 7.2rem; padding: 1rem 1.3rem; border-inline-end: 1px solid var(--terminal-line, #303431); }
  .hero__stat:last-child { border-inline-end: 0; }
  .hero__stat-index { color: var(--terminal-muted, #747a75); font: .62rem/1 var(--font-mono, monospace); }
  .hero__stat data { justify-self: end; color: var(--terminal-fg, #e7e9e3); font: 700 clamp(1.4rem, 2.4vw, 2.5rem)/.9 var(--font-mono, monospace); font-variant-numeric: tabular-nums; }
  .hero__stat > span:not(.hero__stat-index), .hero__stat samp { align-self: end; color: var(--terminal-muted, #8b908c); font: .55rem/1.4 var(--font-mono, monospace); letter-spacing: .08em; text-transform: uppercase; }
  .hero__stat samp { justify-self: end; }
  .hero a:focus-visible { outline: 2px solid #ff3b30; outline-offset: 4px; }

  @keyframes book-tick { 0%, 88%, 100% { opacity: 1; } 90% { opacity: .55; } 92% { opacity: 1; } }
  @keyframes liquidity { from { transform: scaleX(.72); opacity: .55; } to { transform: scaleX(1); opacity: 1; } }
  @keyframes chart-draw { to { stroke-dashoffset: 0; } }
  @keyframes depth-breathe { from { transform: scaleY(.93); opacity: .65; } to { transform: scaleY(1); opacity: 1; } }
  @keyframes network-flow { to { stroke-dashoffset: -1; } }
  @keyframes node-pulse { 0%, 75%, 100% { opacity: .5; transform: scale(.75); } 82% { opacity: 1; transform: scale(1.35); } }
  @keyframes metric-draw { to { stroke-dashoffset: 0; } }
  @keyframes metric-flicker { 0%, 45%, 100% { opacity: .72; } 50% { opacity: 1; } }

  @media (max-width: 1180px) {
    .hero__frame { grid-template-columns: 1fr; }
    .hero__primary { border-inline-end: 0; border-block-end: 1px solid var(--terminal-line, #303431); }
    .hero__name { font-size: clamp(5rem, 15vw, 10rem); }
    .hero__telemetry { grid-template-columns: 1.1fr .9fr; }
  }
  @media (max-width: 720px) {
    .hero { padding-block-start: 3.75rem; }
    .hero__primary { padding-block-start: 1.8rem; }
    .hero__eyebrow { margin-block-end: 2.8rem; }
    .hero__name-block { padding-inline-start: 1.5rem; }
    .hero__rail { font-size: .48rem; }
    .hero__name { font-size: clamp(3.35rem, 19.2vw, 6.4rem); line-height: .8; }
    .hero__tagline, .hero__description, .hero__roles, .hero__actions { margin-inline-start: 1.5rem; }
    .hero__actions { align-items: flex-start; flex-direction: column; gap: 1.4rem; }
    .hero__telemetry { grid-template-columns: 1fr; padding: .8rem; }
    .telemetry--book { grid-row: auto; }
    .telemetry--network { display: none; }
    .telemetry--metrics { display: block; }
    .depth svg { block-size: 7rem; }
    .hero__stats { grid-template-columns: 1fr 1fr; }
    .hero__stat { min-block-size: 6.6rem; border-block-end: 1px solid var(--terminal-line, #303431); }
  }
  @media (max-width: 390px) {
    .book__head, .book__row { font-size: .43rem; padding-inline: .45rem; gap: .2rem; }
    .hero__stat { padding-inline: .9rem; }
    .hero__stat samp { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .book__row, .book__size::before, .depth__fill, .depth__line, .network__links, .network__nodes > *, .metric__line { animation: none !important; }
    .depth__line, .metric__line { stroke-dashoffset: 0; }
    .network__packet { display: none; }
  }
</style>
