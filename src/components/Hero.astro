---
import { defaultLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getHome(locale).hero;

let repoCount = '450+';
let starCount = '650+';

try {
  const userRes = await fetch('https://api.github.com/users/suenot', {
    headers: { Accept: 'application/vnd.github.v3+json' },
  });
  const userData = await userRes.json();
  repoCount = String(userData.public_repos ?? '450+');

  let totalStars = 0;
  let page = 1;
  while (true) {
    const reposRes = await fetch(
      `https://api.github.com/users/suenot/repos?per_page=100&page=${page}&type=owner`,
      { headers: { Accept: 'application/vnd.github.v3+json' } },
    );
    const repos: { stargazers_count: number; fork: boolean }[] = await reposRes.json();
    if (!Array.isArray(repos) || repos.length === 0) break;
    totalStars += repos.filter((repo) => !repo.fork).reduce((sum, repo) => sum + repo.stargazers_count, 0);
    if (repos.length < 100) break;
    page++;
  }
  starCount = totalStars > 0 ? String(totalStars) : '650+';
} catch {
  // Build remains deterministic when GitHub is unavailable.
}

const currentYear = new Date().getFullYear();
const stats = [
  { value: `${currentYear - 2006}+`, label: t.stat_dev, code: 'EXP/DEV' },
  { value: `${currentYear - 2011}+`, label: t.stat_trading, code: 'EXP/MKT' },
  { value: starCount, label: t.stat_stars, code: 'GH/STAR' },
  { value: repoCount, label: t.stat_repos, code: 'GH/REPO' },
];

const orderBook = Array.from({ length: 10 }, (_, index) => {
  const bidSize = 0.42 + ((index * 37) % 19) / 10;
  const askSize = 0.36 + ((index * 29 + 7) % 21) / 10;
  return [
    (67238.5 - index * 0.5).toFixed(1),
    bidSize.toFixed(3),
    '0.000',
    (67239 + index * 0.5).toFixed(1),
    askSize.toFixed(3),
    20 + index * 5,
    18 + index * 6,
  ];
});

const metrics = [
  { label: 'CPU', value: '23%', path: 'M0 19L8 18L15 19L22 17L29 18L36 16L43 18L50 17L57 19L64 16L71 18L78 17L85 16L92 18L100 17' },
  { label: 'MEM', value: '41%', path: 'M0 17L8 17L15 16L22 17L29 16L36 16L43 15L50 16L57 15L64 16L71 15L78 15L85 14L92 15L100 14' },
  { label: 'NET IN', value: '1.2G', path: 'M0 22L8 21L15 20L22 18L29 20L36 17L43 19L50 16L57 18L64 17L71 19L78 16L85 18L92 15L100 17' },
  { label: 'NET OUT', value: '1.4G', path: 'M0 20L8 19L15 20L22 17L29 19L36 18L43 16L50 18L57 17L64 19L71 16L78 18L85 17L92 15L100 17' },
  { label: 'P99 LAT', value: '18µS', path: 'M0 20L8 19L15 20L22 19L29 18L36 19L43 17L50 19L57 18L64 19L71 17L78 18L85 16L92 18L100 17' },
];
---

<section id="top" class="hero terminal-section" aria-labelledby="hero-title">
  <div class="hero__frame terminal-container">
    <div class="hero__primary">
      <div class="hero__eyebrow terminal-kicker" aria-hidden="true">
        <span>PORTFOLIO / 2026</span>
        <span>BUILD 26.08</span>
      </div>

      <div class="hero__name-block">
        <span class="hero__rail" aria-hidden="true">C3 / 487</span>
        <h1 id="hero-title" class="hero__name display-type"><span>Eugen</span><span>Soloviov</span></h1>
      </div>

      <p class="hero__tagline">{t.tagline}</p>
      <p class="hero__description">{t.description}</p>
      <p class="hero__roles">┌ &nbsp;{t.badge}&nbsp; ┘</p>

      <div class="hero__actions">
        <a href="#projects" class="terminal-button hero__button">
          <span aria-hidden="true">→</span>
          <span>[ {t.cta_projects} ]</span>
        </a>
        <a href="#contact" class="terminal-link hero__contact">{t.cta_contact} / COMM-LINK</a>
      </div>
    </div>

    <aside class="hero__telemetry" aria-label="Trading and infrastructure telemetry" data-market-terminal>
      <section class="telemetry telemetry--book">
        <header><span>ORDER BOOK · BTC-USD</span><span data-feed-status>LIVE · 14MS</span></header>
        <div class="book__head"><span>BID</span><span>SIZE</span><span>TOTAL</span><span>ASK</span><span>SIZE</span><span>TOTAL</span></div>
        <div class="book__rows" aria-hidden="true">
          {orderBook.map((row, index) => (
            <div class="book__row" data-book-row>
              <data data-cell="bid-price" value={row[0]}>{row[0]}</data>
              <data class="book__size book__size--bid" data-cell="bid-size" value={row[1]}>{row[1]}</data>
              <data data-cell="bid-total" value={row[2]}>{row[2]}</data>
              <data class="book__ask" data-cell="ask-price" value={row[3]}>{row[3]}</data>
              <data class="book__size book__size--ask" data-cell="ask-size" value={row[4]}>{row[4]}</data>
              <data data-cell="ask-total" value={row[2]}>{row[2]}</data>
            </div>
          ))}
        </div>

        <div class="depth">
          <div class="depth__label"><span>MARKET DEPTH / ±150</span><span>0.5 TICK</span></div>
          <svg viewBox="0 0 520 152" preserveAspectRatio="none" aria-hidden="true">
            <path class="depth__grid" d="M0 24.5H520M0 65.5H520M0 106.5H520M0 147.5H520M130 0V152M260 0V152M390 0V152" />
            <path class="depth__fill depth__fill--bid" data-depth="bid-fill" d="M0 28H31V34H64V40H95V50H128V57H160V69H190V80H216V99H239V124H260V152H0Z" />
            <path class="depth__fill depth__fill--ask" data-depth="ask-fill" d="M260 124H280V98H306V84H334V73H365V63H395V51H428V40H460V31H489V24H520V152H260Z" />
            <path class="depth__line depth__line--bid" data-depth="bid-line" d="M0 28H31V34H64V40H95V50H128V57H160V69H190V80H216V99H239V124H260" />
            <path class="depth__line depth__line--ask" data-depth="ask-line" d="M260 124H280V98H306V84H334V73H365V63H395V51H428V40H460V31H489V24H520" />
            <path class="depth__mid" d="M260 0V152" />
          </svg>
          <div class="depth__axis" aria-hidden="true"><span>-150</span><span>-75</span><span>0</span><span>75</span><span>150</span></div>
        </div>
      </section>

      <section class="telemetry telemetry--network">
        <header><span>NETWORK TOPOLOGY</span><span>NODES / 08</span></header>
        <svg class="network" viewBox="0 0 360 218" aria-hidden="true">
          <g class="network__links">
            <line data-edge="0-1" x1="42" y1="97" x2="111" y2="35"/><line data-edge="1-2" x1="111" y1="35" x2="191" y2="26"/>
            <line data-edge="2-3" x1="191" y1="26" x2="308" y2="90"/><line data-edge="3-4" x1="308" y1="90" x2="297" y2="171"/>
            <line data-edge="4-5" x1="297" y1="171" x2="202" y2="186"/><line data-edge="5-6" x1="202" y1="186" x2="102" y2="177"/>
            <line data-edge="6-0" x1="102" y1="177" x2="42" y2="97"/><line data-edge="0-7" x1="42" y1="97" x2="180" y2="108"/>
            <line data-edge="1-7" x1="111" y1="35" x2="180" y2="108"/><line data-edge="2-7" x1="191" y1="26" x2="180" y2="108"/>
            <line data-edge="3-7" x1="308" y1="90" x2="180" y2="108"/><line data-edge="4-7" x1="297" y1="171" x2="180" y2="108"/>
            <line data-edge="5-7" x1="202" y1="186" x2="180" y2="108"/><line data-edge="6-7" x1="102" y1="177" x2="180" y2="108"/>
          </g>
          <g class="network__nodes">
            <circle data-node="0" cx="42" cy="97" r="4"/><circle data-node="1" cx="111" cy="35" r="4"/>
            <circle data-node="2" cx="191" cy="26" r="4"/><circle data-node="3" cx="308" cy="90" r="4"/>
            <circle data-node="4" cx="297" cy="171" r="4"/><circle data-node="5" cx="202" cy="186" r="4"/>
            <circle data-node="6" cx="102" cy="177" r="4"/><rect data-node="7" x="174" y="102" width="12" height="12"/>
          </g>
          <g class="network__labels">
            <text x="27" y="118">FRA</text><text x="97" y="25">LDN</text><text x="198" y="19">AMS</text>
            <text x="314" y="90">TYO</text><text x="303" y="179">NY4</text><text x="207" y="204">CHI</text>
            <text x="76" y="197">SGP</text><text x="192" y="105">CORE/GW</text>
          </g>
          <circle class="network__packet" data-packet cx="42" cy="97" r="2.7" />
        </svg>
      </section>

      <section class="telemetry telemetry--metrics">
        <header><span>SYSTEM METRICS</span><span>60 SEC</span></header>
        <div class="metrics" aria-hidden="true">
          {metrics.map((metric, index) => (
            <div class="metric" data-metric={index}>
              <span>{metric.label}</span>
              <svg viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
                <path class="metric__baseline" d="M0 24.5H100" />
                <path class="metric__line" d={metric.path} />
              </svg>
              <output>{metric.value}</output>
            </div>
          ))}
        </div>
      </section>
    </aside>

    <div class="hero__stats" aria-label="Career and GitHub statistics">
      {stats.map((stat, index) => (
        <div class="hero__stat">
          <span class="hero__stat-index">0{index + 1}</span>
          <data value={stat.value}>{stat.value}</data>
          <span>{stat.label}</span>
          <samp>[ {stat.code} ]</samp>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  type Level = { price: number; size: number; total: number };
  type MetricState = { current: number; target: number; history: number[]; min: number; max: number; unit: string };

  const terminalCleanups = new WeakMap<Element, () => void>();

  function startMarketTerminal(root: HTMLElement) {
    terminalCleanups.get(root)?.();

    let seed = 0x5f3759df;
    const random = () => {
      seed ^= seed << 13;
      seed ^= seed >>> 17;
      seed ^= seed << 5;
      return (seed >>> 0) / 4294967296;
    };
    const noise = () => random() + random() + random() - 1.5;
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-book-row]')];
    const status = root.querySelector<HTMLElement>('[data-feed-status]');
    const depthPaths = new Map(
      [...root.querySelectorAll<SVGPathElement>('[data-depth]')].map((path) => [path.dataset.depth, path]),
    );
    const packet = root.querySelector<SVGCircleElement>('[data-packet]');
    const edges = [...root.querySelectorAll<SVGLineElement>('[data-edge]')];
    const nodes = [...root.querySelectorAll<SVGGraphicsElement>('[data-node]')];
    const metricEls = [...root.querySelectorAll<HTMLElement>('[data-metric]')];

    const tickSize = 0.5;
    const anchor = 67239;
    let mid = anchor;
    let lastMove = 0;
    let bidSizes = Array.from({ length: 10 }, (_, i) => 0.48 + i * 0.13 + random() * 0.75);
    let askSizes = Array.from({ length: 10 }, (_, i) => 0.44 + i * 0.14 + random() * 0.78);
    let bids: Level[] = [];
    let asks: Level[] = [];

    const metricState: MetricState[] = [
      { current: 23, target: 23, history: Array(60).fill(23), min: 10, max: 55, unit: '%' },
      { current: 41, target: 41, history: Array(60).fill(41), min: 34, max: 56, unit: '%' },
      { current: 1.2, target: 1.2, history: Array(60).fill(1.2), min: 0.3, max: 2.8, unit: 'G' },
      { current: 1.4, target: 1.4, history: Array(60).fill(1.4), min: 0.4, max: 3.2, unit: 'G' },
      { current: 18, target: 18, history: Array(60).fill(18), min: 8, max: 42, unit: 'µS' },
    ];

    const nodePositions = [
      [42, 97], [111, 35], [191, 26], [308, 90], [297, 171], [202, 186], [102, 177], [180, 108],
    ];
    const route = [0, 7, 3, 4, 7, 1, 2, 7, 6, 5, 7, 0];
    let routeIndex = -1;
    let routeClock = 0;
    const routeDuration = 920;

    function buildBook() {
      const bestBid = Math.round((mid - tickSize) / tickSize) * tickSize;
      const bestAsk = bestBid + tickSize * 2;
      let bidTotal = 0;
      let askTotal = 0;
      bids = bidSizes.map((size, i) => {
        bidTotal += size;
        return { price: bestBid - i * tickSize, size, total: bidTotal };
      });
      asks = askSizes.map((size, i) => {
        askTotal += size;
        return { price: bestAsk + i * tickSize, size, total: askTotal };
      });
      if (import.meta.env.DEV && !bookIsValid()) throw new Error('Market terminal generated an invalid order book');
    }

    function bookIsValid() {
      const validLevels = (levels: Level[], direction: 'ascending' | 'descending') => levels.every((level, index) => {
        const previous = levels[index - 1];
        const priceIsOrdered = !previous || (direction === 'ascending' ? level.price > previous.price : level.price < previous.price);
        const totalIsMonotone = !previous || level.total >= previous.total;
        return priceIsOrdered && totalIsMonotone && Number.isFinite(level.price) && Number.isFinite(level.size) && Number.isFinite(level.total);
      });
      return validLevels(bids, 'descending') && validLevels(asks, 'ascending') && bids[0].price < asks[0].price;
    }

    function stepPath(levels: Level[], side: 'bid' | 'ask') {
      const maximum = Math.max(bids.at(-1)?.total ?? 1, asks.at(-1)?.total ?? 1);
      const points = levels.map((level, index) => {
        const distance = (index + 0.5) * 25.5;
        const x = side === 'bid' ? 260 - distance : 260 + distance;
        const y = 140 - (level.total / maximum) * 108;
        return [x, y] as const;
      });
      if (side === 'bid') points.reverse();
      return points.reduce((path, [x, y], index) => `${path}${index ? `H${x.toFixed(1)}V${y.toFixed(1)}` : `M${x.toFixed(1)} ${y.toFixed(1)}`}`, '');
    }

    function renderBook() {
      buildBook();
      const maximumSize = Math.max(...bidSizes, ...askSizes);
      rows.forEach((row, index) => {
        const bid = bids[index];
        const ask = asks[index];
        const values: Record<string, string> = {
          'bid-price': bid.price.toFixed(1), 'bid-size': bid.size.toFixed(3), 'bid-total': bid.total.toFixed(3),
          'ask-price': ask.price.toFixed(1), 'ask-size': ask.size.toFixed(3), 'ask-total': ask.total.toFixed(3),
        };
        Object.entries(values).forEach(([cell, value]) => {
          const data = row.querySelector<HTMLDataElement>(`[data-cell="${cell}"]`);
          if (!data) return;
          data.value = value;
          data.textContent = value;
        });
        row.querySelector<HTMLElement>('[data-cell="bid-size"]')?.style.setProperty('--liquidity-scale', String((bid.size / maximumSize) * 0.88));
        row.querySelector<HTMLElement>('[data-cell="ask-size"]')?.style.setProperty('--liquidity-scale', String((ask.size / maximumSize) * 0.88));
      });
      const bidLine = stepPath(bids, 'bid');
      const askLine = stepPath(asks, 'ask');
      depthPaths.get('bid-line')?.setAttribute('d', bidLine);
      depthPaths.get('ask-line')?.setAttribute('d', askLine);
      depthPaths.get('bid-fill')?.setAttribute('d', `${bidLine}L260 152H0Z`);
      depthPaths.get('ask-fill')?.setAttribute('d', `${askLine}L520 152H260Z`);
    }

    function marketTick() {
      const reversion = (anchor - mid) * 0.035;
      const impulse = noise() * 0.62 + reversion / tickSize;
      lastMove = impulse > 0.52 ? 1 : impulse < -0.52 ? -1 : 0;
      mid = clamp(mid + lastMove * tickSize, anchor - 8, anchor + 8);
      bidSizes = bidSizes.map((size, i) => random() < 0.28 ? clamp(size + (0.58 + i * 0.13 - size) * 0.12 + noise() * 0.11, 0.08, 3.8) : size);
      askSizes = askSizes.map((size, i) => random() < 0.28 ? clamp(size + (0.55 + i * 0.14 - size) * 0.12 + noise() * 0.12, 0.08, 3.8) : size);
      renderBook();
      if (status) status.textContent = `LIVE · ${Math.round(11 + random() * 7)}MS`;
    }

    function metricsTick() {
      const totalLiquidity = bids.at(-1)?.total ?? 12;
      const activity = Math.abs(lastMove) + Math.abs(noise()) * 0.7;
      metricState[0].target = clamp(20 + activity * 13 + noise() * 3, 12, 52);
      metricState[1].target = clamp(metricState[1].target + noise() * 0.55 + (42 - metricState[1].target) * 0.08, 36, 50);
      metricState[2].target = clamp(0.72 + activity * 0.8 + totalLiquidity * 0.025 + noise() * 0.16, 0.35, 2.7);
      metricState[3].target = clamp(metricState[2].target * (1.08 + noise() * 0.12), 0.4, 3);
      metricState[4].target = clamp(14 + activity * 7 + Math.max(0, 11 - totalLiquidity) * 0.65 + noise() * 1.7, 9, 38);
      metricState.forEach((metric) => {
        metric.history.push(metric.target);
        metric.history.shift();
      });
    }

    function renderMetrics(blend: number) {
      metricState.forEach((metric, index) => {
        metric.current += (metric.target - metric.current) * blend;
        const span = metric.max - metric.min;
        const lastPoint = metric.history.length - 1;
        let path = '';
        metric.history.forEach((sample, point) => {
          const value = point === lastPoint ? metric.current : sample;
          const x = (point / lastPoint) * 100;
          const y = 26 - ((clamp(value, metric.min, metric.max) - metric.min) / span) * 21;
          path += `${point ? 'L' : 'M'}${x.toFixed(2)} ${y.toFixed(2)}`;
        });
        metricEls[index]?.querySelector<SVGPathElement>('.metric__line')?.setAttribute('d', path);
        const output = metricEls[index]?.querySelector<HTMLOutputElement>('output');
        if (output) output.textContent = metric.unit === '%' ? `${Math.round(metric.current)}%` : metric.unit === 'µS' ? `${Math.round(metric.current)}µS` : `${metric.current.toFixed(1)}G`;
      });
    }

    function renderRoute(now: number) {
      if (!packet || reducedMotion) return;
      const segment = Math.floor(now / routeDuration) % (route.length - 1);
      const progress = (now % routeDuration) / routeDuration;
      const from = route[segment];
      const to = route[segment + 1];
      const [x1, y1] = nodePositions[from];
      const [x2, y2] = nodePositions[to];
      packet.setAttribute('cx', String(x1 + (x2 - x1) * progress));
      packet.setAttribute('cy', String(y1 + (y2 - y1) * progress));
      if (routeIndex === segment) return;
      routeIndex = segment;
      const activeEdge = `${Math.min(from, to)}-${Math.max(from, to)}`;
      edges.forEach((edge) => {
        const [a, b] = (edge.dataset.edge ?? '').split('-').map(Number);
        edge.classList.toggle('is-active', `${Math.min(a, b)}-${Math.max(a, b)}` === activeEdge);
      });
      nodes.forEach((node) => node.classList.toggle('is-active', Number(node.dataset.node) === to));
    }

    let animationFrame = 0;
    let lastFrame = performance.now();
    let lastMarketTick = lastFrame;
    let lastMetricsTick = lastFrame;
    let stopped = false;
    let isIntersecting = true;

    function frame(now: number) {
      if (stopped || document.hidden || !isIntersecting) return;
      const elapsed = Math.min(50, now - lastFrame);
      lastFrame = now;
      if (now - lastMarketTick >= 220) {
        marketTick();
        lastMarketTick = now;
      }
      if (now - lastMetricsTick >= 1000) {
        metricsTick();
        lastMetricsTick = now;
      }
      renderMetrics(1 - Math.exp(-elapsed / 260));
      routeClock += elapsed;
      renderRoute(routeClock);
      animationFrame = requestAnimationFrame(frame);
    }

    function resumeAnimation() {
      cancelAnimationFrame(animationFrame);
      if (document.hidden || stopped || reducedMotion || !isIntersecting) return;
      lastFrame = lastMarketTick = lastMetricsTick = performance.now();
      animationFrame = requestAnimationFrame(frame);
    }

    function onVisibilityChange() {
      resumeAnimation();
    }

    const intersectionObserver = reducedMotion ? null : new IntersectionObserver(([entry]) => {
      isIntersecting = entry?.isIntersecting ?? false;
      resumeAnimation();
    }, { threshold: 0.01 });

    function cleanup() {
      stopped = true;
      cancelAnimationFrame(animationFrame);
      intersectionObserver?.disconnect();
      document.removeEventListener('visibilitychange', onVisibilityChange);
      document.removeEventListener('astro:before-swap', cleanup);
      terminalCleanups.delete(root);
    }

    buildBook();
    renderBook();
    renderMetrics(1);
    if (reducedMotion) {
      if (status) status.textContent = 'MARKET SNAPSHOT';
    } else {
      document.addEventListener('visibilitychange', onVisibilityChange);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
      intersectionObserver?.observe(root);
      animationFrame = requestAnimationFrame(frame);
    }
    terminalCleanups.set(root, cleanup);
  }

  function initializeMarketTerminals() {
    document.querySelectorAll<HTMLElement>('[data-market-terminal]').forEach(startMarketTerminal);
  }

  initializeMarketTerminals();
  document.addEventListener('astro:page-load', initializeMarketTerminals);
</script>

<style>
  .hero { min-height: 100dvh; padding-block-start: 4.25rem; border-block-end: 1px solid var(--terminal-line, #303431); }
  .hero__frame { display: grid; grid-template-columns: minmax(0, .97fr) minmax(36rem, 1.03fr); }
  .hero__primary { position: relative; min-width: 0; padding: clamp(1.5rem, 3.7vw, 4.5rem) clamp(1rem, 3.2vw, 3.5rem) 2.5rem; border-inline-end: 1px solid var(--terminal-line, #303431); }
  .hero__eyebrow { display: flex; justify-content: space-between; color: var(--terminal-muted, #747a75); margin-block-end: clamp(2.8rem, 5vw, 5.5rem); }
  .hero__name-block { position: relative; padding-inline-start: 2.7rem; }
  .hero__rail { position: absolute; inset-block: 0; inset-inline-start: 0; writing-mode: vertical-rl; color: #ff3b30; font: 600 .58rem/1 var(--font-mono, monospace); letter-spacing: .14em; border-inline-start: 2px solid #ff3b30; padding-inline-start: .55rem; }
  .hero__name { color: var(--terminal-fg, #e7e9e3); font-size: clamp(5.4rem, 9.2vw, 11rem); font-weight: 950; letter-spacing: -.082em; line-height: .76; text-transform: uppercase; text-wrap: nowrap; }
  .hero__name span { display: block; }
