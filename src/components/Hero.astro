---
import { getCollection } from 'astro:content';
import { defaultLocale, isRtl, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';

interface Props { locale?: Locale; }

const { locale = defaultLocale } = Astro.props;
const t = getHome(locale).hero;
let repoCount = '450+';
let starCount = '650+';

try {
  const userRes = await fetch('https://api.github.com/users/suenot', { headers: { Accept: 'application/vnd.github.v3+json' } });
  const userData = await userRes.json();
  repoCount = String(userData.public_repos ?? '450+');
  let totalStars = 0;
  let page = 1;
  while (true) {
    const reposRes = await fetch(`https://api.github.com/users/suenot/repos?per_page=100&page=${page}&type=owner`, { headers: { Accept: 'application/vnd.github.v3+json' } });
    const repos: { stargazers_count: number; fork: boolean }[] = await reposRes.json();
    if (!Array.isArray(repos) || repos.length === 0) break;
    totalStars += repos.filter((repo) => !repo.fork).reduce((sum, repo) => sum + repo.stargazers_count, 0);
    if (repos.length < 100) break;
    page++;
  }
  starCount = totalStars > 0 ? String(totalStars) : '650+';
} catch {
  // Build remains deterministic when GitHub is unavailable.
}

// Latest blog note in this locale, shown as a card beside the intro.
const posts = await getCollection('blog', ({ data, id }) => id.startsWith(`${locale}/`) && !data.draft);
const latest = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())[0];
const prefix = locale === defaultLocale ? '' : `/${locale}`;
const latestSlug = latest ? latest.id.slice(locale.length + 1).replace('.md', '') : '';
const latestHref = latest ? prefix + '/blog/' + latestSlug + '/' : '';
const noteCopy: Record<Locale, { label: string; read: string }> = {
  en: { label: 'Latest note', read: 'Read' },
  ru: { label: 'Последняя заметка', read: 'Читать' },
  zh: { label: '最新文章', read: '阅读' },
  ko: { label: '최신 글', read: '읽기' },
  ja: { label: '最新の記事', read: '読む' },
  ar: { label: 'أحدث مقال', read: 'اقرأ' },
};
const note = noteCopy[locale] ?? noteCopy.en;
const latestDate = latest ? new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'short', day: 'numeric' }).format(latest.data.pubDate) : '';

const currentYear = new Date().getFullYear();
const stats = [
  { value: `${currentYear - 2006}+`, label: t.stat_dev },
  { value: `${currentYear - 2011}+`, label: t.stat_trading },
  { value: starCount, label: t.stat_stars },
  { value: repoCount, label: t.stat_repos },
];
const arrow = isRtl(locale) ? '←' : '→';
---

<section id="top" class="hero terminal-section" aria-labelledby="hero-title">
  <div class="terminal-container">
    <p class="terminal-kicker hero__kicker">{t.tagline}</p>
    <h1 id="hero-title" class="hero__name display-type">
      <span class="hero__line">Eugen</span>
      <span class="hero__line hero__line--indent">Soloviov<span class="hero__dot" aria-hidden="true"></span></span>
    </h1>

    <div class="hero__below">
      <div class="hero__intro">
        <p class="hero__description">{t.description}</p>
        <p class="hero__badge">{t.badge}</p>
        <div class="hero__actions">
          <a href="#projects" class="terminal-button terminal-button--primary">{t.cta_projects}<span aria-hidden="true">{arrow}</span></a>
          <a href="#contact" class="terminal-link">{t.cta_contact}</a>
        </div>
      </div>

      {latest && (
        <a class="hero__note" href={latestHref}>
          <span class="hero__note-meta"><span>{note.label}</span><time datetime={latest.data.pubDate.toISOString()}>{latestDate}</time></span>
          <span class="hero__note-title">{latest.data.title}</span>
          <span class="hero__note-read">{note.read} <span aria-hidden="true">{arrow}</span></span>
        </a>
      )}
    </div>

    <dl class="hero__stats" aria-label="Career and GitHub statistics">
      {stats.map((stat, index) => (
        <div class="hero__stat">
          <dt>{stat.label}</dt>
          <dd><data value={stat.value} data-count data-count-intro={String(600 + index * 70)}>{stat.value}</data></dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: calc(var(--terminal-header) + clamp(2.5rem, 7vw, 6rem)) clamp(3rem, 6vw, 5rem);
  }

  .hero__name {
    display: grid;
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0;
    color: var(--terminal-ink);
    font-size: clamp(3.75rem, 12.4vw, 12rem);
    line-height: 0.88;
  }

  .hero__line--indent {
    padding-inline-start: 0.62em;
  }

  .hero__dot {
    display: inline-block;
    inline-size: 0.15em;
    block-size: 0.15em;
    margin-inline-start: 0.04em;
    background: var(--terminal-accent);
  }

  .hero__below {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    margin-block-start: clamp(2.5rem, 5vw, 4.5rem);
  }

  .hero__description {
    max-inline-size: 30ch;
    margin: 0;
    color: var(--terminal-ink-2);
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .hero__badge {
    margin: 1.25rem 0 0;
    color: var(--terminal-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
    margin-block-start: 2rem;
  }

  .hero__note {
    display: grid;
    gap: 0.9rem;
    padding: 1.5rem 1.5rem 1.35rem;
    border: 1px solid var(--terminal-line-strong);
    background: var(--terminal-panel);
    color: inherit;
    text-decoration: none;
    transition: border-color 160ms ease, transform 200ms ease;
  }

  .hero__note:hover {
    border-color: var(--terminal-ink);
  }

  .hero__note-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--terminal-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__note-title {
    color: var(--terminal-ink);
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .hero__note-read {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .hero__note:hover .hero__note-read {
    color: var(--terminal-accent);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    border-block: 1px solid var(--terminal-line-strong);
  }

  .hero__stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 1.4rem 1.25rem 1.5rem 0;
  }

  .hero__stat + .hero__stat {
    padding-inline-start: 1.25rem;
    border-inline-start: 1px solid var(--terminal-line);
  }

  .hero__stat dt {
    color: var(--terminal-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__stat dd {
    margin: 0;
    color: var(--terminal-ink);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__kicker,
    .hero__line,
    .hero__below,
    .hero__stats {
      animation: hero-rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .hero__line:nth-child(1) { animation-delay: 60ms; }
    .hero__line:nth-child(2) { animation-delay: 140ms; }
    .hero__below { animation-delay: 260ms; }
    .hero__stats { animation-delay: 360ms; }
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translate3d(0, 0.6rem, 0); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 52rem) {
    .hero__below { grid-template-columns: 1fr; }
    .hero__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero__stat:nth-child(3) { padding-inline-start: 0; border-inline-start: 0; }
    .hero__stat:nth-child(n + 3) { border-block-start: 1px solid var(--terminal-line); }
  }

  @media (max-width: 30rem) {
    .hero__line--indent { padding-inline-start: 0; }
  }
</style>
